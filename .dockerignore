# Contexte de construction de l'image du relais (crates/relais/Dockerfile) :
# seuls les manifestes et les sources de l'espace de travail sont utiles.
target
.git
.idea
.claude
docs
# Sauf le favicon, servi par le portail (crates/portail, F9).
!docs/marque/web/favicon.svg
docs_of_interest
installateur
# Trousse de déploiement : inutile aux images, et sans elle un changement du
# compose ne refait pas la compilation.
deploiement
**/*.sqlite
**/*.kzs

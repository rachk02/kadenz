# Réglages du déploiement de Kadenz sur le Dell, à copier dans
# /etc/kadenz/kadenz.env (root, mode 600) et à remplir sur place.
# Aucune valeur secrète ici : la clé du portail est un fichier à part.

# Commit construit, 12 caractères : git rev-parse --short=12 HEAD dans la
# source. Étiquette des images.
KADENZ_REV=

# Fichier de la clé du portail, hors du dépôt et hors des dossiers
# sauvegardés par restic (/etc, /home, /root, /usr/local...) :
# propriétaire 10001:10001, mode 400.
CLE_PORTAIL=/srv/kadenz/cle/cle-portail.hex

# Sous-réseau du réseau « portail » et sa passerelle (adresse donnée à
# --mandataire). Choisir un sous-réseau libre : docker network inspect et
# ip route sur le Dell.
RESEAU_PORTAIL=
PASSERELLE_PORTAIL=

# Dossier des copies prises avant restic (à ajouter à la ligne restic backup).
KADENZ_SAUVEGARDES=/var/backups/kadenz

# Essai seulement (compose.essai.yaml) : clé publique d'essai en hexadécimal.
CLE_PUBLIQUE_ESSAI=

# Ouverture par Cloudflare Tunnel (compose.public.yaml), sur accord de
# l'utilisateur seulement.
# 1 : portail ouvert ; kadenz-compose ajoute alors compose.public.yaml à
# chaque appel. Mis à 1 avant l'ouverture, remis à vide au retour en arrière,
# après le retrait du tunnel.
KADENZ_PUBLIC=
# Durée de conservation du journal du portail dans la base, en jours
# (kadenz-sauvegarde, étape 4). Vide : rien n'est archivé. Réglée : chaque
# nuit, les entrées plus anciennes, déjà dans journal.jsonl et vérifiées avec
# la base, sont retirées de la base ; elles ne restent que dans journal.jsonl
# et ses sauvegardes restic. Cette durée borne la base en service seulement :
# adresses IP et identifiants restent dans journal.jsonl et dans chaque
# instantané restic, selon leur propre conservation. Durée à décider par
# l'utilisateur, avec celle de journal.jsonl et de restic.
KADENZ_JOURNAL_JOURS=
# Image cloudflared épinglée, relevée sur le Dell par kadenz-51 le 2026-11-19
# (publiée le 2026-10-30 ; utilisateur 65532:65532 ; --token-file présent).
IMAGE_CLOUDFLARED=cloudflare/cloudflared:2026.10.7@sha256:4955524aeaa379e154023d5a027c250f7b35041a2e7e950cf13f144bc9b9c5ba
# Jeton du tunnel, déposé par l'utilisateur ; propriétaire 65532, mode 400 ;
# hors dépôt et hors restic.
JETON_TUNNEL=/srv/kadenz/tunnel/jeton
# Réseau interne entre le portail et cloudflared, et l'adresse fixe de
# cloudflared (donnée à --mandataire) : ni la première adresse du
# sous-réseau, ni un sous-réseau déjà pris.
RESEAU_CONSOLE=
IP_TUNNEL=

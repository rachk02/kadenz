#!/bin/sh
# Santé des conteneurs de Kadenz sur le Dell, à installer dans
# /usr/local/sbin/kadenz-sante ; lancé toutes les 5 minutes par
# kadenz-sante.timer. Procédure : docs/deploiement-vps.md, section 7.
#
# « restart: unless-stopped » ne redémarre pas un conteneur « unhealthy » :
# cette alerte est la seule réaction. Une alerte au changement d'état
# seulement (panne, puis retour), pas à chaque passage.

set -u

SOURCE=${KADENZ_SOURCE:-/opt/kadenz/source}
REGLAGES=${KADENZ_ENV:-/etc/kadenz/kadenz.env}
ETAT=${KADENZ_ETAT_SANTE:-/var/lib/kadenz-sante}
ALERTE=${ALERTE:-/usr/local/sbin/alerte}

# Entrée standard fermée : sans elle, docker compose run ou exec lit la suite
# d'un script appelant (relevé à l'essai sur le Dell).
kz() {
    docker compose -f "$SOURCE/deploiement/dell/compose.yaml" --env-file "$REGLAGES" "$@" </dev/null
}

umask 077
mkdir -p "$ETAT"

for service in portail relais; do
    id=$(kz ps -a -q "$service" 2>/dev/null | head -n 1)
    if [ -z "$id" ]; then
        etat=absent
    else
        # Conteneur arrêté : son état (exited...), et non le dernier résultat
        # de la sonde, resté « unhealthy ». En marche : l'état de la sonde ;
        # sans sonde, en marche vaut bonne santé.
        etat=$(docker inspect -f '{{if not .State.Running}}{{.State.Status}}{{else if .State.Health}}{{.State.Health.Status}}{{else}}healthy{{end}}' "$id" 2>/dev/null </dev/null) \
            || etat=absent
    fi
    # Démarrage en cours : rien à dire encore.
    [ "$etat" = "starting" ] && continue
    avant=$(cat "$ETAT/$service" 2>/dev/null || echo healthy)
    [ "$etat" = "$avant" ] && continue
    if [ "$etat" = "healthy" ]; then
        message="de nouveau en bonne santé"
        priorite=3
    else
        message="en panne ($etat)"
        priorite=4
    fi
    # Alerte du Dell : alerte "titre" "message" [priorité 1 à 5]. Alerte en
    # échec : état non noté, nouvel essai au passage suivant.
    if "$ALERTE" "Kadenz, $service" "$message" "$priorite"; then
        echo "$etat" > "$ETAT/$service"
    fi
done

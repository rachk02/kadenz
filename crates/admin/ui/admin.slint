// Fenêtre d'administration du serveur (phase 2, jalon F4 ; décision 30 ; écrans,
// section 1) : petite fenêtre de dépannage sur la machine du serveur. Elle montre
// l'état du service et l'empreinte de son certificat, installe l'entreprise et son
// premier compte Admin avec la licence d'abonnement (même assistant que
// l'application), crée et annule les codes d'inscription des postes, et retire un
// poste. Tout le reste se fait depuis un poste connecté avec un compte Admin.
// La restauration et les sauvegardes viennent avec le jalon F7.
import { LineEdit, ScrollView, TextEdit } from "std-widgets.slint";
import { Alerte, Bouton, Champ, Confirmation, FenetreAlerte, FenetreConfirmation, MessageRetour, Rangee, Retour, Section, Theme, Titre } from "../../app/ui/composants.slint";
import { DonneesAssistant, EcranAssistant } from "../../app/ui/assistant.slint";
import { LicenceApi } from "../../app/ui/licence.slint";
import { SauvegardesApi } from "../../app/ui/sauvegardes.slint";

export { DonneesAssistant, LicenceApi, SauvegardesApi, Theme }

export struct CodeUi {
    id: int,
    nom: string,
    expire-le: string,
}

export struct PosteUi {
    empreinte: string,
    nom: string,
    inscrit-le: string,
}

export global AdminApi {
    in property <string> dossier;
    in property <string> nom-entreprise;
    in property <string> etat-service;
    in property <bool> service-demarre;
    in property <string> derniere-erreur;
    in property <string> empreinte;
    in property <string> postes-permis;
    in property <[CodeUi]> codes;
    in property <[PosteUi]> postes;
    // Dernier code créé : le secret n'est montré qu'ici, une seule fois.
    in-out property <string> nouveau-nom;
    in-out property <string> nouveau-secret;
    in-out property <string> nouveau-complet;
    in-out property <string> nouveau-expire;

    callback actualiser();
    callback creer-code(nom: string) -> Retour;
    callback annuler-code(id: int) -> Retour;
    callback retirer-poste(empreinte: string) -> Retour;
}

export enum EcranAdmin { erreur, assistant, tableau }

component Ligne inherits GridLayout {
    in property <string> libelle;
    in property <string> valeur;
    in property <color> couleur: Theme.texte;
    spacing: 16px;

    Text {
        row: 0;
        col: Theme.rtl ? 1 : 0;
        width: 180px;
        horizontal-alignment: Theme.debut;
        text: root.libelle;
        color: Theme.texte-secondaire;
    }

    Text {
        row: 0;
        col: Theme.rtl ? 0 : 1;
        horizontal-alignment: Theme.debut;
        text: root.valeur;
        color: root.couleur;
        wrap: word-wrap;
    }
}

// Texte d'une ligne en lecture seule (empreinte), avec un bouton Copier.
component LigneACopier inherits HorizontalLayout {
    in property <string> texte;
    spacing: 8px;

    champ := LineEdit {
        horizontal-stretch: 1;
        text: root.texte;
        read-only: true;
        font-size: 13px;
    }

    Bouton {
        text: @tr("Copier");
        clicked => {
            champ.select-all();
            champ.copy();
            Alerte.montrer(@tr("Copié."));
        }
    }
}

// Texte long en lecture seule (code complet), avec un bouton Copier.
component TexteACopier inherits VerticalLayout {
    in property <string> texte;
    in property <length> hauteur: 72px;
    spacing: 6px;

    champ := TextEdit {
        text: root.texte;
        read-only: true;
        font-family: "Consolas";
        font-size: 12px;
        wrap: char-wrap;
        height: root.hauteur;
    }

    HorizontalLayout {
        alignment: Theme.rangee-debut;

        Bouton {
            text: @tr("Copier");
            clicked => {
                champ.select-all();
                champ.copy();
                Alerte.montrer(@tr("Copié."));
            }
        }
    }
}

component Tableau inherits ScrollView {
    property <string> nom-poste;
    property <Retour> retour;
    // Action en attente de la fenêtre de confirmation.
    property <int> code-a-annuler: -1;
    property <string> poste-a-retirer;
    property <int> reponses: Confirmation.reponses;
    changed reponses => {
        if (Confirmation.accepte && self.code-a-annuler >= 0) {
            self.retour = AdminApi.annuler-code(self.code-a-annuler);
            Alerte.retour(self.retour);
        }
        if (Confirmation.accepte && self.poste-a-retirer != "") {
            self.retour = AdminApi.retirer-poste(self.poste-a-retirer);
            Alerte.retour(self.retour);
        }
        self.code-a-annuler = -1;
        self.poste-a-retirer = "";
    }

    // Colonne de 880 px au plus, au début du sens de lecture : en plein écran,
    // les champs ne s'étirent pas sur toute la largeur.
    HorizontalLayout {
        alignment: Theme.rangee-debut;

        VerticalLayout {
            max-width: 880px;
            horizontal-stretch: 1;
            padding: 24px;
            spacing: 12px;
            alignment: start;

            Titre {
                text: AdminApi.nom-entreprise == "" ? @tr("Serveur Kadenz") : AdminApi.nom-entreprise;
            }

            Text {
                horizontal-alignment: Theme.debut;
                text: @tr("Cette fenêtre sert au dépannage du serveur. Les comptes, l'abonnement et les autres réglages se gèrent depuis un poste connecté avec un compte Admin.");
                color: Theme.texte-secondaire;
                wrap: word-wrap;
            }

            Section {
                text: @tr("Service");
            }

            Ligne {
                libelle: @tr("État");
                valeur: AdminApi.etat-service;
                couleur: AdminApi.service-demarre ? Theme.succes : Theme.erreur;
            }

            if AdminApi.derniere-erreur != "": Ligne {
                libelle: @tr("Dernière erreur");
                valeur: AdminApi.derniere-erreur;
                couleur: Theme.erreur;
            }

            Ligne {
                libelle: @tr("Dossier des données");
                valeur: AdminApi.dossier;
            }

            Section {
                text: @tr("Empreinte du certificat");
            }

            Text {
                horizontal-alignment: Theme.debut;
                text: @tr("Un poste qui s'inscrit avec le code complet la vérifie seul. Avec le code court, comparez l'empreinte affichée sur le poste à celle-ci avant de confirmer.");
                color: Theme.texte-secondaire;
                wrap: word-wrap;
            }

            LigneACopier {
                texte: AdminApi.empreinte;
            }

            Section {
                text: @tr("Codes d'inscription");
            }

            Text {
                horizontal-alignment: Theme.debut;
                text: @tr("Un code sert une seule fois, pour un poste, pendant 24 heures. Un nouveau code pour le même nom de poste annule le précédent.");
                color: Theme.texte-secondaire;
                wrap: word-wrap;
            }

            Ligne {
                libelle: @tr("Postes");
                valeur: AdminApi.postes-permis;
            }

            HorizontalLayout {
                spacing: 8px;

                Champ {
                    horizontal-stretch: 1;
                    libelle: @tr("Nom du poste");
                    valeur <=> root.nom-poste;
                }

                VerticalLayout {
                    alignment: end;

                    Bouton {
                        text: @tr("Créer un code");
                        primary: true;
                        clicked => {
                            root.retour = AdminApi.creer-code(root.nom-poste);
                            if (root.retour.ok) {
                                root.nom-poste = "";
                            }
                        }
                    }
                }
            }

            MessageRetour {
                erreurs-seules: true;
                retour: root.retour;
            }

            if AdminApi.nouveau-secret != "": Rectangle {
                border-width: 1px;
                border-color: Theme.bordure;
                border-radius: 4px;
                background: Theme.fond-lateral;

                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;

                    Text {
                        horizontal-alignment: Theme.debut;
                        text: @tr("Code du poste « {} », valable jusqu'au {}. Notez-le maintenant : il ne sera plus affiché.", AdminApi.nouveau-nom, AdminApi.nouveau-expire);
                        color: Theme.texte;
                        font-weight: 600;
                        wrap: word-wrap;
                    }

                    Ligne {
                        libelle: @tr("Code court");
                        valeur: AdminApi.nouveau-secret;
                    }

                    Text {
                        horizontal-alignment: Theme.debut;
                        text: @tr("Code complet, à coller sur le poste : il contient aussi l'adresse et l'empreinte du serveur.");
                        color: Theme.texte-secondaire;
                        wrap: word-wrap;
                    }

                    TexteACopier {
                        texte: AdminApi.nouveau-complet;
                        hauteur: 72px;
                    }

                    HorizontalLayout {
                        alignment: Theme.rangee-debut;

                        Bouton {
                            text: @tr("Masquer le code");
                            clicked => {
                                AdminApi.nouveau-secret = "";
                                AdminApi.nouveau-complet = "";
                            }
                        }
                    }
                }
            }

            if AdminApi.codes.length > 0: Text {
                horizontal-alignment: Theme.debut;
                text: @tr("Codes en cours");
                font-weight: 600;
                color: Theme.texte;
            }

            for code in AdminApi.codes: HorizontalLayout {
                spacing: 12px;

                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    horizontal-alignment: Theme.debut;
                    text: @tr("{} : valable jusqu'au {}", code.nom, code.expire-le);
                    color: Theme.texte;
                    wrap: word-wrap;
                }

                Bouton {
                    text: @tr("Annuler le code");
                    danger: true;
                    clicked => {
                        root.code-a-annuler = code.id;
                        Confirmation.demander(@tr("Annuler le code du poste « {} » ? Il ne pourra plus servir.", code.nom), @tr("Annuler le code"), true);
                    }
                }
            }

            Section {
                text: @tr("Postes inscrits");
            }

            if AdminApi.postes.length == 0: Text {
                horizontal-alignment: Theme.debut;
                text: @tr("Aucun poste inscrit.");
                color: Theme.texte-secondaire;
            }

            for poste in AdminApi.postes: HorizontalLayout {
                spacing: 12px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;

                    Text {
                        horizontal-alignment: Theme.debut;
                        text: poste.nom;
                        color: Theme.texte;
                        font-weight: 600;
                    }

                    Text {
                        horizontal-alignment: Theme.debut;
                        text: @tr("Inscrit le {}", poste.inscrit-le);
                        color: Theme.texte-secondaire;
                        font-size: 12px;
                    }
                }

                VerticalLayout {
                    alignment: center;

                    Bouton {
                        text: @tr("Retirer");
                        danger: true;
                        clicked => {
                            root.poste-a-retirer = poste.empreinte;
                            Confirmation.demander(@tr("Retirer le poste « {} » ? Il ne pourra plus se connecter ; il faudra un nouveau code pour l'inscrire de nouveau.", poste.nom), @tr("Retirer"), true);
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: Theme.rangee-debut;
                padding-top: 8px;

                Bouton {
                    text: @tr("Actualiser");
                    clicked => {
                        AdminApi.actualiser();
                    }
                }
            }
        }
    }
}

export component FenetreAdmin inherits Window {
    in-out property <EcranAdmin> ecran: EcranAdmin.erreur;
    in property <string> message-erreur;
    in property <string> defaut-taux-tva;
    in property <string> defaut-taux-remise;
    in property <string> defaut-taux-retenue;
    in property <string> defaut-modes-paiement;
    callback terminer(DonneesAssistant) -> string;

    title: @tr("Kadenz - Administration du serveur");
    icon: @image-url("../../app/ui/icones/kadenz-64.png");
    preferred-width: 1040px;
    preferred-height: 720px;
    min-width: 760px;
    min-height: 560px;
    background: white;
    default-font-family: Theme.police-texte;

    if root.ecran == EcranAdmin.erreur: VerticalLayout {
        padding: 32px;
        spacing: 12px;
        alignment: start;

        Titre {
            text: @tr("Kadenz - Administration du serveur");
        }

        Text {
            horizontal-alignment: Theme.debut;
            text: root.message-erreur;
            color: Theme.erreur;
            wrap: word-wrap;
        }
    }

    if root.ecran == EcranAdmin.assistant: EcranAssistant {
        serveur: true;
        defaut-taux-tva: root.defaut-taux-tva;
        defaut-taux-remise: root.defaut-taux-remise;
        defaut-taux-retenue: root.defaut-taux-retenue;
        defaut-modes-paiement: root.defaut-modes-paiement;
        terminer(d) => {
            root.terminer(d)
        }
    }

    if root.ecran == EcranAdmin.tableau: Tableau { }

    FenetreAlerte {
        largeur-fenetre: root.width;
        hauteur-fenetre: root.height;
    }

    FenetreConfirmation {
        width: root.width;
        height: root.height;
    }
}

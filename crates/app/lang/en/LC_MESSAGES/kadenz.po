msgid "bordereau enregistré"
msgstr "delivery note saved"

msgid "Modification des visas et dates de livraison"
msgstr "Change of delivery signatures and dates"

msgid "cette facture a des bordereaux non confirmés : les annuler ou confirmer leur livraison d'abord"
msgstr "this invoice has unconfirmed delivery notes: cancel them or confirm their delivery first"

msgid "les visas et dates ne concernent que les bordereaux de livraison"
msgstr "signatures and dates only apply to delivery notes"

msgid "les visas et dates se modifient sur un bordereau validé, avant la confirmation ; celui-ci est « {} »"
msgstr "signatures and dates are changed on a validated delivery note, before confirmation; this one is \"{}\""

msgid "le préfixe « {} » est obligatoire"
msgstr "the \"{}\" prefix is required"

msgid "le préfixe « {} » doit compter de 1 à {} lettres, sans chiffre, espace ni accent"
msgstr "the \"{}\" prefix must have 1 to {} letters, with no digit, space or accent"

msgid "les types « {} » et « {} » ont le même préfixe « {} »"
msgstr "types \"{}\" and \"{}\" have the same prefix \"{}\""

msgid "le nombre de chiffres du rang doit être compris entre {} et {}"
msgstr "the number of digits in the sequence number must be between {} and {}"

msgid "Règlements"
msgstr "Payments"

msgid "Suivi fournisseurs"
msgstr "Supplier follow-up"

msgid "Relances"
msgstr "Reminders"

msgid "le règlement dépasse le reste à payer ({} FCFA)"
msgstr "the payment exceeds the amount left to pay ({} FCFA)"

msgid "la date du règlement ne peut pas précéder celle du document ({})"
msgstr "the payment date cannot be earlier than the document date ({})"

msgid "seuls une facture ou un bon de commande reçoivent des règlements"
msgstr "only an invoice or a purchase order can receive payments"

msgid "un règlement se saisit sur un document validé et non annulé"
msgstr "a payment is entered on a validated, non-cancelled document"

msgid "la date du règlement ne peut pas être dans le futur"
msgstr "the payment date cannot be in the future"

msgid "le mode de paiement du règlement est obligatoire"
msgstr "the payment method is required"

msgid "ce règlement n'existe plus"
msgstr "this payment no longer exists"

msgid "ce document a des règlements : les supprimer d'abord"
msgstr "this document has payments: delete them first"

msgid "Règlement de {} FCFA enregistré"
msgstr "Payment of {} FCFA recorded"

msgid "Règlement de {} FCFA supprimé"
msgstr "Payment of {} FCFA deleted"

msgid "Règlement enregistré"
msgstr "Payment recorded"

msgid "Règlement supprimé"
msgstr "Payment deleted"

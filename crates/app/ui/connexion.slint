import { Bouton, Champ, MessageErreur, MotifMarque, Rangee, Theme, Titre, TroisTemps } from "composants.slint";

// Panneau de marque Kadenz (logo, motif Quatre pièces), à gauche des écrans de
// connexion et de premier lancement.
export component PanneauMarque inherits Rectangle {
    in property <string> version-logiciel;
    background: Theme.nuit;
    clip: true;

    // Motif sur tout le panneau, en pièces serrées, comme le motif de l'ancienne identité.
    MotifMarque {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        pas: 40px;
    }

    VerticalLayout {
        padding: 40px;
        spacing: 14px;

        Image {
            width: 150px;
            height: 40px;
            source: @image-url("icones/kadenz-logo-horizontal-negatif.svg");
            image-fit: contain;
            horizontal-alignment: Theme.rtl ? ImageHorizontalAlignment.right : ImageHorizontalAlignment.left;
        }

        Rectangle { }

        TroisTemps { }

        Text {
            horizontal-alignment: Theme.debut;
            text: @tr("Gestion commerciale");
            color: white;
            font-family: Theme.police-titre;
            font-size: 30px;
            font-weight: 800;
            wrap: word-wrap;
        }

        Text {
            horizontal-alignment: Theme.debut;
            text: @tr("Devis, proforma, bons de commande, bordereaux de livraison, factures et paiements.");
            color: #c5cae0;
            font-size: 14px;
            wrap: word-wrap;
        }

        Rectangle {
            height: 24px;
        }

        Text {
            horizontal-alignment: Theme.debut;
            text: @tr("Version {}", root.version-logiciel);
            color: #9aa3c7;
            font-size: 12px;
        }
    }
}

// Écran de connexion : panneau de marque Kadenz à gauche (logo, motif Quatre pièces),
// formulaire à droite sous le nom de l'entreprise qui utilise l'installation.
export component EcranConnexion inherits Rectangle {
    in property <string> nom-entreprise;
    in property <string> version-logiciel;

    // Renvoie un message d'erreur, ou une chaîne vide si la connexion a réussi.
    callback connecter(string, string) -> string;

    property <string> identifiant;
    property <string> mot-de-passe;
    property <string> erreur;

    function valider() {
        root.erreur = root.connecter(root.identifiant, root.mot-de-passe);
        if (root.erreur == "") {
            root.mot-de-passe = "";
        }
    }

    background: white;

    Rangee {
        remplit: true;
        PanneauMarque {
            width: max(340px, min(460px, root.width * 0.4));
            version-logiciel: root.version-logiciel;
        }

        VerticalLayout {
            alignment: center;

            Rangee {
                alignment: center;

                VerticalLayout {
                    width: 360px;
                    spacing: 16px;
                    padding: 24px;

                    Text {
                        horizontal-alignment: Theme.debut;
                        text: @tr("CONNEXION");
                        font-family: Theme.police-titre;
                        font-size: 12px;
                        font-weight: 800;
                        letter-spacing: 1px;
                        color: Theme.accent;
                    }

                    Titre {
                        text: root.nom-entreprise;
                        wrap: word-wrap;
                    }

                    Text {
                        horizontal-alignment: Theme.debut;
                        text: @tr("Saisissez votre identifiant et votre mot de passe.");
                        color: Theme.texte-secondaire;
                        wrap: word-wrap;
                    }

                    Champ {
                        libelle: @tr("Identifiant");
                        valeur <=> root.identifiant;
                        valide => {
                            root.valider();
                        }
                    }

                    Champ {
                        libelle: @tr("Mot de passe");
                        secret: true;
                        valeur <=> root.mot-de-passe;
                        valide => {
                            root.valider();
                        }
                    }

                    if root.erreur != "": MessageErreur {
                        text: root.erreur;
                    }

                    Bouton {
                        text: @tr("Se connecter");
                        primary: true;
                        clicked => {
                            root.valider();
                        }
                    }
                }
            }
        }
    }
}

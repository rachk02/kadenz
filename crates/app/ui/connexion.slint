import { Bouton, Champ, MessageErreur, Rangee, Theme } from "composants.slint";
import { MotifA2 } from "motifs-ecrans.slint";

// Refonte du 2026-11-18 (docs/marque/propositions-2026-11-18-refonte-ecrans) : les
// écrans de premier lancement et de connexion posent leur bloc à une place fixe,
// quelle que soit la longueur des textes, à côté d'un panneau de marque tramé.

// Panneau de marque sur Nuit : le motif animé adopté le 2026-11-18 (motifs-ecrans.slint),
// placé par l'écran comme enfant du panneau ; en bas, « Gestion commerciale » et la version.
// Le symbole entier n'est jamais tramé (charte).
export component PanneauTrame inherits Rectangle {
    in property <string> version-logiciel;
    // Logo négatif en haut du panneau, quand la colonne voisine n'en porte pas.
    in property <bool> logo: false;
    background: Theme.nuit;
    clip: true;

    @children

    if root.logo: Image {
        x: Theme.rtl ? parent.width - self.width - 48px : 48px;
        y: 56px;
        width: 140px;
        height: 30px;
        source: @image-url("icones/kadenz-logo-horizontal-negatif.svg");
        image-fit: contain;
        horizontal-alignment: Theme.rtl ? ImageHorizontalAlignment.right : ImageHorizontalAlignment.left;
    }

    VerticalLayout {
        padding: 48px;
        padding-bottom: 44px;
        spacing: 6px;
        alignment: end;

        Text {
            horizontal-alignment: Theme.debut;
            text: @tr("Gestion commerciale");
            color: white;
            font-family: Theme.police-titre;
            font-size: 22px;
            font-weight: 700;
            wrap: word-wrap;
        }

        Text {
            horizontal-alignment: Theme.debut;
            text: @tr("Version {}", root.version-logiciel);
            color: #c5cae0;
            font-size: 12px;
        }
    }
}

// Logo de la colonne claire : couleur en clair, négatif en sombre.
export component LogoColonne inherits Image {
    width: 140px;
    height: 30px;
    source: Theme.sombre ? @image-url("icones/kadenz-logo-horizontal-negatif.svg") : @image-url("icones/kadenz-logo-horizontal.svg");
    image-fit: contain;
    horizontal-alignment: Theme.rtl ? ImageHorizontalAlignment.right : ImageHorizontalAlignment.left;
}

// Sur-titre des écrans de premier lancement et de connexion.
export component SurTitre inherits Text {
    horizontal-alignment: Theme.debut;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.6px;
    color: Theme.texte-secondaire;
}

// Grand titre des écrans de premier lancement, de connexion et de l'assistant.
export component GrandTitre inherits Text {
    horizontal-alignment: Theme.debut;
    font-family: Theme.police-titre;
    font-size: 32px;
    font-weight: 700;
    color: Theme.texte;
    wrap: word-wrap;
}

// Écran de connexion (modèle 1) : formulaire court à gauche, sous le nom de l'entreprise
// qui utilise l'installation, grande trame à droite.
export component EcranConnexion inherits Rectangle {
    in property <string> nom-entreprise;
    in property <string> version-logiciel;

    // Renvoie un message d'erreur, ou une chaîne vide si la connexion a réussi.
    callback connecter(string, string) -> string;

    property <string> identifiant;
    property <string> mot-de-passe;
    property <string> erreur;

    // Le mot de passe n'est pas effacé après une connexion réussie : l'écran est
    // recréé à chaque affichage. Sur un poste relié, il peut rester affiché le
    // temps que le compte arrive dans la copie (compte attendu), et vider le
    // champ masqué sous son curseur fait paniquer Slint 1.18 (text.rs:1521).
    function valider() {
        root.erreur = root.connecter(root.identifiant, root.mot-de-passe);
    }

    background: Theme.fond;

    Rangee {
        remplit: true;

        Rectangle {
            width: max(420px, min(560px, root.width * 0.47));

            LogoColonne {
                x: Theme.rtl ? parent.width - self.width - 72px : 72px;
                y: 56px;
            }

            // Bloc à place fixe ; il ne remonte que si la fenêtre est trop basse.
            VerticalLayout {
                x: Theme.rtl ? parent.width - self.width - 72px : 72px;
                y: min(250px, max(110px, parent.height - self.preferred-height - 48px));
                width: min(360px, parent.width - 144px);
                height: self.preferred-height;
                spacing: 0px;

                SurTitre {
                    text: @tr("CONNEXION");
                }

                Rectangle { height: 14px; }

                GrandTitre {
                    text: root.nom-entreprise;
                }

                Rectangle { height: 32px; }

                VerticalLayout {
                    spacing: 16px;

                    Champ {
                        libelle: @tr("Identifiant");
                        valeur <=> root.identifiant;
                        valide => {
                            root.valider();
                        }
                    }

                    Champ {
                        libelle: @tr("Mot de passe");
                        secret: true;
                        valeur <=> root.mot-de-passe;
                        valide => {
                            root.valider();
                        }
                    }

                    if root.erreur != "": MessageErreur {
                        text: root.erreur;
                    }
                }

                Rectangle { height: 24px; }

                Bouton {
                    text: @tr("Se connecter");
                    primary: true;
                    clicked => {
                        root.valider();
                    }
                }
            }
        }

        PanneauTrame {
            horizontal-stretch: 1;
            version-logiciel: root.version-logiciel;

            // A2 Trame de pièces, quart de disque, avec le reflet lent.
            MotifA2 {
                width: parent.width;
                height: parent.height;
                piece: 1;
                reflet: true;
            }
        }
    }
}

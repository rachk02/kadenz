// Écran commun des documents à montants (Devis, Proforma, Bon de commande, Facture, Avoir) : registre
// filtrable, puis fiche en pleine page (cahier des charges, sections 4.1, 4.2, 6 et 7).
// Tous les calculs et les contrôles sont faits par l'application, qui fournit aussi
// les textes propres au type : cet écran ne fait qu'afficher et transmettre la saisie.

import { CheckBox, ComboBox, LineEdit, ScrollView, StandardTableView } from "std-widgets.slint";
import { Bouton, Champ, Droits, MessageRetour, Rangee, Retour, Section, Theme, Titre } from "composants.slint";

export struct LigneFactureUi {
    // 0 pour une ligne libre, sans produit d'origine.
    produit-id: int,
    reference: string,
    designation: string,
    prix: string,
    quantite: string,
    total: string,
    // Quantité reçue cumulée (bon de commande en réception).
    recue: string,
}

export struct FicheFactureUi {
    existe: bool,
    titre: string,
    statut: string,
    paiement: string,
    brouillon: bool,
    annule: bool,
    date: string,
    echeance: string,
    libelle: string,
    observations: string,
    client-index: int,
    tiers-detail: string,
    remise-index: int,
    tva-index: int,
    // Retenue à la source : bon de commande seulement.
    retenue-index: int,
    mode-index: int,
    modifiable: bool,
    // Faux pour un avoir : son client est celui de la facture d'origine.
    client-modifiable: bool,
    // Faux pour un avoir : sa remise et sa TVA sont celles de la facture d'origine.
    taux-modifiables: bool,
    admin-modifiable: bool,
    peut-valider: bool,
    peut-envoyer: bool,
    peut-annuler: bool,
    peut-supprimer: bool,
    // Bon de commande envoyé ou en réception : colonne des quantités reçues, et sa
    // saisie tant que la réception n'est pas complète (droit « Valider un document »).
    avec-reception: bool,
    reception-modifiable: bool,
    // Devis ou proforma validé ou envoyé, sans facture en préparation.
    peut-convertir: bool,
    peut-dupliquer: bool,
    // Correction d'un devis ou d'une proforma : copie en brouillon, original annulé.
    peut-corriger: bool,
    // Facture validée ou envoyée et droit de créer un avoir ; le bouton est grisé
    // si ses avoirs couvrent déjà tout le montant (`avoir-possible` faux).
    peut-creer-avoir: bool,
    avoir-possible: bool,
    // Montant dû diminué des avoirs validés ; vide s'il vaut le TTC.
    montant-du: string,
    // Devis ou proforma dont la facture issue de la conversion est encore en brouillon.
    en-preparation: bool,
    // Explication affichée sous les actions quand la fiche n'est pas modifiable
    // (lecture seule, document figé, annulé, converti) ; vide sinon.
    note: string,
}

// Textes propres au type de document (accord du genre compris), traduits par l'application.
export struct TextesDocumentUi {
    titre: string,
    nouveau: string,
    aide-registre: string,
    sans-numero: string,
    libelle-echeance: string,
    marquer-envoye: string,
    annuler: string,
    confirmer-validation: string,
    confirmer-annulation: string,
    // Tiers du type : client pour une vente, fournisseur pour un bon de commande.
    tiers: string,
    recherche: string,
    filtrer-tiers: string,
    nouveau-tiers: string,
    creer-tiers: string,
    note-tiers: string,
}

// Document lié (origine ou document issu de celui-ci), pour la navigation.
export struct LienUi {
    id: int,
    texte: string,
}

export struct TotauxUi {
    ht: string,
    remise: string,
    base-tva: string,
    tva: string,
    retenue: string,
    ttc: string,
    lettres: string,
}

export struct EvenementUi {
    date: string,
    utilisateur: string,
    libelle: string,
}

export global FacturesApi {
    // Registre.
    in property <[[StandardListViewItem]]> registre;
    in property <string> resume;
    in-out property <int> ligne-courante: -1;
    in property <bool> peut-creer;
    in property <bool> fiche-ouverte;
    in property <TextesDocumentUi> textes;
    // Choix du filtre de statut (le premier est « tous ») ; dépend du type.
    in property <[string]> statuts;
    // Filtre et bandeau de paiement : seulement pour un type qui reçoit des règlements.
    in property <bool> avec-paiement;
    // PDF disponible pour ce type.
    in property <bool> avec-pdf;
    // Rang du type dans TypeDocument::TOUS.
    callback ouvrir(type-document: int);
    // Statut : rang dans `statuts`. Paiement : 0 tous, 1 impayé, 2 partiel, 3 payé.
    // Renvoie un message si une date de période est illisible.
    callback filtrer(texte: string, statut: int, paiement: int, du: string, au: string) -> string;
    callback trier(colonne: int, croissant: bool);
    callback selectionner(ligne: int);
    callback nouvelle();
    callback fermer-fiche();

    // Fiche. La version augmente à chaque rechargement de la fiche par l'application :
    // l'écran recharge alors ses champs, et seulement dans ce cas (une saisie refusée
    // reste affichée telle quelle pour être corrigée).
    in property <int> version-fiche;
    callback fiche-courante() -> FicheFactureUi;
    in property <[string]> clients;
    in property <[string]> taux-remise;
    in property <[string]> taux-tva;
    // Liste et ligne de retenue : seulement pour un type où elle s'applique.
    in property <bool> avec-retenue;
    in property <[string]> taux-retenue;
    in property <[string]> modes-paiement;
    in property <[string]> produits;
    in property <[LigneFactureUi]> lignes;
    in property <TotauxUi> totaux;
    in property <[EvenementUi]> historique;
    in property <[LienUi]> liens;
    // Message à afficher à l'ouverture d'une fiche dans une autre page (document
    // créé d'un autre type) ; la fiche le reprend puis le vide.
    in-out property <Retour> message-ouverture;
    // Renvoie le nouveau rang du client choisi dans la liste filtrée.
    callback filtrer-clients(texte: string, rang-courant: int) -> int;
    // Renvoie les coordonnées du client choisi.
    callback client-choisi(rang: int) -> string;
    callback filtrer-produits(texte: string);
    callback ajouter-produit(rang: int);
    callback ajouter-ligne-libre();
    // Référence saisie sur une ligne : reprend le produit s'il existe.
    callback reference-saisie(ligne: int);
    callback deplacer-ligne(ligne: int, sens: int);
    callback supprimer-ligne(ligne: int);
    callback recalculer(remise: int, tva: int, retenue: int);
    // Échéance après un changement de date : recalculée si elle valait la date
    // précédente plus le délai de paiement réglé, gardée sinon.
    callback echeance-apres-date(date-precedente: string, date: string, echeance: string) -> string;
    callback enregistrer(fiche: FicheFactureUi) -> Retour;
    callback valider(fiche: FicheFactureUi) -> Retour;
    callback marquer-envoye() -> Retour;
    // Réception d'un bon de commande : quantités reçues cumulées lues sur les lignes.
    callback enregistrer-reception() -> Retour;
    callback annuler-document() -> Retour;
    callback supprimer() -> Retour;
    callback enregistrer-administratif(mode: int, observations: string) -> Retour;
    // PDF du document enregistré : aperçu filigrané pour un brouillon, document
    // définitif une fois validé, filigrane « ANNULÉ » s'il est annulé.
    callback exporter-pdf() -> Retour;
    // Chacune ouvre le brouillon créé, dans la page de son type.
    callback convertir() -> Retour;
    callback dupliquer(annuler-original: bool) -> Retour;
    callback creer-avoir() -> Retour;
    callback ouvrir-lien(id: int) -> Retour;

    // Raccourcis clavier (cahier, section 4.1) : la page les reçoit et augmente le
    // compteur de la demande ; le registre ou la fiche affiché y répond.
    in-out property <int> demande-enregistrer;
    in-out property <int> demande-pdf;
    in-out property <int> demande-recherche;
    // La fiche rend le focus à la page quand l'élément qui l'avait disparaît
    // (panneau refermé) : sans élément focalisé, aucun raccourci n'arrive.
    in-out property <int> demande-focus;

    // Création rapide d'un client depuis la fiche : le client créé est ajouté à la
    // liste, et son rang y est donné par `rang-nouveau-client` pour le choisir aussitôt.
    callback creer-client(nom: string, telephone: string, adresse: string, ifu: string, rccm: string) -> Retour;
    in-out property <int> rang-nouveau-client;
}

component Registre inherits VerticalLayout {
    property <string> erreur-filtre;

    function filtrer() {
        root.erreur-filtre = FacturesApi.filtrer(recherche.text, statut.current-index, FacturesApi.avec-paiement ? paiement.current-index : 0, du.text, au.text);
    }

    padding: 24px;
    spacing: 12px;

    Rangee {
        spacing: 8px;

        Titre {
            text: FacturesApi.textes.titre;
        }

        Rectangle { }

        if FacturesApi.peut-creer: Bouton {
            text: FacturesApi.textes.nouveau;
            primary: true;
            clicked => {
                FacturesApi.nouvelle();
            }
        }
    }

    Rangee {
        spacing: 8px;

        recherche := LineEdit {
            placeholder-text: FacturesApi.textes.recherche;
            edited => {
                root.filtrer();
            }
        }

        statut := ComboBox {
            width: 150px;
            model: FacturesApi.statuts;
            selected => {
                root.filtrer();
            }
        }

        paiement := ComboBox {
            visible: FacturesApi.avec-paiement;
            width: FacturesApi.avec-paiement ? 160px : 0px;
            model: [@tr("Tout paiement"), @tr("Impayé"), @tr("Partiel"), @tr("Payé")];
            selected => {
                root.filtrer();
            }
        }

        du := LineEdit {
            width: 120px;
            placeholder-text: @tr("Du JJ/MM/AAAA");
            edited => {
                root.filtrer();
            }
        }

        au := LineEdit {
            width: 120px;
            placeholder-text: @tr("Au JJ/MM/AAAA");
            edited => {
                root.filtrer();
            }
        }
    }

    if root.erreur-filtre != "": Text {
        horizontal-alignment: Theme.debut;
        text: root.erreur-filtre;
        color: Theme.erreur;
    }

    StandardTableView {
        // De droite à gauche, colonnes en ordre inverse (cellules inversées dans modele_lignes).
        columns: Theme.rtl ? [
            { title: @tr("Échéance"), min-width: 85px, horizontal-stretch: 0 },
            { title: @tr("Mode"), min-width: 100px, horizontal-stretch: 1 },
            { title: @tr("Paiement"), min-width: 85px, horizontal-stretch: 0 },
            { title: @tr("Statut"), min-width: 80px, horizontal-stretch: 0 },
            { title: @tr("Montant TTC"), min-width: 100px, horizontal-stretch: 1 },
            { title: @tr("Libellé"), min-width: 110px, horizontal-stretch: 2 },
            { title: FacturesApi.textes.tiers, min-width: 130px, horizontal-stretch: 2 },
            { title: @tr("Date"), min-width: 85px, horizontal-stretch: 0 },
            { title: @tr("N°"), min-width: 110px, horizontal-stretch: 1 },
        ] : [
            { title: @tr("N°"), min-width: 110px, horizontal-stretch: 1 },
            { title: @tr("Date"), min-width: 85px, horizontal-stretch: 0 },
            { title: FacturesApi.textes.tiers, min-width: 130px, horizontal-stretch: 2 },
            { title: @tr("Libellé"), min-width: 110px, horizontal-stretch: 2 },
            { title: @tr("Montant TTC"), min-width: 100px, horizontal-stretch: 1 },
            { title: @tr("Statut"), min-width: 80px, horizontal-stretch: 0 },
            { title: @tr("Paiement"), min-width: 85px, horizontal-stretch: 0 },
            { title: @tr("Mode"), min-width: 100px, horizontal-stretch: 1 },
            { title: @tr("Échéance"), min-width: 85px, horizontal-stretch: 0 },
        ];
        rows: FacturesApi.registre;
        current-row <=> FacturesApi.ligne-courante;
        current-row-changed(ligne) => {
            FacturesApi.selectionner(ligne);
        }
        sort-ascending(colonne) => {
            FacturesApi.trier(Theme.rtl ? 8 - colonne : colonne, true);
        }
        sort-descending(colonne) => {
            FacturesApi.trier(Theme.rtl ? 8 - colonne : colonne, false);
        }
    }

    Text {
        horizontal-alignment: Theme.debut;
        text: FacturesApi.resume + " " + FacturesApi.textes.aide-registre;
        font-size: 12px;
        color: Theme.texte-secondaire;
    }

    // Ctrl+F : curseur dans la recherche.
    property <int> demande-recherche: FacturesApi.demande-recherche;
    changed demande-recherche => {
        recherche.focus();
        recherche.select-all();
    }

    init => {
        root.filtrer();
    }
}

// Libellé et valeur alignés à droite, pour le bloc des totaux.
component LigneTotal inherits Rangee {
    in property <string> libelle;
    in property <string> valeur;
    in property <bool> fort;

    spacing: 12px;

    Text {
        text: root.libelle;
        horizontal-stretch: 1;
        horizontal-alignment: Theme.fin;
        color: Theme.texte-secondaire;
        font-weight: root.fort ? 700 : 400;
    }

    Text {
        text: root.valeur;
        width: 140px;
        horizontal-alignment: Theme.fin;
        color: Theme.texte;
        font-weight: root.fort ? 700 : 400;
    }
}

component Etiquette inherits Text {
    font-size: 12px;
    color: Theme.texte-secondaire;
}

component PetitBouton inherits Bouton {
    width: 36px;
}

component Fiche inherits ScrollView {
    property <FicheFactureUi> fiche;
    property <Retour> retour;
    // Message d'ouverture (document créé depuis une autre page), sous le bandeau :
    // la fiche s'ouvre en haut, loin des actions.
    property <Retour> retour-ouverture;
    // Création rapide d'un client : panneau ouvert, filtre de la liste des clients.
    property <bool> creation-client;
    property <Retour> retour-client;
    property <string> filtre-client;
    // Rang de la retenue : la liste n'existe que pour un bon de commande.
    property <int> retenue-index;
    // 0 aucune, 1 valider, 2 annuler, 3 supprimer, 4 corriger.
    property <int> confirmation: 0;
    property <int> version-chargee: -1;
    property <string> date-precedente;

    function charger(f: FicheFactureUi) {
        root.version-chargee = FacturesApi.version-fiche;
        root.fiche = f;
        root.confirmation = 0;
        root.retour-ouverture = { };
        root.creation-client = false;
        root.filtre-client = "";
        date.valeur = f.date;
        root.date-precedente = f.date;
        echeance.valeur = f.echeance;
        libelle.valeur = f.libelle;
        observations.valeur = f.observations;
        client.current-index = f.client-index;
        remise.current-index = f.remise-index;
        tva.current-index = f.tva-index;
        root.retenue-index = f.retenue-index;
        mode.current-index = f.mode-index;
    }

    function saisie() -> FicheFactureUi {
        {
            existe: root.fiche.existe,
            date: date.valeur,
            echeance: echeance.valeur,
            libelle: libelle.valeur,
            observations: observations.valeur,
            client-index: client.current-index,
            remise-index: remise.current-index,
            tva-index: tva.current-index,
            retenue-index: root.retenue-index,
            mode-index: mode.current-index,
        }
    }

    function recharger-si-besoin() {
        if (FacturesApi.fiche-ouverte && FacturesApi.version-fiche != root.version-chargee) {
            root.charger(FacturesApi.fiche-courante());
        }
    }

    function recalculer() {
        FacturesApi.recalculer(remise.current-index, tva.current-index, root.retenue-index);
    }

    // Ctrl+S : comme le bouton d'enregistrement affiché (brouillon, ou mode et
    // observations d'un document validé).
    property <int> demande-enregistrer: FacturesApi.demande-enregistrer;
    changed demande-enregistrer => {
        if (root.fiche.modifiable) {
            root.confirmation = 0;
            root.retour = FacturesApi.enregistrer(root.saisie());
            root.recharger-si-besoin();
        } else if (root.fiche.admin-modifiable) {
            root.confirmation = 0;
            root.retour = FacturesApi.enregistrer-administratif(mode.current-index, observations.valeur);
            root.recharger-si-besoin();
        }
    }

    // Ctrl+P : comme le bouton PDF, une fois le document enregistré.
    property <int> demande-pdf: FacturesApi.demande-pdf;
    changed demande-pdf => {
        if (root.fiche.existe && FacturesApi.avec-pdf) {
            root.confirmation = 0;
            root.retour = FacturesApi.exporter-pdf();
        }
    }

    init => {
        root.charger(FacturesApi.fiche-courante());
        root.retour-ouverture = FacturesApi.message-ouverture;
        FacturesApi.message-ouverture = { };
    }

    VerticalLayout {
        width: root.visible-width;
        padding: 24px;
        spacing: 14px;
        alignment: start;

        Rangee {
            spacing: 12px;

            Bouton {
                text: @tr("Retour au registre");
                clicked => {
                    FacturesApi.fermer-fiche();
                }
            }

            Titre {
                text: root.fiche.titre;
                vertical-alignment: center;
            }

            Rectangle { }
        }

        // Bandeau : statut et état de paiement.
        Rectangle {
            height: 36px;
            border-radius: 4px;
            background: root.fiche.annule ? #fdecea : (root.fiche.brouillon ? #fff4e5 : Theme.accent-survol);

            Rangee {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 24px;

                Text {
                    horizontal-alignment: Theme.debut;
                    text: @tr("Statut : {}", root.fiche.statut);
                    font-weight: 700;
                    color: Theme.texte;
                    vertical-alignment: center;
                }

                if root.fiche.paiement != "": Text {
                    horizontal-alignment: Theme.debut;
                    text: @tr("Paiement : {}", root.fiche.paiement);
                    color: Theme.texte;
                    vertical-alignment: center;
                }

                if root.fiche.montant-du != "": Text {
                    horizontal-alignment: Theme.debut;
                    text: @tr("Montant dû après avoirs : {} FCFA", root.fiche.montant-du);
                    color: Theme.texte;
                    vertical-alignment: center;
                }

                Rectangle { }

                if root.fiche.en-preparation: Text {
                    horizontal-alignment: Theme.debut;
                    text: @tr("Facture en préparation");
                    color: Theme.texte-secondaire;
                    vertical-alignment: center;
                }

                if root.fiche.brouillon: Text {
                    horizontal-alignment: Theme.debut;
                    text: FacturesApi.textes.sans-numero;
                    color: Theme.texte-secondaire;
                    vertical-alignment: center;
                }
            }
        }

        if root.retour-ouverture.message != "": MessageRetour {
            retour: root.retour-ouverture;
        }

        // En-tête : client, dates, libellé.
        // Grille et non Rangee : le détail du client, à la ligne, y garde une hauteur stable.
        GridLayout {
            spacing: 16px;

            VerticalLayout {
                row: 0;
                col: Theme.rtl ? 2 : 0;
                spacing: 4px;
                horizontal-stretch: 2;

                Etiquette {
                    text: FacturesApi.textes.tiers;
                }

                Rangee {
                    spacing: 8px;

                    if root.fiche.client-modifiable: recherche-client := LineEdit {
                        width: 160px;
                        text <=> root.filtre-client;
                        placeholder-text: FacturesApi.textes.filtrer-tiers;
                        edited(texte) => {
                            client.current-index = FacturesApi.filtrer-clients(texte, client.current-index);
                            root.fiche.tiers-detail = FacturesApi.client-choisi(client.current-index);
                        }
                    }

                    client := ComboBox {
                        model: FacturesApi.clients;
                        enabled: root.fiche.client-modifiable;
                        selected => {
                            root.fiche.tiers-detail = FacturesApi.client-choisi(self.current-index);
                        }
                    }

                    if root.fiche.client-modifiable && Droits.ajouter-referentiel && !root.creation-client: Bouton {
                        text: FacturesApi.textes.nouveau-tiers;
                        clicked => {
                            root.retour-client = { };
                            root.creation-client = true;
                        }
                    }
                }

                Text {
                    horizontal-alignment: Theme.debut;
                    text: root.fiche.tiers-detail;
                    font-size: 12px;
                    color: Theme.texte-secondaire;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                row: 0;
                col: 1;
                horizontal-stretch: 1;
                alignment: start;

                date := Champ {
                    libelle: @tr("Date (JJ/MM/AAAA)");
                    lecture-seule: !root.fiche.modifiable;
                    modifie(texte) => {
                        echeance.valeur = FacturesApi.echeance-apres-date(root.date-precedente, texte, echeance.valeur);
                        root.date-precedente = texte;
                    }
                }
            }

            VerticalLayout {
                row: 0;
                col: Theme.rtl ? 0 : 2;
                horizontal-stretch: 1;
                alignment: start;

                echeance := Champ {
                    libelle: FacturesApi.textes.libelle-echeance;
                    lecture-seule: !root.fiche.modifiable;
                }
            }
        }

        // Création rapide d'un client, sans quitter la fiche.
        if root.creation-client: Rectangle {
            border-width: 1px;
            border-color: Theme.bordure;
            border-radius: 4px;

            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                Section {
                    text: FacturesApi.textes.nouveau-tiers;
                }

                Rangee {
                    spacing: 12px;

                    nom-client := Champ {
                        libelle: @tr("Nom (obligatoire)");
                        horizontal-stretch: 2;
                    }

                    telephone-client := Champ {
                        libelle: @tr("Téléphone");
                        horizontal-stretch: 1;
                    }
                }

                Rangee {
                    spacing: 12px;

                    adresse-client := Champ {
                        libelle: @tr("Adresse");
                        horizontal-stretch: 2;
                    }

                    ifu-client := Champ {
                        libelle: @tr("IFU");
                        horizontal-stretch: 1;
                    }

                    rccm-client := Champ {
                        libelle: @tr("RCCM");
                        horizontal-stretch: 1;
                    }
                }

                Rangee {
                    spacing: 8px;
                    alignment: start;

                    Bouton {
                        text: FacturesApi.textes.creer-tiers;
                        primary: true;
                        enabled: nom-client.valeur != "";
                        clicked => {
                            root.retour-client = FacturesApi.creer-client(nom-client.valeur, telephone-client.valeur, adresse-client.valeur, ifu-client.valeur, rccm-client.valeur);
                            if (root.retour-client.ok) {
                                root.filtre-client = "";
                                client.current-index = FacturesApi.rang-nouveau-client;
                                root.fiche.tiers-detail = FacturesApi.client-choisi(client.current-index);
                                root.retour = root.retour-client;
                                root.creation-client = false;
                                FacturesApi.demande-focus += 1;
                            }
                        }
                    }

                    Bouton {
                        text: @tr("Revenir");
                        clicked => {
                            root.creation-client = false;
                            FacturesApi.demande-focus += 1;
                        }
                    }
                }

                if !root.retour-client.ok && root.retour-client.message != "": MessageRetour {
                    retour: root.retour-client;
                }

                Text {
                    horizontal-alignment: Theme.debut;
                    text: FacturesApi.textes.note-tiers;
                    font-size: 12px;
                    color: Theme.texte-secondaire;
                    wrap: word-wrap;
                }
            }
        }

        libelle := Champ {
            libelle: @tr("Libellé");
            lecture-seule: !root.fiche.modifiable;
        }

        // Lignes.
        Section {
            text: @tr("Lignes");
        }

        Rangee {
            spacing: 8px;

            Etiquette {
                text: @tr("Référence");
                width: 120px;
            }

            Etiquette {
                text: @tr("Désignation");
                horizontal-stretch: 1;
            }

            Etiquette {
                text: @tr("Prix unitaire");
                width: 110px;
            }

            Etiquette {
                text: @tr("Quantité");
                width: 80px;
            }

            Etiquette {
                text: @tr("Total");
                width: 110px;
                horizontal-alignment: Theme.fin;
            }

            if root.fiche.avec-reception: Etiquette {
                text: @tr("Reçue");
                width: 80px;
                horizontal-alignment: Theme.fin;
            }

            if root.fiche.modifiable: Rectangle {
                width: 124px;
            }
        }

        for ligne[i] in FacturesApi.lignes: Rangee {
            spacing: 8px;

            LineEdit {
                width: 120px;
                text <=> ligne.reference;
                read-only: !root.fiche.modifiable;
                accepted => {
                    FacturesApi.reference-saisie(i);
                    root.recalculer();
                }
            }

            LineEdit {
                horizontal-stretch: 1;
                text <=> ligne.designation;
                read-only: !root.fiche.modifiable;
            }

            LineEdit {
                width: 110px;
                text <=> ligne.prix;
                read-only: !root.fiche.modifiable;
                horizontal-alignment: Theme.fin;
                edited => {
                    root.recalculer();
                }
            }

            LineEdit {
                width: 80px;
                text <=> ligne.quantite;
                read-only: !root.fiche.modifiable;
                horizontal-alignment: Theme.fin;
                edited => {
                    root.recalculer();
                }
            }

            Text {
                width: 110px;
                text: ligne.total;
                horizontal-alignment: Theme.fin;
                vertical-alignment: center;
                color: Theme.texte;
            }

            if root.fiche.avec-reception: LineEdit {
                width: 80px;
                text <=> ligne.recue;
                read-only: !root.fiche.reception-modifiable;
                horizontal-alignment: Theme.fin;
            }

            if root.fiche.modifiable: PetitBouton {
                text: "↑";
                enabled: i > 0;
                clicked => {
                    FacturesApi.deplacer-ligne(i, -1);
                }
            }

            if root.fiche.modifiable: PetitBouton {
                text: "↓";
                enabled: i < FacturesApi.lignes.length - 1;
                clicked => {
                    FacturesApi.deplacer-ligne(i, 1);
                }
            }

            if root.fiche.modifiable: PetitBouton {
                text: "×";
                // Les totaux sont recalculés par l'application : cette ligne,
                // et donc ce gestionnaire, disparaît avec la suppression.
                clicked => {
                    // Le champ qui avait le focus peut disparaître avec la ligne.
                    FacturesApi.demande-focus += 1;
                    FacturesApi.supprimer-ligne(i);
                }
            }
        }

        if FacturesApi.lignes.length == 0: Text {
            horizontal-alignment: Theme.debut;
            text: @tr("Aucune ligne.");
            color: Theme.texte-secondaire;
        }

        // Texte à la ligne sous le bouton : dans une rangée, son retour à la ligne
        // ferait dépendre la hauteur de la largeur (boucle de mise en page).
        if root.fiche.reception-modifiable: VerticalLayout {
            spacing: 6px;

            Rangee {
                alignment: start;

                Bouton {
                    text: @tr("Enregistrer la réception");
                    primary: true;
                    clicked => {
                        root.confirmation = 0;
                        root.retour = FacturesApi.enregistrer-reception();
                        root.recharger-si-besoin();
                    }
                }
            }

            Text {
                horizontal-alignment: Theme.debut;
                text: @tr("Saisir pour chaque ligne la quantité reçue depuis la commande, livraisons précédentes comprises. Une réception complète est définitive.");
                font-size: 12px;
                color: Theme.texte-secondaire;
                wrap: word-wrap;
            }
        }

        if root.fiche.modifiable: Rangee {
            spacing: 8px;

            recherche-produit := LineEdit {
                width: 200px;
                placeholder-text: @tr("Filtrer les produits");
                edited(texte) => {
                    FacturesApi.filtrer-produits(texte);
                    produit.current-index = 0;
                }
            }

            produit := ComboBox {
                horizontal-stretch: 1;
                model: FacturesApi.produits;
            }

            Bouton {
                text: @tr("Ajouter le produit");
                enabled: FacturesApi.produits.length > 0;
                clicked => {
                    FacturesApi.ajouter-produit(produit.current-index);
                    root.recalculer();
                }
            }

            Bouton {
                text: @tr("Ligne libre");
                clicked => {
                    FacturesApi.ajouter-ligne-libre();
                }
            }
        }

        if root.fiche.modifiable: Text {
            horizontal-alignment: Theme.debut;
            text: @tr("Le produit choisi remplit la référence, la désignation et le prix, qui restent modifiables sur la ligne. Une référence tapée puis validée par Entrée reprend le produit correspondant.");
            font-size: 12px;
            color: Theme.texte-secondaire;
            wrap: word-wrap;
        }

        // Taux, paiement et totaux.
        // Grille et non Rangee : le montant en lettres, à la ligne, y garde une hauteur stable.
        GridLayout {
            spacing: 24px;

            VerticalLayout {
                row: 0;
                col: Theme.rtl ? 1 : 0;
                spacing: 10px;
                // Trois listes de taux (remise, TVA, retenue) pour un bon de commande.
                width: FacturesApi.avec-retenue ? 510px : 340px;

                Rangee {
                    spacing: 12px;

                    VerticalLayout {
                        spacing: 4px;

                        Etiquette {
                            text: @tr("Remise");
                        }

                        remise := ComboBox {
                            model: FacturesApi.taux-remise;
                            enabled: root.fiche.taux-modifiables;
                            selected => {
                                root.recalculer();
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;

                        Etiquette {
                            text: @tr("TVA");
                        }

                        tva := ComboBox {
                            model: FacturesApi.taux-tva;
                            enabled: root.fiche.taux-modifiables;
                            selected => {
                                root.recalculer();
                            }
                        }
                    }

                    if FacturesApi.avec-retenue: VerticalLayout {
                        spacing: 4px;

                        Etiquette {
                            text: @tr("Retenue");
                        }

                        ComboBox {
                            model: FacturesApi.taux-retenue;
                            enabled: root.fiche.taux-modifiables;
                            current-index <=> root.retenue-index;
                            selected => {
                                root.recalculer();
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 4px;

                    Etiquette {
                        text: @tr("Mode de paiement");
                    }

                    mode := ComboBox {
                        model: FacturesApi.modes-paiement;
                        enabled: root.fiche.modifiable || root.fiche.admin-modifiable;
                    }
                }

                observations := Champ {
                    libelle: @tr("Observations");
                    lecture-seule: !(root.fiche.modifiable || root.fiche.admin-modifiable);
                }
            }

            VerticalLayout {
                row: 0;
                col: Theme.rtl ? 0 : 1;
                spacing: 6px;
                horizontal-stretch: 1;

                LigneTotal {
                    libelle: @tr("Montant HT");
                    valeur: FacturesApi.totaux.ht;
                }

                LigneTotal {
                    libelle: @tr("Remise");
                    valeur: FacturesApi.totaux.remise;
                }

                LigneTotal {
                    libelle: @tr("Base TVA");
                    valeur: FacturesApi.totaux.base-tva;
                }

                LigneTotal {
                    libelle: @tr("TVA");
                    valeur: FacturesApi.totaux.tva;
                }

                if FacturesApi.avec-retenue: LigneTotal {
                    libelle: @tr("Retenue");
                    valeur: FacturesApi.totaux.retenue;
                }

                LigneTotal {
                    libelle: @tr("Montant TTC");
                    valeur: FacturesApi.totaux.ttc;
                    fort: true;
                }

                Text {
                    text: FacturesApi.totaux.lettres;
                    horizontal-alignment: Theme.fin;
                    color: Theme.texte-secondaire;
                    wrap: word-wrap;
                }
            }
        }

        // Actions selon le statut.
        Rangee {
            spacing: 8px;
            alignment: start;

            if root.fiche.modifiable: Bouton {
                text: @tr("Enregistrer le brouillon");
                primary: !root.fiche.peut-valider;
                clicked => {
                    root.confirmation = 0;
                    root.retour = FacturesApi.enregistrer(root.saisie());
                    root.recharger-si-besoin();
                }
            }

            if root.fiche.peut-valider: Bouton {
                text: @tr("Valider");
                primary: true;
                clicked => {
                    root.retour = { };
                    root.confirmation = 1;
                }
            }

            if root.fiche.admin-modifiable: Bouton {
                text: @tr("Enregistrer le mode et les observations");
                clicked => {
                    root.confirmation = 0;
                    root.retour = FacturesApi.enregistrer-administratif(mode.current-index, observations.valeur);
                    root.recharger-si-besoin();
                }
            }

            if root.fiche.peut-envoyer: Bouton {
                text: FacturesApi.textes.marquer-envoye;
                clicked => {
                    root.confirmation = 0;
                    root.retour = FacturesApi.marquer-envoye();
                    root.recharger-si-besoin();
                }
            }

            if root.fiche.peut-annuler: Bouton {
                text: FacturesApi.textes.annuler;
                clicked => {
                    root.retour = { };
                    root.confirmation = 2;
                }
            }

            if root.fiche.existe && FacturesApi.avec-pdf: Bouton {
                text: root.fiche.brouillon ? @tr("Aperçu PDF") : @tr("Exporter en PDF");
                clicked => {
                    root.confirmation = 0;
                    root.retour = FacturesApi.exporter-pdf();
                }
            }

            if root.fiche.peut-supprimer: Bouton {
                text: @tr("Supprimer le brouillon");
                clicked => {
                    root.retour = { };
                    root.confirmation = 3;
                }
            }
        }

        // Documents qui naissent de celui-ci : chacun ouvre sa fiche une fois créé.
        if root.fiche.peut-convertir || root.fiche.peut-dupliquer || root.fiche.peut-corriger || root.fiche.peut-creer-avoir: Rangee {
            spacing: 8px;
            alignment: start;

            if root.fiche.peut-convertir: Bouton {
                text: @tr("Convertir en facture");
                clicked => {
                    root.confirmation = 0;
                    root.retour = FacturesApi.convertir();
                    root.recharger-si-besoin();
                }
            }

            if root.fiche.peut-creer-avoir: Bouton {
                text: @tr("Créer un avoir");
                enabled: root.fiche.avoir-possible;
                clicked => {
                    root.confirmation = 0;
                    root.retour = FacturesApi.creer-avoir();
                    root.recharger-si-besoin();
                }
            }

            if root.fiche.peut-dupliquer: Bouton {
                text: @tr("Dupliquer");
                clicked => {
                    root.confirmation = 0;
                    // Un brouillon est d'abord enregistré : la copie reprend la saisie affichée.
                    if (root.fiche.modifiable) {
                        root.retour = FacturesApi.enregistrer(root.saisie());
                        root.recharger-si-besoin();
                    }
                    if (!root.fiche.modifiable || root.retour.ok) {
                        root.retour = FacturesApi.dupliquer(false);
                        root.recharger-si-besoin();
                    }
                }
            }

            if root.fiche.peut-corriger: Bouton {
                text: @tr("Corriger");
                clicked => {
                    root.retour = { };
                    root.confirmation = 4;
                }
            }
        }

        if root.confirmation != 0: VerticalLayout {
            spacing: 8px;

            Text {
                horizontal-alignment: Theme.debut;
                text: root.confirmation == 1 ? FacturesApi.textes.confirmer-validation : (root.confirmation == 2 ? FacturesApi.textes.confirmer-annulation : (root.confirmation == 4 ? @tr("Corriger ce document ? Il est annulé, son numéro conservé, et une copie modifiable est créée en brouillon.") : @tr("Supprimer ce brouillon ? Il disparaît du registre ; la suppression reste tracée dans le journal d'audit.")));
                color: Theme.texte;
                wrap: word-wrap;
            }

            Rangee {
                spacing: 8px;
                alignment: start;

                Bouton {
                    text: root.confirmation == 1 ? @tr("Confirmer la validation") : (root.confirmation == 2 ? @tr("Confirmer l'annulation") : (root.confirmation == 4 ? @tr("Confirmer la correction") : @tr("Confirmer la suppression")));
                    primary: true;
                    clicked => {
                        if (root.confirmation == 1) {
                            root.retour = FacturesApi.valider(root.saisie());
                        } else if (root.confirmation == 2) {
                            root.retour = FacturesApi.annuler-document();
                        } else if (root.confirmation == 4) {
                            root.retour = FacturesApi.dupliquer(true);
                        } else {
                            root.retour = FacturesApi.supprimer();
                        }
                        root.confirmation = 0;
                        root.recharger-si-besoin();
                        // Validée ou annulée, la fiche n'est plus modifiable : les champs
                        // de saisie des produits disparaissent, peut-être avec le focus.
                        FacturesApi.demande-focus += 1;
                    }
                }

                Bouton {
                    text: @tr("Revenir");
                    clicked => {
                        root.confirmation = 0;
                    }
                }
            }
        }

        if root.retour.message != "": MessageRetour {
            retour: root.retour;
        }

        if root.fiche.note != "": Text {
            horizontal-alignment: Theme.debut;
            text: root.fiche.note;
            color: Theme.texte-secondaire;
            wrap: word-wrap;
        }

        // Documents liés : origine, puis documents issus de celui-ci.
        if FacturesApi.liens.length > 0: Section {
            text: @tr("Documents liés");
        }

        for lien in FacturesApi.liens: Rangee {
            alignment: start;

            Bouton {
                text: lien.texte;
                clicked => {
                    root.confirmation = 0;
                    root.retour = FacturesApi.ouvrir-lien(lien.id);
                    root.recharger-si-besoin();
                }
            }
        }

        // Historique des changements de statut.
        if FacturesApi.historique.length > 0: Section {
            text: @tr("Historique");
        }

        for evenement in FacturesApi.historique: Rangee {
            spacing: 12px;

            Text {
                horizontal-alignment: Theme.debut;
                text: evenement.date;
                width: 140px;
                color: Theme.texte-secondaire;
            }

            Text {
                horizontal-alignment: Theme.debut;
                text: evenement.libelle;
                horizontal-stretch: 1;
                color: Theme.texte;
            }

            Text {
                horizontal-alignment: Theme.debut;
                text: evenement.utilisateur;
                width: 200px;
                color: Theme.texte-secondaire;
            }
        }
    }
}

export component PageFactures inherits Rectangle {
    // Rang du type dans TypeDocument::TOUS (0 devis, 1 proforma, 4 facture, 5 avoir).
    in property <int> type-document;

    init => {
        FacturesApi.ouvrir(root.type-document);
        raccourcis.focus();
    }

    // Le registre et la fiche sont recréés à chaque bascule : l'élément qui avait
    // le focus disparaît, la page le reprend pour que les raccourcis restent actifs.
    property <bool> fiche-ouverte: FacturesApi.fiche-ouverte;
    changed fiche-ouverte => {
        raccourcis.focus();
    }

    property <int> demande-focus: FacturesApi.demande-focus;
    changed demande-focus => {
        raccourcis.focus();
    }

    // Raccourcis de la page : reçus ici quand l'élément qui a le focus (champ, liste,
    // tableau) ne les a pas pris pour lui.
    raccourcis := FocusScope {
        KeyBinding {
            keys: @keys(Control + N);
            activated => {
                if (FacturesApi.peut-creer && !FacturesApi.fiche-ouverte) {
                    FacturesApi.nouvelle();
                }
            }
        }

        KeyBinding {
            keys: @keys(Control + S);
            activated => {
                FacturesApi.demande-enregistrer += 1;
            }
        }

        KeyBinding {
            keys: @keys(Control + P);
            activated => {
                FacturesApi.demande-pdf += 1;
            }
        }

        KeyBinding {
            keys: @keys(Control + F);
            activated => {
                FacturesApi.demande-recherche += 1;
            }
        }

        if !FacturesApi.fiche-ouverte: Registre { }

        if FacturesApi.fiche-ouverte: Fiche { }
    }
}

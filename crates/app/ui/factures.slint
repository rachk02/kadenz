// Écran commun des documents à montants (Devis, Proforma, Bon de commande, Facture, Avoir) : registre
// filtrable, puis fiche en pleine page (cahier des charges, sections 4.1, 4.2, 6 et 7).
// Tous les calculs et les contrôles sont faits par l'application, qui fournit aussi
// les textes propres au type : cet écran ne fait qu'afficher et transmettre la saisie.

import { CheckBox, ComboBox, LineEdit, ScrollView, StandardTableView } from "std-widgets.slint";
import { ConnexionApi } from "etat-connexion.slint";
import { Alerte, Bouton, Champ, Confirmation, Droits, Ecriture, MessageRetour, Rangee, Retour, Section, Theme, Titre } from "composants.slint";

export struct LigneFactureUi {
    // 0 pour une ligne libre, sans produit d'origine.
    produit-id: int,
    reference: string,
    designation: string,
    prix: string,
    quantite: string,
    total: string,
    // Quantité reçue cumulée (bon de commande en réception) ou quantité livrée
    // (bordereau de livraison).
    recue: string,
    observations: string,
    // Reste à livrer avant ce bordereau (bordereau issu d'une facture).
    reste: string,
}

export struct FicheFactureUi {
    existe: bool,
    titre: string,
    statut: string,
    paiement: string,
    brouillon: bool,
    annule: bool,
    date: string,
    echeance: string,
    libelle: string,
    observations: string,
    client-index: int,
    tiers-detail: string,
    remise-index: int,
    tva-index: int,
    // Retenue à la source : bon de commande seulement.
    retenue-index: int,
    mode-index: int,
    modifiable: bool,
    // Faux pour un avoir : son client est celui de la facture d'origine.
    client-modifiable: bool,
    // Faux pour un avoir : sa remise et sa TVA sont celles de la facture d'origine.
    taux-modifiables: bool,
    admin-modifiable: bool,
    peut-valider: bool,
    // Validation demandée hors connexion : proposée au retour du serveur.
    a-valider: bool,
    peut-envoyer: bool,
    peut-annuler: bool,
    peut-supprimer: bool,
    // Bon de commande envoyé ou en réception : colonne des quantités reçues, et sa
    // saisie tant que la réception n'est pas complète (droit « Valider un document »).
    avec-reception: bool,
    reception-modifiable: bool,
    // Bordereau issu d'une facture : client et lignes repris de la facture, seules
    // la quantité livrée et les observations de ligne se modifient.
    lignes-verrouillees: bool,
    avec-reste: bool,
    // Visas et dates du bordereau, modifiables en brouillon et une fois validé,
    // jusqu'à la confirmation de la livraison.
    visa-client: string,
    visa-fournisseur: string,
    date-livraison: string,
    date-reception: string,
    visas-modifiables: bool,
    peut-confirmer-livraison: bool,
    // Facture validée ou envoyée : bouton « Créer un bordereau », grisé quand
    // tout est déjà livré ou en cours de livraison.
    peut-creer-bordereau: bool,
    bordereau-possible: bool,
    // Texte du bouton d'enregistrement d'un document validé.
    libelle-administratif: string,
    // Devis ou proforma validé ou envoyé, sans facture en préparation.
    peut-convertir: bool,
    peut-dupliquer: bool,
    // Correction d'un devis ou d'une proforma : copie en brouillon, original annulé.
    peut-corriger: bool,
    // Facture validée ou envoyée et droit de créer un avoir ; le bouton est grisé
    // si ses avoirs couvrent déjà tout le montant (`avoir-possible` faux).
    peut-creer-avoir: bool,
    avoir-possible: bool,
    // Montant dû diminué des avoirs validés ; vide s'il vaut le TTC.
    montant-du: string,
    // Règlements : section affichée pour une facture ou un bon de commande en
    // vigueur ; saisie et suppression au droit « Saisir un règlement ».
    avec-reglements: bool,
    peut-saisir-reglement: bool,
    du-reglements: string,
    regle: string,
    reste-a-payer: string,
    // Saisie proposée : date du jour, reste à payer, mode du document s'il est
    // dans la liste des Paramètres.
    reglement-date: string,
    reglement-montant: string,
    reglement-mode-index: int,
    // Devis ou proforma dont la facture issue de la conversion est encore en brouillon.
    en-preparation: bool,
    // Explication affichée sous les actions quand la fiche n'est pas modifiable
    // (lecture seule, document figé, annulé, converti) ; vide sinon.
    note: string,
}

// Textes propres au type de document (accord du genre compris), traduits par l'application.
export struct TextesDocumentUi {
    titre: string,
    nouveau: string,
    aide-registre: string,
    sans-numero: string,
    libelle-echeance: string,
    marquer-envoye: string,
    annuler: string,
    confirmer-validation: string,
    confirmer-annulation: string,
    // Tiers du type : client pour une vente, fournisseur pour un bon de commande.
    tiers: string,
    recherche: string,
    filtrer-tiers: string,
    nouveau-tiers: string,
    creer-tiers: string,
    note-tiers: string,
}

// Document lié (origine ou document issu de celui-ci), pour la navigation.
export struct LienUi {
    id: int,
    texte: string,
}

export struct TotauxUi {
    ht: string,
    remise: string,
    base-tva: string,
    tva: string,
    retenue: string,
    ttc: string,
    lettres: string,
}

// Règlement d'une facture (encaissement) ou d'un bon de commande (décaissement).
export struct ReglementUi {
    id: int,
    date: string,
    montant: string,
    mode: string,
    reference: string,
    auteur: string,
}

export struct EvenementUi {
    date: string,
    utilisateur: string,
    libelle: string,
}

export global FacturesApi {
    // Registre.
    in property <[[StandardListViewItem]]> registre;
    in property <string> resume;
    in-out property <int> ligne-courante: -1;
    in property <bool> peut-creer;
    in property <bool> fiche-ouverte;
    in property <TextesDocumentUi> textes;
    // Choix du filtre de statut (le premier est « tous ») ; dépend du type.
    in property <[string]> statuts;
    // Filtre et bandeau de paiement : seulement pour un type qui reçoit des règlements.
    in property <bool> avec-paiement;
    // Colonne de l'état de paiement dans le registre : retirée sans le module Paiements.
    in property <bool> colonne-paiement: true;
    // PDF disponible pour ce type.
    in property <bool> avec-pdf;
    // Faux pour le bordereau de livraison : ni prix, ni taux, ni totaux.
    in property <bool> avec-montants: true;
    // Rang du type dans TypeDocument::TOUS.
    callback ouvrir(type-document: int);
    // Statut : rang dans `statuts`. Paiement : 0 tous, 1 impayé, 2 partiel, 3 payé.
    // Renvoie un message si une date de période est illisible.
    callback filtrer(texte: string, statut: int, paiement: int, du: string, au: string) -> string;
    callback trier(colonne: int, croissant: bool);
    callback selectionner(ligne: int);
    callback nouvelle();
    callback fermer-fiche();

    // Fiche. La version augmente à chaque rechargement de la fiche par l'application :
    // l'écran recharge alors ses champs, et seulement dans ce cas (une saisie refusée
    // reste affichée telle quelle pour être corrigée).
    in property <int> version-fiche;
    callback fiche-courante() -> FicheFactureUi;
    in property <[string]> clients;
    in property <[string]> taux-remise;
    in property <[string]> taux-tva;
    // Liste et ligne de retenue : seulement pour un type où elle s'applique.
    in property <bool> avec-retenue;
    in property <[string]> taux-retenue;
    in property <[string]> modes-paiement;
    in property <[string]> produits;
    in property <[LigneFactureUi]> lignes;
    in property <TotauxUi> totaux;
    in property <[EvenementUi]> historique;
    in property <[ReglementUi]> reglements;
    // Modes des Paramètres, sans « Non précisé » : un règlement a toujours un mode.
    in property <[string]> modes-reglement;
    in property <[LienUi]> liens;
    // Message à afficher à l'ouverture d'une fiche dans une autre page (document
    // créé d'un autre type) ; la fiche le reprend puis le vide.
    in-out property <Retour> message-ouverture;
    // Renvoie le nouveau rang du client choisi dans la liste filtrée.
    callback filtrer-clients(texte: string, rang-courant: int) -> int;
    // Renvoie les coordonnées du client choisi.
    callback client-choisi(rang: int) -> string;
    callback filtrer-produits(texte: string);
    callback ajouter-produit(rang: int);
    callback ajouter-ligne-libre();
    // Référence saisie sur une ligne : reprend le produit s'il existe.
    callback reference-saisie(ligne: int);
    callback deplacer-ligne(ligne: int, sens: int);
    callback supprimer-ligne(ligne: int);
    callback recalculer(remise: int, tva: int, retenue: int);
    // Échéance après un changement de date : recalculée si elle valait la date
    // précédente plus le délai de paiement réglé, gardée sinon.
    callback echeance-apres-date(date-precedente: string, date: string, echeance: string) -> string;
    callback enregistrer(fiche: FicheFactureUi) -> Retour;
    callback valider(fiche: FicheFactureUi) -> Retour;
    // Hors connexion : brouillon enregistré et noté pour la validation au retour.
    callback valider-au-retour(fiche: FicheFactureUi) -> Retour;
    callback marquer-envoye() -> Retour;
    // Réception d'un bon de commande : quantités reçues cumulées lues sur les lignes.
    callback enregistrer-reception() -> Retour;
    callback ajouter-reglement(date: string, montant: string, mode: int, reference: string) -> Retour;
    callback supprimer-reglement(id: int) -> Retour;
    // Bordereau : création depuis la facture affichée ; visas, dates et observations
    // d'un bordereau validé ; confirmation de la livraison (visas enregistrés d'abord).
    callback creer-bordereau() -> Retour;
    callback enregistrer-livraison(visa-client: string, visa-fournisseur: string, date-livraison: string, date-reception: string, observations: string) -> Retour;
    callback confirmer-livraison(visa-client: string, visa-fournisseur: string, date-livraison: string, date-reception: string) -> Retour;
    callback annuler-document() -> Retour;
    callback supprimer() -> Retour;
    callback enregistrer-administratif(mode: int, observations: string) -> Retour;
    // PDF du document enregistré : aperçu filigrané pour un brouillon, document
    // définitif une fois validé, filigrane « ANNULÉ » s'il est annulé.
    callback exporter-pdf() -> Retour;
    // Exports Excel (jalon J10) : lignes affichées du registre, ou le document ouvert.
    callback exporter-registre() -> Retour;
    callback exporter-excel() -> Retour;
    // Chacune ouvre le brouillon créé, dans la page de son type.
    callback convertir() -> Retour;
    callback dupliquer(annuler-original: bool) -> Retour;
    callback creer-avoir() -> Retour;
    callback ouvrir-lien(id: int) -> Retour;

    // Raccourcis clavier (cahier, section 4.1) : la page les reçoit et augmente le
    // compteur de la demande ; le registre ou la fiche affiché y répond.
    in-out property <int> demande-enregistrer;
    in-out property <int> demande-pdf;
    in-out property <int> demande-recherche;
    // La fiche rend le focus à la page quand l'élément qui l'avait disparaît
    // (panneau refermé) : sans élément focalisé, aucun raccourci n'arrive.
    in-out property <int> demande-focus;

    // Création rapide d'un client depuis la fiche : le client créé est ajouté à la
    // liste, et son rang y est donné par `rang-nouveau-client` pour le choisir aussitôt.
    callback creer-client(nom: string, telephone: string, adresse: string, ifu: string, rccm: string) -> Retour;
    in-out property <int> rang-nouveau-client;
}

component Registre inherits VerticalLayout {
    property <string> erreur-filtre;
    // Nombre de colonnes affichées : 5 pour le bordereau, 8 sans la colonne Paiement, 9 sinon.
    property <int> nb-colonnes: !FacturesApi.avec-montants ? 5 : FacturesApi.colonne-paiement ? 9 : 8;

    // Colonne cliquée vers le rang attendu par `trier` (ordre de gauche à droite, à
    // neuf colonnes) : miroir de droite à gauche, puis saut de la colonne Paiement absente.
    pure function colonne-logique(c: int) -> int {
        return root.sans-paiement(Theme.rtl ? root.nb-colonnes - 1 - c : c);
    }

    pure function sans-paiement(c: int) -> int {
        return FacturesApi.avec-montants && !FacturesApi.colonne-paiement && c >= 6 ? c + 1 : c;
    }
    property <Retour> retour;

    function filtrer() {
        root.erreur-filtre = FacturesApi.filtrer(recherche.text, statut.current-index, FacturesApi.avec-paiement ? paiement.current-index : 0, du.text, au.text);
    }

    padding: 24px;
    spacing: 12px;

    Rangee {
        spacing: 8px;

        Titre {
            text: FacturesApi.textes.titre;
        }

        Rectangle { }

        Bouton {
            text: @tr("Exporter en Excel");
            clicked => {
                root.retour = FacturesApi.exporter-registre();
            }
        }

        if FacturesApi.peut-creer: Bouton {
            text: FacturesApi.textes.nouveau;
            primary: true;
            clicked => {
                FacturesApi.nouvelle();
            }
        }
    }

    Rangee {
        spacing: 8px;

        recherche := LineEdit {
            placeholder-text: FacturesApi.textes.recherche;
            edited => {
                root.filtrer();
            }
        }

        statut := ComboBox {
            width: 150px;
            model: FacturesApi.statuts;
            selected => {
                root.filtrer();
            }
        }

        paiement := ComboBox {
            visible: FacturesApi.avec-paiement;
            width: FacturesApi.avec-paiement ? 160px : 0px;
            model: [@tr("Tout paiement"), @tr("Impayé"), @tr("Partiel"), @tr("Payé")];
            selected => {
                root.filtrer();
            }
        }

        du := LineEdit {
            width: 120px;
            placeholder-text: @tr("Du JJ/MM/AAAA");
            edited => {
                root.filtrer();
            }
        }

        au := LineEdit {
            width: 120px;
            placeholder-text: @tr("Au JJ/MM/AAAA");
            edited => {
                root.filtrer();
            }
        }
    }

    if root.retour.message != "": MessageRetour {
        retour: root.retour;
    }

    if root.erreur-filtre != "": Text {
        horizontal-alignment: Theme.debut;
        text: root.erreur-filtre;
        color: Theme.erreur;
    }

    StandardTableView {
        // De droite à gauche, colonnes en ordre inverse (cellules inversées dans modele_lignes).
        // Le bordereau n'a que cinq colonnes : ni montant, ni paiement, ni échéance.
        columns: !FacturesApi.avec-montants ? (Theme.rtl ? [
            { title: @tr("Statut"), min-width: 140px, horizontal-stretch: 0 },
            { title: @tr("Libellé"), min-width: 110px, horizontal-stretch: 2 },
            { title: FacturesApi.textes.tiers, min-width: 130px, horizontal-stretch: 2 },
            { title: @tr("Date"), min-width: 85px, horizontal-stretch: 0 },
            { title: @tr("N°"), min-width: 110px, horizontal-stretch: 1 },
        ] : [
            { title: @tr("N°"), min-width: 110px, horizontal-stretch: 1 },
            { title: @tr("Date"), min-width: 85px, horizontal-stretch: 0 },
            { title: FacturesApi.textes.tiers, min-width: 130px, horizontal-stretch: 2 },
            { title: @tr("Libellé"), min-width: 110px, horizontal-stretch: 2 },
            { title: @tr("Statut"), min-width: 140px, horizontal-stretch: 0 },
        ]) : !FacturesApi.colonne-paiement ? (Theme.rtl ? [
            { title: @tr("Échéance"), min-width: 85px, horizontal-stretch: 0 },
            { title: @tr("Mode"), min-width: 100px, horizontal-stretch: 1 },
            { title: @tr("Statut"), min-width: 80px, horizontal-stretch: 0 },
            { title: @tr("Montant TTC"), min-width: 100px, horizontal-stretch: 1 },
            { title: @tr("Libellé"), min-width: 110px, horizontal-stretch: 2 },
            { title: FacturesApi.textes.tiers, min-width: 130px, horizontal-stretch: 2 },
            { title: @tr("Date"), min-width: 85px, horizontal-stretch: 0 },
            { title: @tr("N°"), min-width: 110px, horizontal-stretch: 1 },
        ] : [
            { title: @tr("N°"), min-width: 110px, horizontal-stretch: 1 },
            { title: @tr("Date"), min-width: 85px, horizontal-stretch: 0 },
            { title: FacturesApi.textes.tiers, min-width: 130px, horizontal-stretch: 2 },
            { title: @tr("Libellé"), min-width: 110px, horizontal-stretch: 2 },
            { title: @tr("Montant TTC"), min-width: 100px, horizontal-stretch: 1 },
            { title: @tr("Statut"), min-width: 80px, horizontal-stretch: 0 },
            { title: @tr("Mode"), min-width: 100px, horizontal-stretch: 1 },
            { title: @tr("Échéance"), min-width: 85px, horizontal-stretch: 0 },
        ]) : Theme.rtl ? [
            { title: @tr("Échéance"), min-width: 85px, horizontal-stretch: 0 },
            { title: @tr("Mode"), min-width: 100px, horizontal-stretch: 1 },
            { title: @tr("Paiement"), min-width: 85px, horizontal-stretch: 0 },
            { title: @tr("Statut"), min-width: 80px, horizontal-stretch: 0 },
            { title: @tr("Montant TTC"), min-width: 100px, horizontal-stretch: 1 },
            { title: @tr("Libellé"), min-width: 110px, horizontal-stretch: 2 },
            { title: FacturesApi.textes.tiers, min-width: 130px, horizontal-stretch: 2 },
            { title: @tr("Date"), min-width: 85px, horizontal-stretch: 0 },
            { title: @tr("N°"), min-width: 110px, horizontal-stretch: 1 },
        ] : [
            { title: @tr("N°"), min-width: 110px, horizontal-stretch: 1 },
            { title: @tr("Date"), min-width: 85px, horizontal-stretch: 0 },
            { title: FacturesApi.textes.tiers, min-width: 130px, horizontal-stretch: 2 },
            { title: @tr("Libellé"), min-width: 110px, horizontal-stretch: 2 },
            { title: @tr("Montant TTC"), min-width: 100px, horizontal-stretch: 1 },
            { title: @tr("Statut"), min-width: 80px, horizontal-stretch: 0 },
            { title: @tr("Paiement"), min-width: 85px, horizontal-stretch: 0 },
            { title: @tr("Mode"), min-width: 100px, horizontal-stretch: 1 },
            { title: @tr("Échéance"), min-width: 85px, horizontal-stretch: 0 },
        ];
        rows: FacturesApi.registre;
        current-row <=> FacturesApi.ligne-courante;
        current-row-changed(ligne) => {
            FacturesApi.selectionner(ligne);
        }
        sort-ascending(colonne) => {
            FacturesApi.trier(root.colonne-logique(colonne), true);
        }
        sort-descending(colonne) => {
            FacturesApi.trier(root.colonne-logique(colonne), false);
        }
    }

    Text {
        horizontal-alignment: Theme.debut;
        text: FacturesApi.resume + " " + FacturesApi.textes.aide-registre;
        font-size: 12px;
        color: Theme.texte-secondaire;
    }

    // Ctrl+F : curseur dans la recherche.
    property <int> demande-recherche: FacturesApi.demande-recherche;
    changed demande-recherche => {
        recherche.focus();
        recherche.select-all();
    }

    init => {
        root.filtrer();
    }

    // Poste relié : registre rechargé quand un autre poste change un document.
    property <int> changements: ConnexionApi.changements-documents;
    changed changements => {
        root.filtrer();
    }
}

// Libellé et valeur alignés à droite, pour le bloc des totaux.
component LigneTotal inherits Rangee {
    in property <string> libelle;
    in property <string> valeur;
    in property <bool> fort;

    spacing: 12px;

    Text {
        text: root.libelle;
        horizontal-stretch: 1;
        horizontal-alignment: Theme.fin;
        color: Theme.texte-secondaire;
        font-weight: root.fort ? 700 : 400;
    }

    Text {
        text: root.valeur;
        width: 140px;
        horizontal-alignment: Theme.fin;
        color: Theme.texte;
        font-weight: root.fort ? 700 : 400;
    }
}

component Etiquette inherits Text {
    font-size: 12px;
    color: Theme.texte-secondaire;
}

component PetitBouton inherits Bouton {
    width: 36px;
}

component Fiche inherits ScrollView {
    property <FicheFactureUi> fiche;
    property <Retour> retour;
    // Message d'ouverture (document créé depuis une autre page), sous le bandeau :
    // la fiche s'ouvre en haut, loin des actions.
    property <Retour> retour-ouverture;
    // Création rapide d'un client : panneau ouvert, filtre de la liste des clients.
    property <bool> creation-client;
    property <Retour> retour-client;
    property <string> filtre-client;
    // Rangs des taux et du mode, échéance, visas : leurs champs n'existent que pour
    // certains types (pas de taux ni d'échéance sur un bordereau, retenue sur un
    // bon de commande seulement), d'où ces propriétés liées dans les deux sens.
    property <int> retenue-index;
    property <int> remise-index;
    property <int> tva-index;
    property <int> mode-index;
    property <string> echeance-texte;
    property <string> visa-client;
    property <string> visa-fournisseur;
    property <string> date-livraison;
    property <string> date-reception;
    // Saisie d'un règlement, règlement dont la suppression attend confirmation
    // (0 aucun) et message propre à la section, affiché sous elle.
    property <string> reglement-date;
    property <string> reglement-montant;
    property <int> reglement-mode;
    property <string> reglement-reference;
    property <int> reglement-a-supprimer;
    property <Retour> retour-reglement;
    // 0 aucune, 1 valider, 2 annuler, 3 supprimer, 4 corriger, 5 confirmer la livraison.
    // La demande s'affiche dans la fenêtre de confirmation commune (composants.slint).
    property <int> confirmation: 0;
    changed confirmation => {
        if (self.confirmation != 0) {
            Confirmation.demander(
                self.confirmation == 1 ? FacturesApi.textes.confirmer-validation : (self.confirmation == 2 ? FacturesApi.textes.confirmer-annulation : (self.confirmation == 4 ? @tr("Corriger ce document ? Il est annulé, son numéro conservé, et une copie modifiable est créée en brouillon.") : self.confirmation == 5 ? @tr("Confirmer la livraison ? Le statut passe en livraison partielle ou complète selon les quantités livrées ; le bordereau ne pourra plus être annulé.") : @tr("Supprimer ce brouillon ? Il disparaît du registre ; la suppression reste tracée dans le journal d'audit."))),
                self.confirmation == 1 ? @tr("Confirmer la validation") : (self.confirmation == 2 ? @tr("Confirmer l'annulation") : (self.confirmation == 4 ? @tr("Confirmer la correction") : self.confirmation == 5 ? @tr("Confirmer la livraison") : @tr("Confirmer la suppression"))),
                self.confirmation == 2 || self.confirmation == 3 || self.confirmation == 4);
        }
    }
    changed reglement-a-supprimer => {
        if (self.reglement-a-supprimer != 0) {
            Confirmation.demander(
                @tr("Supprimer ce règlement ? La suppression est inscrite dans l'historique du document, avec son montant."),
                @tr("Confirmer la suppression"),
                true);
        }
    }
    // Réponse de la fenêtre de confirmation : seule la demande en cours de cet écran agit.
    property <int> reponses: Confirmation.reponses;
    changed reponses => {
        if (self.confirmation != 0) {
            if (Confirmation.accepte) {
                root.executer-confirmation();
            }
            self.confirmation = 0;
        } else if (self.reglement-a-supprimer != 0) {
            if (Confirmation.accepte) {
                root.retour-reglement = Alerte.relayer(FacturesApi.supprimer-reglement(root.reglement-a-supprimer));
                root.recharger-si-besoin();
            }
            self.reglement-a-supprimer = 0;
        }
    }
    property <int> version-chargee: -1;
    property <string> date-precedente;

    // Action confirmée : valider, annuler, corriger, confirmer la livraison ou supprimer.
    function executer-confirmation() {
        if (root.confirmation == 1) {
            root.retour = Alerte.relayer(FacturesApi.valider(root.saisie()));
        } else if (root.confirmation == 2) {
            root.retour = Alerte.relayer(FacturesApi.annuler-document());
        } else if (root.confirmation == 4) {
            root.retour = Alerte.relayer(FacturesApi.dupliquer(true));
        } else if (root.confirmation == 5) {
            root.retour = Alerte.relayer(FacturesApi.confirmer-livraison(root.visa-client, root.visa-fournisseur, root.date-livraison, root.date-reception));
        } else {
            root.retour = Alerte.relayer(FacturesApi.supprimer());
        }
        root.recharger-si-besoin();
        // Validée ou annulée, la fiche n'est plus modifiable : les champs
        // de saisie des produits disparaissent, peut-être avec le focus.
        FacturesApi.demande-focus += 1;
    }

    function charger(f: FicheFactureUi) {
        root.version-chargee = FacturesApi.version-fiche;
        root.fiche = f;
        root.confirmation = 0;
        root.retour-ouverture = { };
        root.creation-client = false;
        root.filtre-client = "";
        date.valeur = f.date;
        root.date-precedente = f.date;
        root.echeance-texte = f.echeance;
        libelle.valeur = f.libelle;
        observations.valeur = f.observations;
        client.current-index = f.client-index;
        root.remise-index = f.remise-index;
        root.tva-index = f.tva-index;
        root.retenue-index = f.retenue-index;
        root.mode-index = f.mode-index;
        root.visa-client = f.visa-client;
        root.visa-fournisseur = f.visa-fournisseur;
        root.date-livraison = f.date-livraison;
        root.date-reception = f.date-reception;
        root.reglement-date = f.reglement-date;
        root.reglement-montant = f.reglement-montant;
        root.reglement-mode = f.reglement-mode-index;
        root.reglement-reference = "";
        root.reglement-a-supprimer = 0;
    }

    function saisie() -> FicheFactureUi {
        {
            existe: root.fiche.existe,
            date: date.valeur,
            echeance: root.echeance-texte,
            libelle: libelle.valeur,
            observations: observations.valeur,
            client-index: client.current-index,
            remise-index: root.remise-index,
            tva-index: root.tva-index,
            retenue-index: root.retenue-index,
            mode-index: root.mode-index,
            visa-client: root.visa-client,
            visa-fournisseur: root.visa-fournisseur,
            date-livraison: root.date-livraison,
            date-reception: root.date-reception,
        }
    }

    function recharger-si-besoin() {
        if (FacturesApi.fiche-ouverte && FacturesApi.version-fiche != root.version-chargee) {
            root.charger(FacturesApi.fiche-courante());
        }
    }

    function recalculer() {
        FacturesApi.recalculer(root.remise-index, root.tva-index, root.retenue-index);
    }

    // Enregistrement d'un document validé : mode et observations, ou, pour un
    // bordereau, visas, dates et observations.
    function enregistrer-administratif() {
        root.confirmation = 0;
        if (FacturesApi.avec-montants) {
            root.retour = Alerte.relayer(FacturesApi.enregistrer-administratif(root.mode-index, observations.valeur));
        } else {
            root.retour = Alerte.relayer(FacturesApi.enregistrer-livraison(root.visa-client, root.visa-fournisseur, root.date-livraison, root.date-reception, observations.valeur));
        }
        root.recharger-si-besoin();
    }

    // Ctrl+S : comme le bouton d'enregistrement affiché (brouillon, ou mode et
    // observations d'un document validé).
    property <int> demande-enregistrer: FacturesApi.demande-enregistrer;
    changed demande-enregistrer => {
        if (root.fiche.modifiable) {
            root.confirmation = 0;
            root.retour = Alerte.relayer(FacturesApi.enregistrer(root.saisie()));
            root.recharger-si-besoin();
        } else if (root.fiche.admin-modifiable) {
            root.enregistrer-administratif();
        }
    }

    // Ctrl+P : comme le bouton PDF, une fois le document enregistré.
    property <int> demande-pdf: FacturesApi.demande-pdf;
    changed demande-pdf => {
        if (root.fiche.existe && FacturesApi.avec-pdf) {
            root.confirmation = 0;
            root.retour = FacturesApi.exporter-pdf();
        }
    }

    init => {
        root.charger(FacturesApi.fiche-courante());
        root.retour-ouverture = FacturesApi.message-ouverture;
        FacturesApi.message-ouverture = { };
    }

    VerticalLayout {
        width: root.visible-width;
        padding: 24px;
        spacing: 14px;
        alignment: start;

        Rangee {
            spacing: 12px;

            Bouton {
                text: @tr("Retour au registre");
                clicked => {
                    FacturesApi.fermer-fiche();
                }
            }

            Titre {
                text: root.fiche.titre;
                vertical-alignment: center;
            }

            Rectangle { }
        }

        // Bandeau : statut et état de paiement.
        Rectangle {
            height: 36px;
            border-radius: 4px;
            background: root.fiche.annule ? #fdecea : (root.fiche.brouillon ? #fff4e5 : Theme.accent-survol);

            Rangee {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 24px;

                Text {
                    horizontal-alignment: Theme.debut;
                    text: @tr("Statut : {}", root.fiche.statut);
                    font-weight: 700;
                    color: Theme.texte;
                    vertical-alignment: center;
                }

                if root.fiche.paiement != "": Text {
                    horizontal-alignment: Theme.debut;
                    text: @tr("Paiement : {}", root.fiche.paiement);
                    color: Theme.texte;
                    vertical-alignment: center;
                }

                if root.fiche.montant-du != "": Text {
                    horizontal-alignment: Theme.debut;
                    text: @tr("Montant dû après avoirs : {} FCFA", root.fiche.montant-du);
                    color: Theme.texte;
                    vertical-alignment: center;
                }

                Rectangle { }

                if root.fiche.en-preparation: Text {
                    horizontal-alignment: Theme.debut;
                    text: @tr("Facture en préparation");
                    color: Theme.texte-secondaire;
                    vertical-alignment: center;
                }

                if root.fiche.brouillon: Text {
                    horizontal-alignment: Theme.debut;
                    text: FacturesApi.textes.sans-numero;
                    color: Theme.texte-secondaire;
                    vertical-alignment: center;
                }
            }
        }

        if root.retour-ouverture.message != "": MessageRetour {
            retour: root.retour-ouverture;
        }

        // En-tête : client, dates, libellé.
        // Grille et non Rangee : le détail du client, à la ligne, y garde une hauteur stable.
        GridLayout {
            spacing: 16px;

            VerticalLayout {
                row: 0;
                col: Theme.rtl ? 2 : 0;
                spacing: 4px;
                horizontal-stretch: 2;

                Etiquette {
                    text: FacturesApi.textes.tiers;
                }

                Rangee {
                    spacing: 8px;

                    if root.fiche.client-modifiable: recherche-client := LineEdit {
                        width: 160px;
                        text <=> root.filtre-client;
                        placeholder-text: FacturesApi.textes.filtrer-tiers;
                        edited(texte) => {
                            client.current-index = FacturesApi.filtrer-clients(texte, client.current-index);
                            root.fiche.tiers-detail = FacturesApi.client-choisi(client.current-index);
                        }
                    }

                    client := ComboBox {
                        model: FacturesApi.clients;
                        enabled: root.fiche.client-modifiable;
                        selected => {
                            root.fiche.tiers-detail = FacturesApi.client-choisi(self.current-index);
                        }
                    }

                    if root.fiche.client-modifiable && Droits.ajouter-referentiel && !root.creation-client: Bouton {
                        text: FacturesApi.textes.nouveau-tiers;
                        clicked => {
                            root.retour-client = { };
                            root.creation-client = true;
                        }
                    }
                }

                Text {
                    horizontal-alignment: Theme.debut;
                    text: root.fiche.tiers-detail;
                    font-size: 12px;
                    color: Theme.texte-secondaire;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                row: 0;
                col: 1;
                horizontal-stretch: 1;
                alignment: start;

                date := Champ {
                    libelle: @tr("Date (JJ/MM/AAAA)");
                    lecture-seule: !Ecriture.permise || !root.fiche.modifiable;
                    modifie(texte) => {
                        root.echeance-texte = FacturesApi.echeance-apres-date(root.date-precedente, texte, root.echeance-texte);
                        root.date-precedente = texte;
                    }
                }
            }

            if FacturesApi.avec-montants: VerticalLayout {
                row: 0;
                col: Theme.rtl ? 0 : 2;
                horizontal-stretch: 1;
                alignment: start;

                Champ {
                    libelle: FacturesApi.textes.libelle-echeance;
                    lecture-seule: !Ecriture.permise || !root.fiche.modifiable;
                    valeur <=> root.echeance-texte;
                }
            }
        }

        // Création rapide d'un client, sans quitter la fiche.
        if root.creation-client: Rectangle {
            border-width: 1px;
            border-color: Theme.bordure;
            border-radius: 4px;

            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                Section {
                    text: FacturesApi.textes.nouveau-tiers;
                }

                Rangee {
                    spacing: 12px;

                    nom-client := Champ {
                        libelle: @tr("Nom (obligatoire)");
                        horizontal-stretch: 2;
                    }

                    telephone-client := Champ {
                        libelle: @tr("Téléphone");
                        horizontal-stretch: 1;
                    }
                }

                Rangee {
                    spacing: 12px;

                    adresse-client := Champ {
                        libelle: @tr("Adresse");
                        horizontal-stretch: 2;
                    }

                    ifu-client := Champ {
                        libelle: @tr("IFU");
                        horizontal-stretch: 1;
                    }

                    rccm-client := Champ {
                        libelle: @tr("RCCM");
                        horizontal-stretch: 1;
                    }
                }

                Rangee {
                    spacing: 8px;
                    alignment: start;

                    Bouton {
                        text: FacturesApi.textes.creer-tiers;
                        primary: true;
                        enabled: nom-client.valeur != "";
                        clicked => {
                            root.retour-client = FacturesApi.creer-client(nom-client.valeur, telephone-client.valeur, adresse-client.valeur, ifu-client.valeur, rccm-client.valeur);
                            if (root.retour-client.ok) {
                                root.filtre-client = "";
                                client.current-index = FacturesApi.rang-nouveau-client;
                                root.fiche.tiers-detail = FacturesApi.client-choisi(client.current-index);
                                root.retour = Alerte.relayer(root.retour-client);
                                root.creation-client = false;
                                FacturesApi.demande-focus += 1;
                            }
                        }
                    }

                    Bouton {
                        text: @tr("Revenir");
                        clicked => {
                            root.creation-client = false;
                            FacturesApi.demande-focus += 1;
                        }
                    }
                }

                if !root.retour-client.ok && root.retour-client.message != "": MessageRetour {
                    retour: root.retour-client;
                }

                Text {
                    horizontal-alignment: Theme.debut;
                    text: FacturesApi.textes.note-tiers;
                    font-size: 12px;
                    color: Theme.texte-secondaire;
                    wrap: word-wrap;
                }
            }
        }

        libelle := Champ {
            libelle: @tr("Libellé");
            lecture-seule: !Ecriture.permise || !root.fiche.modifiable;
        }

        if !FacturesApi.avec-montants: Rangee {
            spacing: 12px;

            Champ {
                libelle: @tr("Visa du client");
                horizontal-stretch: 1;
                lecture-seule: !root.fiche.visas-modifiables;
                valeur <=> root.visa-client;
            }

            Champ {
                libelle: @tr("Visa du fournisseur");
                horizontal-stretch: 1;
                lecture-seule: !root.fiche.visas-modifiables;
                valeur <=> root.visa-fournisseur;
            }

            Champ {
                libelle: @tr("Date de livraison");
                horizontal-stretch: 1;
                lecture-seule: !root.fiche.visas-modifiables;
                valeur <=> root.date-livraison;
            }

            Champ {
                libelle: @tr("Date de réception");
                horizontal-stretch: 1;
                lecture-seule: !root.fiche.visas-modifiables;
                valeur <=> root.date-reception;
            }
        }

        // Lignes.
        Section {
            text: @tr("Lignes");
        }

        if FacturesApi.avec-montants: VerticalLayout {
        spacing: 14px;

        Rangee {
            spacing: 8px;

            Etiquette {
                text: @tr("Référence");
                width: 120px;
            }

            Etiquette {
                text: @tr("Désignation");
                horizontal-stretch: 1;
            }

            Etiquette {
                text: @tr("Prix unitaire");
                width: 110px;
            }

            Etiquette {
                text: @tr("Quantité");
                width: 80px;
            }

            Etiquette {
                text: @tr("Total");
                width: 110px;
                horizontal-alignment: Theme.fin;
            }

            if root.fiche.avec-reception: Etiquette {
                text: @tr("Reçue");
                width: 80px;
                horizontal-alignment: Theme.fin;
            }

            if Ecriture.permise && root.fiche.modifiable: Rectangle {
                width: 124px;
            }
        }

        for ligne[i] in FacturesApi.lignes: Rangee {
            spacing: 8px;

            LineEdit {
                width: 120px;
                text <=> ligne.reference;
                read-only: !Ecriture.permise || !root.fiche.modifiable;
                accepted => {
                    FacturesApi.reference-saisie(i);
                    root.recalculer();
                }
            }

            LineEdit {
                horizontal-stretch: 1;
                text <=> ligne.designation;
                read-only: !Ecriture.permise || !root.fiche.modifiable;
            }

            LineEdit {
                width: 110px;
                text <=> ligne.prix;
                read-only: !Ecriture.permise || !root.fiche.modifiable;
                horizontal-alignment: Theme.fin;
                edited => {
                    root.recalculer();
                }
            }

            LineEdit {
                width: 80px;
                text <=> ligne.quantite;
                read-only: !Ecriture.permise || !root.fiche.modifiable;
                horizontal-alignment: Theme.fin;
                edited => {
                    root.recalculer();
                }
            }

            Text {
                width: 110px;
                text: ligne.total;
                horizontal-alignment: Theme.fin;
                vertical-alignment: center;
                color: Theme.texte;
            }

            if root.fiche.avec-reception: LineEdit {
                width: 80px;
                text <=> ligne.recue;
                read-only: !root.fiche.reception-modifiable;
                horizontal-alignment: Theme.fin;
            }

            if Ecriture.permise && root.fiche.modifiable: PetitBouton {
                text: "↑";
                enabled: i > 0;
                clicked => {
                    FacturesApi.deplacer-ligne(i, -1);
                }
            }

            if Ecriture.permise && root.fiche.modifiable: PetitBouton {
                text: "↓";
                enabled: i < FacturesApi.lignes.length - 1;
                clicked => {
                    FacturesApi.deplacer-ligne(i, 1);
                }
            }

            if Ecriture.permise && root.fiche.modifiable: PetitBouton {
                text: "×";
                // Les totaux sont recalculés par l'application : cette ligne,
                // et donc ce gestionnaire, disparaît avec la suppression.
                clicked => {
                    // Le champ qui avait le focus peut disparaître avec la ligne.
                    FacturesApi.demande-focus += 1;
                    FacturesApi.supprimer-ligne(i);
                }
            }
        }
        }

        // Bordereau : quantités commandée, livrée et reste à livrer, observation par ligne.
        if !FacturesApi.avec-montants: VerticalLayout {
            spacing: 14px;

            Rangee {
                spacing: 8px;

                Etiquette {
                    text: @tr("Référence");
                    width: 120px;
                }

                Etiquette {
                    text: @tr("Désignation");
                    horizontal-stretch: 1;
                }

                Etiquette {
                    text: @tr("Commandée");
                    width: 80px;
                    horizontal-alignment: Theme.fin;
                }

                Etiquette {
                    text: @tr("Livrée");
                    width: 80px;
                    horizontal-alignment: Theme.fin;
                }

                if root.fiche.avec-reste: Etiquette {
                    text: @tr("Reste à livrer");
                    width: 100px;
                    horizontal-alignment: Theme.fin;
                }

                Etiquette {
                    text: @tr("Observations");
                    width: 180px;
                }

                if Ecriture.permise && root.fiche.modifiable && !root.fiche.lignes-verrouillees: Rectangle {
                    width: 124px;
                }
            }

            for ligne[i] in FacturesApi.lignes: Rangee {
                spacing: 8px;

                LineEdit {
                    width: 120px;
                    text <=> ligne.reference;
                    read-only: !Ecriture.permise || !root.fiche.modifiable || root.fiche.lignes-verrouillees;
                    accepted => {
                        FacturesApi.reference-saisie(i);
                    }
                }

                LineEdit {
                    horizontal-stretch: 1;
                    text <=> ligne.designation;
                    read-only: !Ecriture.permise || !root.fiche.modifiable || root.fiche.lignes-verrouillees;
                }

                LineEdit {
                    width: 80px;
                    text <=> ligne.quantite;
                    read-only: !Ecriture.permise || !root.fiche.modifiable || root.fiche.lignes-verrouillees;
                    horizontal-alignment: Theme.fin;
                }

                LineEdit {
                    width: 80px;
                    text <=> ligne.recue;
                    read-only: !Ecriture.permise || !root.fiche.modifiable;
                    horizontal-alignment: Theme.fin;
                }

                if root.fiche.avec-reste: Text {
                    width: 100px;
                    text: ligne.reste;
                    horizontal-alignment: Theme.fin;
                    vertical-alignment: center;
                    color: Theme.texte;
                }

                LineEdit {
                    width: 180px;
                    text <=> ligne.observations;
                    read-only: !Ecriture.permise || !root.fiche.modifiable;
                }

                if Ecriture.permise && root.fiche.modifiable && !root.fiche.lignes-verrouillees: PetitBouton {
                    text: "↑";
                    enabled: i > 0;
                    clicked => {
                        FacturesApi.deplacer-ligne(i, -1);
                    }
                }

                if Ecriture.permise && root.fiche.modifiable && !root.fiche.lignes-verrouillees: PetitBouton {
                    text: "↓";
                    enabled: i < FacturesApi.lignes.length - 1;
                    clicked => {
                        FacturesApi.deplacer-ligne(i, 1);
                    }
                }

                if Ecriture.permise && root.fiche.modifiable && !root.fiche.lignes-verrouillees: PetitBouton {
                    text: "×";
                    clicked => {
                        FacturesApi.demande-focus += 1;
                        FacturesApi.supprimer-ligne(i);
                    }
                }
            }
        }

        if FacturesApi.lignes.length == 0: Text {
            horizontal-alignment: Theme.debut;
            text: @tr("Aucune ligne.");
            color: Theme.texte-secondaire;
        }

        // Texte à la ligne sous le bouton : dans une rangée, son retour à la ligne
        // ferait dépendre la hauteur de la largeur (boucle de mise en page).
        if root.fiche.reception-modifiable: VerticalLayout {
            spacing: 6px;

            Rangee {
                alignment: start;

                Bouton {
                    text: @tr("Enregistrer la réception");
                    primary: true;
                    clicked => {
                        root.confirmation = 0;
                        root.retour = Alerte.relayer(FacturesApi.enregistrer-reception());
                        root.recharger-si-besoin();
                    }
                }
            }

            Text {
                horizontal-alignment: Theme.debut;
                text: @tr("Saisir pour chaque ligne la quantité reçue depuis la commande, livraisons précédentes comprises. Une réception complète est définitive.");
                font-size: 12px;
                color: Theme.texte-secondaire;
                wrap: word-wrap;
            }
        }

        if Ecriture.permise && root.fiche.modifiable && !root.fiche.lignes-verrouillees: Rangee {
            spacing: 8px;

            recherche-produit := LineEdit {
                width: 200px;
                placeholder-text: @tr("Filtrer les produits");
                edited(texte) => {
                    FacturesApi.filtrer-produits(texte);
                    produit.current-index = 0;
                }
            }

            produit := ComboBox {
                horizontal-stretch: 1;
                model: FacturesApi.produits;
            }

            Bouton {
                text: @tr("Ajouter le produit");
                enabled: FacturesApi.produits.length > 0;
                clicked => {
                    FacturesApi.ajouter-produit(produit.current-index);
                    root.recalculer();
                }
            }

            Bouton {
                text: @tr("Ligne libre");
                clicked => {
                    FacturesApi.ajouter-ligne-libre();
                }
            }
        }

        if Ecriture.permise && root.fiche.modifiable && FacturesApi.avec-montants: Text {
            horizontal-alignment: Theme.debut;
            text: @tr("Le produit choisi remplit la référence, la désignation et le prix, qui restent modifiables sur la ligne. Une référence tapée puis validée par Entrée reprend le produit correspondant.");
            font-size: 12px;
            color: Theme.texte-secondaire;
            wrap: word-wrap;
        }

        // Taux, paiement et totaux.
        // Grille et non Rangee : le montant en lettres, à la ligne, y garde une hauteur stable.
        GridLayout {
            spacing: 24px;

            VerticalLayout {
                row: 0;
                col: Theme.rtl && FacturesApi.avec-montants ? 1 : 0;
                spacing: 10px;
                // Trois listes de taux (remise, TVA, retenue) pour un bon de commande ;
                // un bordereau n'a que ses observations, sur toute la largeur.
                min-width: !FacturesApi.avec-montants ? 0px : (FacturesApi.avec-retenue ? 510px : 340px);
                max-width: !FacturesApi.avec-montants ? 100000px : (FacturesApi.avec-retenue ? 510px : 340px);
                horizontal-stretch: FacturesApi.avec-montants ? 0 : 1;

                if FacturesApi.avec-montants: Rangee {
                    spacing: 12px;

                    VerticalLayout {
                        spacing: 4px;

                        Etiquette {
                            text: @tr("Remise");
                        }

                        ComboBox {
                            model: FacturesApi.taux-remise;
                            enabled: root.fiche.taux-modifiables;
                            current-index <=> root.remise-index;
                            selected => {
                                root.recalculer();
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;

                        Etiquette {
                            text: @tr("TVA");
                        }

                        ComboBox {
                            model: FacturesApi.taux-tva;
                            enabled: root.fiche.taux-modifiables;
                            current-index <=> root.tva-index;
                            selected => {
                                root.recalculer();
                            }
                        }
                    }

                    if FacturesApi.avec-retenue: VerticalLayout {
                        spacing: 4px;

                        Etiquette {
                            text: @tr("Retenue");
                        }

                        ComboBox {
                            model: FacturesApi.taux-retenue;
                            enabled: root.fiche.taux-modifiables;
                            current-index <=> root.retenue-index;
                            selected => {
                                root.recalculer();
                            }
                        }
                    }
                }

                if FacturesApi.avec-montants: VerticalLayout {
                    spacing: 4px;

                    Etiquette {
                        text: @tr("Mode de paiement");
                    }

                    ComboBox {
                        model: FacturesApi.modes-paiement;
                        enabled: root.fiche.modifiable || root.fiche.admin-modifiable;
                        current-index <=> root.mode-index;
                    }
                }

                observations := Champ {
                    libelle: @tr("Observations");
                    lecture-seule: !(root.fiche.modifiable || root.fiche.admin-modifiable);
                }
            }

            if FacturesApi.avec-montants: VerticalLayout {
                row: 0;
                col: Theme.rtl ? 0 : 1;
                spacing: 6px;
                horizontal-stretch: 1;

                LigneTotal {
                    libelle: @tr("Montant HT");
                    valeur: FacturesApi.totaux.ht;
                }

                LigneTotal {
                    libelle: @tr("Remise");
                    valeur: FacturesApi.totaux.remise;
                }

                LigneTotal {
                    libelle: @tr("Base TVA");
                    valeur: FacturesApi.totaux.base-tva;
                }

                LigneTotal {
                    libelle: @tr("TVA");
                    valeur: FacturesApi.totaux.tva;
                }

                if FacturesApi.avec-retenue: LigneTotal {
                    libelle: @tr("Retenue");
                    valeur: FacturesApi.totaux.retenue;
                }

                LigneTotal {
                    libelle: @tr("Montant TTC");
                    valeur: FacturesApi.totaux.ttc;
                    fort: true;
                }

                Text {
                    text: FacturesApi.totaux.lettres;
                    horizontal-alignment: Theme.fin;
                    color: Theme.texte-secondaire;
                    wrap: word-wrap;
                }
            }
        }

        // Actions selon le statut.
        Rangee {
            spacing: 8px;
            alignment: start;

            if Ecriture.permise && root.fiche.modifiable: Bouton {
                text: @tr("Enregistrer le brouillon");
                primary: !root.fiche.peut-valider;
                clicked => {
                    root.confirmation = 0;
                    root.retour = Alerte.relayer(FacturesApi.enregistrer(root.saisie()));
                    root.recharger-si-besoin();
                }
            }

            // Serveur injoignable : visible mais inactif, la raison est dans
            // la note de la fiche (décision 9).
            if Ecriture.permise && root.fiche.peut-valider: Bouton {
                text: @tr("Valider");
                primary: true;
                enabled: Ecriture.validation;
                clicked => {
                    root.retour = { };
                    root.confirmation = 1;
                }
            }

            // Section 4 : la validation demandée hors connexion attend le
            // serveur, qui attribue le numéro.
            if Ecriture.permise && root.fiche.peut-valider && !Ecriture.validation && !root.fiche.a-valider: Bouton {
                text: @tr("Valider au retour");
                clicked => {
                    root.confirmation = 0;
                    root.retour = Alerte.relayer(FacturesApi.valider-au-retour(root.saisie()));
                    root.recharger-si-besoin();
                }
            }

            if Ecriture.permise && root.fiche.admin-modifiable: Bouton {
                text: root.fiche.libelle-administratif;
                clicked => {
                    root.enregistrer-administratif();
                }
            }

            if Ecriture.permise && root.fiche.peut-confirmer-livraison: Bouton {
                text: @tr("Confirmer la livraison");
                primary: true;
                clicked => {
                    root.retour = { };
                    root.confirmation = 5;
                }
            }

            if Ecriture.permise && root.fiche.peut-envoyer: Bouton {
                text: FacturesApi.textes.marquer-envoye;
                clicked => {
                    root.confirmation = 0;
                    root.retour = Alerte.relayer(FacturesApi.marquer-envoye());
                    root.recharger-si-besoin();
                }
            }

            if Ecriture.permise && root.fiche.peut-annuler: Bouton {
                text: FacturesApi.textes.annuler;
                clicked => {
                    root.retour = { };
                    root.confirmation = 2;
                }
            }

            if root.fiche.existe && FacturesApi.avec-pdf: Bouton {
                text: root.fiche.brouillon ? @tr("Aperçu PDF") : @tr("Exporter en PDF");
                clicked => {
                    root.confirmation = 0;
                    root.retour = FacturesApi.exporter-pdf();
                }
            }

            if root.fiche.existe: Bouton {
                text: @tr("Exporter en Excel");
                clicked => {
                    root.confirmation = 0;
                    root.retour = FacturesApi.exporter-excel();
                }
            }

            if Ecriture.permise && root.fiche.peut-supprimer: Bouton {
                text: @tr("Supprimer le brouillon");
                clicked => {
                    root.retour = { };
                    root.confirmation = 3;
                }
            }
        }

        // Documents qui naissent de celui-ci : chacun ouvre sa fiche une fois créé.
        if Ecriture.permise && (root.fiche.peut-convertir || root.fiche.peut-dupliquer || root.fiche.peut-corriger || root.fiche.peut-creer-avoir || root.fiche.peut-creer-bordereau): Rangee {
            spacing: 8px;
            alignment: start;

            if Ecriture.permise && root.fiche.peut-convertir: Bouton {
                text: @tr("Convertir en facture");
                clicked => {
                    root.confirmation = 0;
                    root.retour = Alerte.relayer(FacturesApi.convertir());
                    root.recharger-si-besoin();
                }
            }

            if Ecriture.permise && root.fiche.peut-creer-bordereau: Bouton {
                text: @tr("Créer un bordereau");
                enabled: root.fiche.bordereau-possible;
                clicked => {
                    root.confirmation = 0;
                    root.retour = Alerte.relayer(FacturesApi.creer-bordereau());
                    root.recharger-si-besoin();
                }
            }

            if Ecriture.permise && root.fiche.peut-creer-avoir: Bouton {
                text: @tr("Créer un avoir");
                enabled: root.fiche.avoir-possible;
                clicked => {
                    root.confirmation = 0;
                    root.retour = Alerte.relayer(FacturesApi.creer-avoir());
                    root.recharger-si-besoin();
                }
            }

            if Ecriture.permise && root.fiche.peut-dupliquer: Bouton {
                text: @tr("Dupliquer");
                clicked => {
                    root.confirmation = 0;
                    // Un brouillon est d'abord enregistré : la copie reprend la saisie affichée.
                    if (root.fiche.modifiable) {
                        root.retour = Alerte.relayer(FacturesApi.enregistrer(root.saisie()));
                        root.recharger-si-besoin();
                    }
                    if (!root.fiche.modifiable || root.retour.ok) {
                        root.retour = Alerte.relayer(FacturesApi.dupliquer(false));
                        root.recharger-si-besoin();
                    }
                }
            }

            if Ecriture.permise && root.fiche.peut-corriger: Bouton {
                text: @tr("Corriger");
                clicked => {
                    root.retour = { };
                    root.confirmation = 4;
                }
            }
        }

        if root.retour.message != "": MessageRetour {
            retour: root.retour;
        }

        if root.fiche.note != "": Text {
            horizontal-alignment: Theme.debut;
            text: root.fiche.note;
            color: Theme.texte-secondaire;
            wrap: word-wrap;
        }

        // Règlements : situation, liste, suppression confirmée sur place, saisie.
        if root.fiche.avec-reglements: Section {
            text: @tr("Règlements");
        }

        if root.fiche.avec-reglements: Rangee {
            alignment: start;
            spacing: 32px;

            Text {
                text: @tr("Montant dû : {} FCFA", root.fiche.du-reglements);
                color: Theme.texte;
            }

            Text {
                text: @tr("Réglé : {} FCFA", root.fiche.regle);
                color: Theme.texte;
            }

            Text {
                text: @tr("Reste à payer : {} FCFA", root.fiche.reste-a-payer);
                color: Theme.texte;
                font-weight: 700;
            }
        }

        if root.fiche.avec-reglements && FacturesApi.reglements.length > 0: Rangee {
            spacing: 12px;

            Etiquette {
                text: @tr("Date");
                width: 90px;
            }

            Etiquette {
                text: @tr("Montant");
                width: 110px;
                horizontal-alignment: Theme.fin;
            }

            Etiquette {
                text: @tr("Mode de paiement");
                width: 150px;
            }

            Etiquette {
                text: @tr("Référence");
                horizontal-stretch: 1;
            }

            Etiquette {
                text: @tr("Saisi par");
                width: 160px;
            }

            if Ecriture.permise && root.fiche.peut-saisir-reglement: Rectangle {
                width: 110px;
            }
        }

        if root.fiche.avec-reglements && FacturesApi.reglements.length > 0: VerticalLayout {
            spacing: 6px;

            for reglement in FacturesApi.reglements: Rangee {
                spacing: 12px;

                Text {
                    horizontal-alignment: Theme.debut;
                    vertical-alignment: center;
                    width: 90px;
                    text: reglement.date;
                    color: Theme.texte;
                }

                Text {
                    horizontal-alignment: Theme.fin;
                    vertical-alignment: center;
                    width: 110px;
                    text: reglement.montant;
                    color: Theme.texte;
                }

                Text {
                    horizontal-alignment: Theme.debut;
                    vertical-alignment: center;
                    width: 150px;
                    text: reglement.mode;
                    color: Theme.texte;
                }

                Text {
                    horizontal-alignment: Theme.debut;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    text: reglement.reference;
                    color: Theme.texte;
                }

                Text {
                    horizontal-alignment: Theme.debut;
                    vertical-alignment: center;
                    width: 160px;
                    text: reglement.auteur;
                    color: Theme.texte-secondaire;
                }

                if Ecriture.permise && root.fiche.peut-saisir-reglement: Bouton {
                    width: 110px;
                    text: @tr("Supprimer");
                    clicked => {
                        root.retour-reglement = { };
                        root.reglement-a-supprimer = reglement.id;
                    }
                }
            }
        }

        if Ecriture.permise && root.fiche.peut-saisir-reglement && root.fiche.reglement-montant != "": Rangee {
            spacing: 12px;

            Champ {
                libelle: @tr("Date du règlement (JJ/MM/AAAA)");
                width: 220px;
                valeur <=> root.reglement-date;
            }

            Champ {
                libelle: @tr("Montant (FCFA)");
                width: 150px;
                valeur <=> root.reglement-montant;
            }

            VerticalLayout {
                spacing: 4px;
                width: 190px;
                alignment: start;

                Etiquette {
                    text: @tr("Mode de paiement");
                }

                ComboBox {
                    model: FacturesApi.modes-reglement;
                    current-index <=> root.reglement-mode;
                }
            }

            Champ {
                libelle: @tr("Référence (facultative)");
                horizontal-stretch: 1;
                valeur <=> root.reglement-reference;
            }
        }

        if Ecriture.permise && root.fiche.peut-saisir-reglement && root.fiche.reglement-montant != "": Rangee {
            alignment: start;

            Bouton {
                text: @tr("Enregistrer le règlement");
                primary: true;
                clicked => {
                    root.reglement-a-supprimer = 0;
                    root.retour-reglement = Alerte.relayer(FacturesApi.ajouter-reglement(root.reglement-date, root.reglement-montant, root.reglement-mode, root.reglement-reference));
                    root.recharger-si-besoin();
                }
            }
        }

        if root.retour-reglement.message != "": MessageRetour {
            retour: root.retour-reglement;
        }

        // Documents liés : origine, puis documents issus de celui-ci.
        if FacturesApi.liens.length > 0: Section {
            text: @tr("Documents liés");
        }

        for lien in FacturesApi.liens: Rangee {
            alignment: start;

            Bouton {
                text: lien.texte;
                clicked => {
                    root.confirmation = 0;
                    root.retour = FacturesApi.ouvrir-lien(lien.id);
                    root.recharger-si-besoin();
                }
            }
        }

        // Historique des changements de statut.
        if FacturesApi.historique.length > 0: Section {
            text: @tr("Historique");
        }

        for evenement in FacturesApi.historique: Rangee {
            spacing: 12px;

            Text {
                horizontal-alignment: Theme.debut;
                text: evenement.date;
                width: 140px;
                color: Theme.texte-secondaire;
            }

            Text {
                horizontal-alignment: Theme.debut;
                text: evenement.libelle;
                horizontal-stretch: 1;
                color: Theme.texte;
            }

            Text {
                horizontal-alignment: Theme.debut;
                text: evenement.utilisateur;
                width: 200px;
                color: Theme.texte-secondaire;
            }
        }
    }
}

export component PageFactures inherits Rectangle {
    // Rang du type dans TypeDocument::TOUS (0 devis, 1 proforma, 4 facture, 5 avoir).
    in property <int> type-document;

    init => {
        FacturesApi.ouvrir(root.type-document);
        raccourcis.focus();
    }

    // Le registre et la fiche sont recréés à chaque bascule : l'élément qui avait
    // le focus disparaît, la page le reprend pour que les raccourcis restent actifs.
    property <bool> fiche-ouverte: FacturesApi.fiche-ouverte;
    changed fiche-ouverte => {
        raccourcis.focus();
    }

    property <int> demande-focus: FacturesApi.demande-focus;
    changed demande-focus => {
        raccourcis.focus();
    }

    // Raccourcis de la page : reçus ici quand l'élément qui a le focus (champ, liste,
    // tableau) ne les a pas pris pour lui.
    raccourcis := FocusScope {
        KeyBinding {
            keys: @keys(Control + N);
            activated => {
                if (FacturesApi.peut-creer && !FacturesApi.fiche-ouverte) {
                    FacturesApi.nouvelle();
                }
            }
        }

        KeyBinding {
            keys: @keys(Control + S);
            activated => {
                FacturesApi.demande-enregistrer += 1;
            }
        }

        KeyBinding {
            keys: @keys(Control + P);
            activated => {
                FacturesApi.demande-pdf += 1;
            }
        }

        KeyBinding {
            keys: @keys(Control + F);
            activated => {
                FacturesApi.demande-recherche += 1;
            }
        }

        if !FacturesApi.fiche-ouverte: Registre { }

        if FacturesApi.fiche-ouverte: Fiche { }
    }
}

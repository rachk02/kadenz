import { AboutSlint, ComboBox, ScrollView } from "std-widgets.slint";
import { Bouton, Champ, Droits, ElementNavigation, MessageErreur, Rangee, Section, Theme, Titre } from "composants.slint";
import { EcranAssistant, DonneesAssistant } from "assistant.slint";
import { EcranConnexion } from "connexion.slint";
import { PageProduits, PageTiers, ProduitsApi, TiersApi } from "referentiels.slint";
import { EntrepriseApi, PageEntreprise, PageParametres, ParametresApi } from "administration.slint";
import { PageUtilisateurs, UtilisateursApi } from "utilisateurs.slint";
import { ImportApi, PanneauImport } from "import.slint";
import { FacturesApi, PageFactures } from "factures.slint";
import { PageReglements, PageRelances, PageSuiviFournisseurs, PaiementsApi, TotalUi } from "paiements.slint";

export { DonneesAssistant, Droits, Theme, EntrepriseApi, FacturesApi, ImportApi, PaiementsApi, ParametresApi, ProduitsApi, TiersApi, UtilisateursApi }

// Écran courant, choisi par l'application au démarrage puis au fil des actions.
export enum Ecran { demarrage-impossible, assistant, connexion, application }

// Pages de l'application ; le menu n'affiche que celles que les droits du compte ouvrent.
export enum Page {
    tableau-de-bord,
    devis,
    proforma,
    bons-commande,
    livraisons,
    factures,
    avoirs,
    reglements,
    suivi-fournisseurs,
    relances,
    tiers,
    produits,
    entreprise,
    parametres,
    utilisateurs,
    mon-compte,
    a-propos,
}

component PageMonCompte inherits VerticalLayout {
    in property <string> utilisateur-nom;
    in property <string> utilisateur-identifiant;
    in property <string> utilisateur-role;

    // Rang de la langue du compte, dans l'ordre de Langue::TOUTES (domaine).
    in-out property <int> langue;

    // Renvoient un message d'erreur, ou une chaîne vide si le changement a réussi.
    callback changer-mot-de-passe(string, string, string) -> string;
    callback changer-langue(int) -> string;

    property <string> erreur-langue;

    property <string> ancien;
    property <string> nouveau;
    property <string> confirmation;
    property <string> erreur;
    property <bool> reussi;

    padding: 24px;
    spacing: 12px;

    Titre {
        text: @tr("Mon compte");
    }

    Text {
        horizontal-alignment: Theme.debut;
        text: @tr("{} ({}), rôle : {}", root.utilisateur-nom, root.utilisateur-identifiant, root.utilisateur-role);
        color: Theme.texte-secondaire;
    }

    Text {
        horizontal-alignment: Theme.debut;
        text: @tr("Langue de l'interface");
        font-weight: 700;
        color: Theme.texte;
    }

    Rangee {
        alignment: start;

        // Chaque langue est écrite dans sa propre langue, pour être reconnue
        // quelle que soit celle de l'interface.
        ComboBox {
            width: 220px;
            model: ["Français", "English", "العربية", "日本語", "中文", "Türkçe", "Español"];
            current-index <=> root.langue;
            selected => {
                root.erreur-langue = root.changer-langue(self.current-index);
            }
        }
    }

    if root.erreur-langue != "": MessageErreur {
        text: root.erreur-langue;
    }

    Text {
        horizontal-alignment: Theme.debut;
        text: @tr("Changer de mot de passe");
        font-weight: 700;
        color: Theme.texte;
    }

    Rangee {
        alignment: start;

        VerticalLayout {
            width: 360px;
            spacing: 12px;

            Champ {
                libelle: @tr("Mot de passe actuel");
                secret: true;
                valeur <=> root.ancien;
            }

            Champ {
                libelle: @tr("Nouveau mot de passe (8 caractères au moins)");
                secret: true;
                valeur <=> root.nouveau;
            }

            Champ {
                libelle: @tr("Confirmation du nouveau mot de passe");
                secret: true;
                valeur <=> root.confirmation;
            }

            if root.erreur != "": MessageErreur {
                text: root.erreur;
            }

            if root.reussi: Text {
                horizontal-alignment: Theme.debut;
                text: @tr("Mot de passe modifié.");
                color: Theme.succes;
            }

            Bouton {
                text: @tr("Enregistrer");
                primary: true;
                clicked => {
                    root.erreur = root.changer-mot-de-passe(root.ancien, root.nouveau, root.confirmation);
                    root.reussi = root.erreur == "";
                    if (root.reussi) {
                        root.ancien = "";
                        root.nouveau = "";
                        root.confirmation = "";
                    }
                }
            }
        }
    }

    Rectangle { }
}

export component FenetrePrincipale inherits Window {
    in-out property <Ecran> ecran: Ecran.demarrage-impossible;
    in property <string> message-demarrage;
    in property <string> etat-base;
    in property <string> nom-entreprise;
    in property <string> version-logiciel;
    in property <string> utilisateur-nom;
    in property <string> utilisateur-identifiant;
    in property <string> utilisateur-role;
    in-out property <int> utilisateur-langue;

    in property <string> defaut-taux-tva;
    in property <string> defaut-taux-remise;
    in property <string> defaut-taux-retenue;
    in property <string> defaut-modes-paiement;

    callback terminer-assistant(DonneesAssistant) -> string;
    callback connecter(string, string) -> string;
    callback deconnecter();
    callback changer-mot-de-passe(string, string, string) -> string;
    callback changer-langue(int) -> string;

    // Construit par l'application à chaque connexion. « À propos » y figure toujours :
    // il porte l'attribution exigée par la licence Slint Royalty-free 2.0 (cahier, section 14).
    in property <[Page]> menu;
    in-out property <Page> page: Page.tableau-de-bord;

    property <bool> page-en-construction: root.page != Page.devis && root.page != Page.proforma && root.page != Page.bons-commande && root.page != Page.livraisons && root.page != Page.factures && root.page != Page.avoirs && root.page != Page.reglements && root.page != Page.suivi-fournisseurs && root.page != Page.relances && root.page != Page.tiers && root.page != Page.produits && root.page != Page.entreprise && root.page != Page.parametres && root.page != Page.utilisateurs && root.page != Page.mon-compte && root.page != Page.a-propos;

    // Libellé de chaque page, dans la langue choisie : calculé ici et non stocké,
    // pour suivre un changement de langue sans reconstruire le menu.
    pure function libelle-page(p: Page) -> string {
        if (p == Page.tableau-de-bord) { return @tr("Tableau de bord"); }
        if (p == Page.devis) { return @tr("Devis"); }
        if (p == Page.proforma) { return @tr("Proforma"); }
        if (p == Page.bons-commande) { return @tr("Bons de commande"); }
        if (p == Page.livraisons) { return @tr("Livraisons"); }
        if (p == Page.factures) { return @tr("Factures"); }
        if (p == Page.avoirs) { return @tr("Avoirs"); }
        if (p == Page.reglements) { return @tr("Règlements"); }
        if (p == Page.suivi-fournisseurs) { return @tr("Suivi fournisseurs"); }
        if (p == Page.relances) { return @tr("Relances"); }
        if (p == Page.tiers) { return @tr("Tiers"); }
        if (p == Page.produits) { return @tr("Produits"); }
        if (p == Page.entreprise) { return @tr("Entreprise"); }
        if (p == Page.parametres) { return @tr("Paramètres"); }
        if (p == Page.utilisateurs) { return @tr("Utilisateurs"); }
        if (p == Page.mon-compte) { return @tr("Mon compte"); }
        return @tr("À propos");
    }

    // Icône Kadenz de chaque entrée du menu (ui/icones/menu).
    pure function icone-page(p: Page) -> image {
        if (p == Page.tableau-de-bord) { return @image-url("icones/menu/tableau-de-bord.svg"); }
        if (p == Page.devis) { return @image-url("icones/menu/devis.svg"); }
        if (p == Page.proforma) { return @image-url("icones/menu/proforma.svg"); }
        if (p == Page.bons-commande) { return @image-url("icones/menu/bons-commande.svg"); }
        if (p == Page.livraisons) { return @image-url("icones/menu/livraisons.svg"); }
        if (p == Page.factures) { return @image-url("icones/menu/factures.svg"); }
        if (p == Page.avoirs) { return @image-url("icones/menu/avoirs.svg"); }
        if (p == Page.reglements) { return @image-url("icones/menu/reglements.svg"); }
        if (p == Page.suivi-fournisseurs) { return @image-url("icones/menu/suivi-fournisseurs.svg"); }
        if (p == Page.relances) { return @image-url("icones/menu/relances.svg"); }
        if (p == Page.tiers) { return @image-url("icones/menu/tiers.svg"); }
        if (p == Page.produits) { return @image-url("icones/menu/produits.svg"); }
        if (p == Page.entreprise) { return @image-url("icones/menu/entreprise.svg"); }
        if (p == Page.parametres) { return @image-url("icones/menu/parametres.svg"); }
        if (p == Page.utilisateurs) { return @image-url("icones/menu/utilisateurs.svg"); }
        if (p == Page.mon-compte) { return @image-url("icones/menu/mon-compte.svg"); }
        return @image-url("icones/menu/a-propos.svg");
    }

    title: root.nom-entreprise == "" ? "Kadenz" : root.nom-entreprise;
    icon: @image-url("icones/kadenz-64.png");
    default-font-family: Theme.police-texte;
    preferred-width: 1200px;
    preferred-height: 760px;
    min-width: 900px;
    min-height: 640px;
    background: white;

    if root.ecran == Ecran.demarrage-impossible: VerticalLayout {
        alignment: center;
        padding: 24px;
        spacing: 12px;

        Titre {
            text: @tr("Démarrage impossible");
            horizontal-alignment: center;
        }

        MessageErreur {
            text: root.message-demarrage;
            horizontal-alignment: center;
        }
    }

    if root.ecran == Ecran.assistant: EcranAssistant {
        defaut-taux-tva: root.defaut-taux-tva;
        defaut-taux-remise: root.defaut-taux-remise;
        defaut-taux-retenue: root.defaut-taux-retenue;
        defaut-modes-paiement: root.defaut-modes-paiement;
        terminer(donnees) => {
            root.terminer-assistant(donnees)
        }
    }

    if root.ecran == Ecran.connexion: EcranConnexion {
        nom-entreprise: root.nom-entreprise;
        version-logiciel: root.version-logiciel;
        connecter(identifiant, mot-de-passe) => {
            root.connecter(identifiant, mot-de-passe)
        }
    }

    if root.ecran == Ecran.application: Rangee {
        remplit: true;
        Rectangle {
            width: 220px;
            background: Theme.fond-lateral;

            VerticalLayout {
                padding: 12px;
                spacing: 4px;

                Text {
                    horizontal-alignment: Theme.debut;
                    text: root.nom-entreprise;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.texte;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: 8px;
                }

                // Le menu défile quand la fenêtre est trop basse pour toutes ses entrées.
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: start;
                        spacing: 4px;

                        for element in root.menu: ElementNavigation {
                            libelle: root.libelle-page(element);
                            icone: root.icone-page(element);
                            actif: root.page == element;
                            clique => {
                                root.page = element;
                            }
                        }
                    }
                }

                Text {
                    horizontal-alignment: Theme.debut;
                    text: root.utilisateur-nom + " (" + root.utilisateur-role + ")";
                    font-size: 12px;
                    color: Theme.texte;
                    wrap: word-wrap;
                }

                Bouton {
                    text: @tr("Se déconnecter");
                    clicked => {
                        root.deconnecter();
                    }
                }

                Text {
                    horizontal-alignment: Theme.debut;
                    text: root.etat-base;
                    font-size: 11px;
                    color: Theme.texte-secondaire;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle {
            if root.page-en-construction: VerticalLayout {
                padding: 24px;
                spacing: 12px;

                Titre {
                    text: root.libelle-page(root.page);
                }

                Text {
                    horizontal-alignment: Theme.debut;
                    text: @tr("Module en cours de construction.");
                    color: Theme.texte-secondaire;
                }

                Rectangle { }
            }

            // Un écran commun pour les documents de vente ; le type est le rang dans
            // TypeDocument::TOUS (0 devis, 1 proforma, 4 facture, 5 avoir).
            if root.page == Page.devis: PageFactures {
                type-document: 0;
            }

            if root.page == Page.proforma: PageFactures {
                type-document: 1;
            }

            if root.page == Page.bons-commande: PageFactures {
                type-document: 2;
            }

            if root.page == Page.livraisons: PageFactures {
                type-document: 3;
            }

            if root.page == Page.reglements: PageReglements { }

            if root.page == Page.suivi-fournisseurs: PageSuiviFournisseurs { }

            if root.page == Page.relances: PageRelances { }

            if root.page == Page.factures: PageFactures {
                type-document: 4;
            }

            if root.page == Page.avoirs: PageFactures {
                type-document: 5;
            }

            if root.page == Page.tiers: PageTiers { }

            if root.page == Page.produits: PageProduits { }

            if root.page == Page.entreprise: PageEntreprise { }

            if root.page == Page.parametres: PageParametres { }

            if root.page == Page.utilisateurs: PageUtilisateurs { }

            // Recouvre l'écran Tiers ou Produits pendant un import.
            if ImportApi.actif: PanneauImport { }

            if root.page == Page.mon-compte: PageMonCompte {
                utilisateur-nom: root.utilisateur-nom;
                utilisateur-identifiant: root.utilisateur-identifiant;
                utilisateur-role: root.utilisateur-role;
                langue <=> root.utilisateur-langue;
                changer-mot-de-passe(ancien, nouveau, confirmation) => {
                    root.changer-mot-de-passe(ancien, nouveau, confirmation)
                }
                changer-langue(rang) => {
                    root.changer-langue(rang)
                }
            }

            if root.page == Page.a-propos: VerticalLayout {
                padding: 24px;
                spacing: 20px;

                Titre {
                    text: @tr("À propos");
                }

                // Bandeau de marque : logo, motif Cadence, rôle du logiciel.
                Rectangle {
                    height: 168px;
                    border-radius: 4px;
                    background: Theme.nuit;
                    clip: true;

                    Image {
                        x: Theme.rtl ? 0px : parent.width - self.width;
                        width: min(360px, parent.width / 2);
                        height: parent.height;
                        source: @image-url("icones/motif-cadence.svg");
                        image-fit: cover;
                    }

                    VerticalLayout {
                        padding: 28px;
                        spacing: 10px;
                        alignment: center;

                        Image {
                            width: 170px;
                            height: 46px;
                            source: @image-url("icones/kadenz-logo-horizontal-negatif.svg");
                            image-fit: contain;
                            horizontal-alignment: Theme.rtl ? ImageHorizontalAlignment.right : ImageHorizontalAlignment.left;
                        }

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("Gestion commerciale");
                            color: white;
                            font-family: Theme.police-titre;
                            font-size: 20px;
                            font-weight: 800;
                        }

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("Devis, proforma, bons de commande, bordereaux de livraison, factures et paiements.");
                            color: #c5cae0;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }

                // Grille et non Rangee : les textes à la ligne y gardent une hauteur stable.
                // Les deux colonnes s'échangent de droite à gauche.
                GridLayout {
                    spacing: 20px;

                    Rectangle {
                        row: 0;
                        col: Theme.rtl ? 1 : 0;
                        border-width: 1px;
                        border-color: Theme.bordure;
                        border-radius: 4px;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 10px;
                            alignment: start;

                            Section {
                                text: @tr("Logiciel");
                            }

                            Text {
                                horizontal-alignment: Theme.debut;
                                text: @tr("Version {}", root.version-logiciel);
                                color: Theme.texte;
                                font-weight: 600;
                            }

                            Text {
                                horizontal-alignment: Theme.debut;
                                text: @tr("Logiciel propriétaire, tous droits réservés.");
                                color: Theme.texte-secondaire;
                                wrap: word-wrap;
                            }

                            Text {
                                horizontal-alignment: Theme.debut;
                                text: @tr("Gestion commerciale mono-poste pour Windows : les données restent sur ce poste.");
                                color: Theme.texte-secondaire;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Rectangle {
                        row: 0;
                        col: Theme.rtl ? 0 : 1;
                        border-width: 1px;
                        border-color: Theme.bordure;
                        border-radius: 4px;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 10px;
                            alignment: start;

                            Section {
                                text: @tr("Composants tiers");
                            }

                            Text {
                                horizontal-alignment: Theme.debut;
                                text: @tr("Interface : Slint, sous licence Slint Royalty-free 2.0.");
                                color: Theme.texte-secondaire;
                                wrap: word-wrap;
                            }

                            Text {
                                horizontal-alignment: Theme.debut;
                                text: @tr("Polices : Inter et Manrope, sous licence SIL Open Font License 1.1.");
                                color: Theme.texte-secondaire;
                                wrap: word-wrap;
                            }

                            Text {
                                horizontal-alignment: Theme.debut;
                                text: @tr("Base de données : SQLite, dans le domaine public.");
                                color: Theme.texte-secondaire;
                                wrap: word-wrap;
                            }

                            AboutSlint {
                                max-height: 110px;
                            }
                        }
                    }
                }

                Rectangle { }
            }
        }
    }
}

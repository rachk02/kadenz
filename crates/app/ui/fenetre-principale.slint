// Fenêtre principale : écrans de démarrage, puis application avec sa navigation
// (bandeau ou barre latérale, navigation.slint) et ses pages.
import { Affichage, Alerte, Confirmation, Droits, Ecriture, FenetreAlerte, FenetreConfirmation, Modules, Rangee, Retour, Theme } from "composants.slint";
import { EcranInscription } from "premier-lancement.slint";
import { EcranConnexion } from "connexion.slint";
import { EcranPresentation } from "presentation.slint";
import { PageProduits, PageTiers, ProduitsApi, TiersApi } from "referentiels.slint";
import { EntrepriseApi, ParametresApi } from "administration.slint";
import { UtilisateursApi } from "utilisateurs.slint";
import { ImportApi, PanneauImport } from "import.slint";
import { FacturesApi, PageFactures } from "factures.slint";
import { PageReglements, PageRelances, PageSuiviFournisseurs, PaiementsApi, TotalUi } from "paiements.slint";
import { PageTableauDeBord, PilotageApi } from "pilotage.slint";
import { ImpressionApi } from "impression.slint";
import { LicenceApi } from "licence.slint";
import { AbonnementApi, BandeauAbonnement } from "abonnement.slint";
import { DocumentAValiderUi, ServeurApi } from "serveur.slint";
import { ConnexionApi } from "etat-connexion.slint";
import { InviteMiseAJour, MiseAJourApi } from "maj.slint";
import { BandeauHaut, BoutonIcone, ContenuBarre, Infobulle, InfobulleFenetre, Menu, Page, PanneauFlottant } from "navigation.slint";
import { PageReglages, ReglagesApi, Rubrique } from "reglages.slint";
import { ChampSuspenduUi, SuspendueUi, SuspenduesApi } from "suspendues.slint";
import { EcranDemarrageImpossible, SauvegardesApi } from "sauvegardes.slint";

export { AbonnementApi, ChampSuspenduUi, ConnexionApi, DocumentAValiderUi, ServeurApi, SuspendueUi, SuspenduesApi, Affichage, Alerte, Droits, Ecriture, Menu, Modules, Theme, EntrepriseApi, FacturesApi, ImportApi, ImpressionApi, LicenceApi, MiseAJourApi, PaiementsApi, ParametresApi, PilotageApi, ProduitsApi, ReglagesApi, SauvegardesApi, TiersApi, UtilisateursApi }

// Écran courant, choisi par l'application au démarrage puis au fil des actions.
export enum Ecran { demarrage-impossible, presentation, inscription, connexion, application }

export component FenetrePrincipale inherits Window {
    in-out property <Ecran> ecran: Ecran.demarrage-impossible;
    // Présentation revue depuis « À propos » : elle ramène à l'application.
    property <bool> presentation-depuis-a-propos;
    in property <string> message-demarrage;
    in property <string> nom-entreprise;
    in property <string> version-logiciel;
    in property <string> utilisateur-nom;
    in property <string> utilisateur-identifiant;
    in property <string> utilisateur-role;
    in-out property <int> utilisateur-langue;


    callback connecter(string, string) -> string;
    callback deconnecter();
    callback changer-mot-de-passe(string, string, string) -> string;
    callback changer-langue(int) -> string;

    // Démarrage impossible : restaurer une sauvegarde ou ouvrir le dossier des données.
    callback choisir-sauvegarde-demarrage() -> string;
    callback restaurer-au-demarrage(string, string) -> Retour;
    callback ouvrir-dossier-donnees();

    // Page affichée ; le menu (global Menu) est construit par l'application à chaque connexion.
    in-out property <Page> page: Page.tableau-de-bord;

    // Barre latérale : épinglée (dans la mise en page) ou repliée ; repliée, le
    // panneau flottant s'ouvre au survol du bouton et repart quand le pointeur s'en va.
    property <bool> barre-epinglee: true;
    property <bool> barre-flottante: false;
    property <bool> survol-bascule;
    property <bool> barre: Affichage.navigation == 1;
    property <string> utilisateur: root.utilisateur-nom + " (" + root.utilisateur-role + ")";

    changed survol-bascule => {
        if (root.survol-bascule && !root.barre-epinglee) {
            root.barre-flottante = true;
        }
    }

    function choisir(p: Page) {
        root.page = p;
        root.barre-flottante = false;
    }

    // Clic sur l'état de la connexion : le détail est dans la rubrique « Serveur ».
    function ouvrir-connexion() {
        root.choisir(Page.parametres);
        ReglagesApi.rubrique = Rubrique.serveur;
    }

    title: root.nom-entreprise == "" ? "Kadenz" : root.nom-entreprise;
    icon: @image-url("icones/kadenz-64.png");
    default-font-family: Theme.police-texte;
    preferred-width: 1200px;
    preferred-height: 760px;
    min-width: 900px;
    min-height: 640px;
    background: white;

    if root.ecran == Ecran.demarrage-impossible: EcranDemarrageImpossible {
        message: root.message-demarrage;
        choisir-fichier => {
            root.choisir-sauvegarde-demarrage()
        }
        restaurer-fichier(chemin, mot-de-passe) => {
            root.restaurer-au-demarrage(chemin, mot-de-passe)
        }
        ouvrir-dossier-donnees => {
            root.ouvrir-dossier-donnees();
        }
    }

    if root.ecran == Ecran.presentation: EcranPresentation {
        version-logiciel: root.version-logiciel;
        depuis-a-propos: root.presentation-depuis-a-propos;
        terminer => {
            root.ecran = root.presentation-depuis-a-propos ? Ecran.application : Ecran.inscription;
            root.presentation-depuis-a-propos = false;
        }
    }

    if root.ecran == Ecran.inscription: EcranInscription {
        version-logiciel: root.version-logiciel;
    }

    if root.ecran == Ecran.connexion: EcranConnexion {
        nom-entreprise: root.nom-entreprise;
        version-logiciel: root.version-logiciel;
        connecter(identifiant, mot-de-passe) => {
            root.connecter(identifiant, mot-de-passe)
        }
    }

    // Ctrl+B replie ou déplie la barre latérale (mode barre seulement).
    if root.ecran == Ecran.application: FocusScope {
        init => {
            self.focus();
        }
        // Fenêtre de confirmation refermée : le focus revient ici, pour Ctrl+B.
        property <bool> confirmation-ouverte: Confirmation.ouverte;
        changed confirmation-ouverte => {
            if (!self.confirmation-ouverte) {
                self.focus();
            }
        }
        key-pressed(e) => {
            if (root.barre && !Confirmation.ouverte && e.modifiers.control && (e.text == "b" || e.text == "B")) {
                root.barre-epinglee = !root.barre-epinglee;
                root.barre-flottante = false;
                // L'infobulle du bouton de bascule ne correspond plus à son état.
                Infobulle.texte = "";
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            if !root.barre: BandeauHaut {
                nom-entreprise: root.nom-entreprise;
                utilisateur: root.utilisateur;
                page: root.page;
                choisi(p) => {
                    root.choisir(p);
                }
                ouvrir-connexion => {
                    root.ouvrir-connexion();
                }
            }

            // Abonnement (F3) : avertissement avant l'échéance, ou lecture seule. Hors de
            // la Rangee : un texte qui passe à la ligne dans un Flexbox boucle.
            if AbonnementApi.bandeau != "": VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;

                BandeauAbonnement {
                    ouvrir => {
                        root.choisir(Page.parametres);
                        ReglagesApi.rubrique = Rubrique.abonnement;
                    }
                }
            }

            Rangee {
                remplit: true;

                // Barre épinglée : sa largeur s'anime quand on la replie ou la déplie.
                if root.barre: Rectangle {
                    width: root.barre-epinglee ? 248px : 0px;
                    animate width {
                        duration: Affichage.duree-longue;
                        easing: ease-out;
                    }
                    background: Theme.fond-lateral;
                    clip: true;

                    ContenuBarre {
                        x: Theme.rtl ? parent.width - self.width : 0px;
                        width: 248px;
                        height: parent.height;
                        nom-entreprise: root.nom-entreprise;
                        utilisateur: root.utilisateur;
                        page: root.page;
                        infobulle-bascule: @tr("Replier la barre latérale (Ctrl+B)");
                        choisi(p) => {
                            root.choisir(p);
                        }
                        ouvrir-connexion => {
                            root.ouvrir-connexion();
                        }
                        basculer => {
                            root.barre-epinglee = false;
                        }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;

                    // Barre repliée : une ligne mince garde le bouton qui la rouvre.
                    if root.barre && !root.barre-epinglee: HorizontalLayout {
                        height: 44px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: Theme.rangee-debut;

                        BoutonIcone {
                            icone: @image-url("icones/actions/barre.svg");
                            infobulle: @tr("Afficher la barre latérale (Ctrl+B)");
                            changed survol => {
                                root.survol-bascule = self.survol;
                            }
                            clique => {
                                root.barre-epinglee = true;
                                root.barre-flottante = false;
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;

                        // Un écran commun pour les documents ; le type est le rang dans
                        // TypeDocument::TOUS (0 devis, 1 proforma, 2 bon de commande,
                        // 3 bordereau, 4 facture, 5 avoir).
                        if root.page == Page.tableau-de-bord: PageTableauDeBord { }

                        if root.page == Page.devis: PageFactures {
                            type-document: 0;
                        }

                        if root.page == Page.proforma: PageFactures {
                            type-document: 1;
                        }

                        if root.page == Page.bons-commande: PageFactures {
                            type-document: 2;
                        }

                        if root.page == Page.livraisons: PageFactures {
                            type-document: 3;
                        }

                        if root.page == Page.factures: PageFactures {
                            type-document: 4;
                        }

                        if root.page == Page.avoirs: PageFactures {
                            type-document: 5;
                        }

                        if root.page == Page.reglements: PageReglements { }

                        if root.page == Page.suivi-fournisseurs: PageSuiviFournisseurs { }

                        if root.page == Page.relances: PageRelances { }

                        if root.page == Page.tiers: PageTiers { }

                        if root.page == Page.produits: PageProduits { }

                        if root.page == Page.parametres: PageReglages {
                            version-logiciel: root.version-logiciel;
                            nom-entreprise: root.nom-entreprise;
                            utilisateur-nom: root.utilisateur-nom;
                            utilisateur-identifiant: root.utilisateur-identifiant;
                            utilisateur-role: root.utilisateur-role;
                            utilisateur-langue <=> root.utilisateur-langue;
                            changer-mot-de-passe(ancien, nouveau, confirmation) => {
                                root.changer-mot-de-passe(ancien, nouveau, confirmation)
                            }
                            changer-langue(rang) => {
                                root.changer-langue(rang)
                            }
                            revoir-presentation => {
                                root.presentation-depuis-a-propos = true;
                                root.ecran = Ecran.presentation;
                            }
                            deconnecter => {
                                root.deconnecter();
                            }
                        }

                        // Recouvre l'écran Tiers ou Produits pendant un import.
                        if ImportApi.actif: PanneauImport { }
                    }
                }
            }
        }
    }

    // Panneau flottant de la barre repliée, par-dessus le contenu.
    if root.ecran == Ecran.application && root.barre && !root.barre-epinglee: panneau := PanneauFlottant {
        y: 8px;
        height: root.height - 16px;
        largeur-fenetre: root.width;
        ouvert: root.barre-flottante;

        ContenuBarre {
            width: parent.width;
            height: parent.height;
            nom-entreprise: root.nom-entreprise;
            utilisateur: root.utilisateur;
            page: root.page;
            infobulle-bascule: @tr("Épingler la barre latérale (Ctrl+B)");
            choisi(p) => {
                root.choisir(p);
            }
            ouvrir-connexion => {
                root.ouvrir-connexion();
            }
            basculer => {
                root.barre-epinglee = true;
                root.barre-flottante = false;
            }
        }

        // Le panneau repart quand le pointeur a quitté le bouton et le panneau.
        Timer {
            interval: 300ms;
            running: root.barre-flottante && !root.survol-bascule && !panneau.survol;
            triggered => {
                root.barre-flottante = false;
            }
        }
    }

    // Invite de mise à jour (jalon J10), par-dessus l'application.
    if root.ecran == Ecran.application && MiseAJourApi.visible: InviteMiseAJour {
        width: root.width;
        height: root.height;
    }

    InfobulleFenetre {
        largeur-fenetre: root.width;
    }

    // Alerte brève de réussite, en bas de la fenêtre.
    FenetreAlerte {
        largeur-fenetre: root.width;
        hauteur-fenetre: root.height;
    }

    // Demande de confirmation commune, au-dessus de tout.
    FenetreConfirmation {
        width: root.width;
        height: root.height;
    }
}

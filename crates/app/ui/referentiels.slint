// Écrans des référentiels Tiers et Produits (cahier des charges, sections 5.2 et 5.3).
// Une liste filtrable et triable à gauche, la fiche sélectionnée à droite.

import { CheckBox, ComboBox, LineEdit, StandardTableView } from "std-widgets.slint";
import { Alerte, Bouton, Champ, Confirmation, Droits, MessageRetour, Rangee, Retour, Section, Theme, Titre } from "composants.slint";
import { ImportApi } from "import.slint";
import { ConnexionApi } from "etat-connexion.slint";

// Fiche telle que l'écran la manipule ; `existe` est faux pour une nouvelle fiche.
export struct FicheTiersUi {
    nom: string,
    adresse: string,
    telephone: string,
    localisation: string,
    ifu: string,
    rccm: string,
    regime: string,
    // Rang dans « Client, Fournisseur, Client et fournisseur ».
    type-tiers: int,
    actif: bool,
    existe: bool,
}

export struct FicheProduitUi {
    designation: string,
    reference: string,
    prix: string,
    // Rang dans « Vente, Achat, Vente et achat ».
    sens: int,
    actif: bool,
    existe: bool,
}

// Données et actions de l'écran Tiers, fournies par l'application.
export global TiersApi {
    in property <[[StandardListViewItem]]> lignes;
    in property <string> resume;
    in-out property <int> ligne-courante: -1;
    callback ouvrir();
    // Type : 0 tous, 1 clients, 2 fournisseurs, 3 les deux seulement.
    callback filtrer(texte: string, type-tiers: int, inactifs: bool);
    callback trier(colonne: int, croissant: bool);
    callback selectionner(ligne: int) -> FicheTiersUi;
    callback nouvelle() -> FicheTiersUi;
    // Export Excel des fiches affichées, filtre compris (jalon J10).
    callback exporter() -> Retour;
    callback fiche-courante() -> FicheTiersUi;
    callback enregistrer(fiche: FicheTiersUi) -> Retour;
    callback retirer() -> Retour;
    callback reactiver() -> Retour;
}

export global ProduitsApi {
    in property <[[StandardListViewItem]]> lignes;
    in property <string> resume;
    in-out property <int> ligne-courante: -1;
    callback ouvrir();
    // Sens : 0 tous, 1 vente, 2 achat, 3 les deux seulement.
    callback filtrer(texte: string, sens: int, inactifs: bool);
    callback trier(colonne: int, croissant: bool);
    callback selectionner(ligne: int) -> FicheProduitUi;
    callback nouvelle() -> FicheProduitUi;
    // Export Excel des fiches affichées, filtre compris (jalon J10).
    callback exporter() -> Retour;
    callback fiche-courante() -> FicheProduitUi;
    callback enregistrer(fiche: FicheProduitUi) -> Retour;
    callback retirer() -> Retour;
    callback reactiver() -> Retour;
}

// Boutons communs du bas de fiche : enregistrer, retirer (avec confirmation), réactiver.
component ActionsFiche inherits VerticalLayout {
    in property <bool> existe;
    in property <bool> actif;
    in property <bool> modifiable;
    in property <bool> peut-retirer;
    callback enregistrer();
    callback retirer();
    callback reactiver();

    // Retrait demandé, en attente de la fenêtre de confirmation commune.
    property <bool> confirmer: false;
    property <int> reponses: Confirmation.reponses;
    changed reponses => {
        if (self.confirmer) {
            self.confirmer = false;
            if (Confirmation.accepte) {
                root.retirer();
            }
        }
    }

    spacing: 8px;
    vertical-stretch: 0;

    Rangee {
        spacing: 8px;
        alignment: start;

        if root.modifiable: Bouton {
            text: root.existe ? @tr("Enregistrer") : @tr("Ajouter");
            primary: true;
            clicked => {
                root.confirmer = false;
                root.enregistrer();
            }
        }

        if root.existe && root.actif && root.peut-retirer: Bouton {
            text: @tr("Retirer");
            clicked => {
                root.confirmer = true;
                Confirmation.demander(
                    @tr("Retirer cette fiche ? Elle est supprimée si aucun document ne la cite, sinon seulement désactivée."),
                    @tr("Confirmer le retrait"),
                    true);
            }
        }

        if root.existe && !root.actif && root.peut-retirer: Bouton {
            text: @tr("Réactiver");
            clicked => {
                root.reactiver();
            }
        }
    }

    if root.existe && !root.modifiable: Text {
        horizontal-alignment: Theme.debut;
        text: @tr("Lecture seule : votre rôle ne permet pas de modifier une fiche existante.");
        color: Theme.texte-secondaire;
        wrap: word-wrap;
    }
}

export component PageTiers inherits VerticalLayout {
    property <FicheTiersUi> fiche;
    property <Retour> retour;
    property <bool> modifiable: root.fiche.existe ? Droits.modifier-referentiel : Droits.ajouter-referentiel;

    function charger(f: FicheTiersUi) {
        root.fiche = f;
        nom.valeur = f.nom;
        adresse.valeur = f.adresse;
        telephone.valeur = f.telephone;
        localisation.valeur = f.localisation;
        ifu.valeur = f.ifu;
        rccm.valeur = f.rccm;
        regime.valeur = f.regime;
        type-tiers.current-index = f.type-tiers;
    }

    function saisie() -> FicheTiersUi {
        {
            nom: nom.valeur,
            adresse: adresse.valeur,
            telephone: telephone.valeur,
            localisation: localisation.valeur,
            ifu: ifu.valeur,
            rccm: rccm.valeur,
            regime: regime.valeur,
            type-tiers: type-tiers.current-index,
            actif: root.fiche.actif,
            existe: root.fiche.existe,
        }
    }

    function filtrer() {
        TiersApi.filtrer(recherche.text, filtre-type.current-index, inactifs.checked);
    }

    init => {
        TiersApi.ouvrir();
        root.charger(TiersApi.nouvelle());
    }

    // Poste relié : liste rechargée quand un autre poste change un tiers.
    property <int> changements: ConnexionApi.changements-tiers;
    changed changements => {
        TiersApi.ouvrir();
    }

    padding: 24px;
    spacing: 12px;

    Titre {
        text: @tr("Tiers");
    }

    Rangee {
        spacing: 8px;

        recherche := LineEdit {
            placeholder-text: @tr("Rechercher : nom, téléphone, localisation, adresse, IFU");
            edited => {
                root.filtrer();
            }
        }

        filtre-type := ComboBox {
            width: 200px;
            model: [@tr("Tous les tiers"), @tr("Clients"), @tr("Fournisseurs"), @tr("Clients et fournisseurs")];
            selected => {
                root.filtrer();
            }
        }

        inactifs := CheckBox {
            text: @tr("Fiches désactivées");
            toggled => {
                root.filtrer();
            }
        }

        Bouton {
            text: @tr("Exporter en Excel");
            clicked => {
                root.retour = TiersApi.exporter();
            }
        }

        if Droits.ajouter-referentiel: Bouton {
            text: @tr("Importer");
            clicked => {
                ImportApi.demarrer(0);
            }
        }

        if Droits.ajouter-referentiel: Bouton {
            text: @tr("Nouveau tiers");
            clicked => {
                root.retour = { };
                root.charger(TiersApi.nouvelle());
            }
        }
    }

    Rangee {
        remplit: true;
        spacing: 16px;

        VerticalLayout {
            spacing: 4px;

            StandardTableView {
                // De droite à gauche, colonnes en ordre inverse (cellules inversées dans modele_lignes).
                columns: Theme.rtl ? [
                    { title: @tr("État"), min-width: 70px, horizontal-stretch: 1 },
                    { title: @tr("IFU"), min-width: 70px, horizontal-stretch: 1 },
                    { title: @tr("Localisation"), min-width: 90px, horizontal-stretch: 1 },
                    { title: @tr("Téléphone"), min-width: 90px, horizontal-stretch: 1 },
                    { title: @tr("Type"), min-width: 80px, horizontal-stretch: 1 },
                    { title: @tr("Nom"), min-width: 140px, horizontal-stretch: 3 },
                ] : [
                    { title: @tr("Nom"), min-width: 140px, horizontal-stretch: 3 },
                    { title: @tr("Type"), min-width: 80px, horizontal-stretch: 1 },
                    { title: @tr("Téléphone"), min-width: 90px, horizontal-stretch: 1 },
                    { title: @tr("Localisation"), min-width: 90px, horizontal-stretch: 1 },
                    { title: @tr("IFU"), min-width: 70px, horizontal-stretch: 1 },
                    { title: @tr("État"), min-width: 70px, horizontal-stretch: 1 },
                ];
                rows: TiersApi.lignes;
                current-row <=> TiersApi.ligne-courante;
                current-row-changed(ligne) => {
                    root.retour = { };
                    root.charger(TiersApi.selectionner(ligne));
                }
                sort-ascending(colonne) => {
                    TiersApi.trier(Theme.rtl ? 5 - colonne : colonne, true);
                }
                sort-descending(colonne) => {
                    TiersApi.trier(Theme.rtl ? 5 - colonne : colonne, false);
                }
            }

            Text {
                horizontal-alignment: Theme.debut;
                text: TiersApi.resume;
                font-size: 12px;
                color: Theme.texte-secondaire;
            }
        }

        VerticalLayout {
            width: 360px;
            spacing: 10px;

            Section {
                text: root.fiche.existe ? (root.fiche.actif ? @tr("Fiche du tiers") : @tr("Fiche du tiers (désactivée)")) : (Droits.ajouter-referentiel ? @tr("Nouveau tiers") : @tr("Fiche du tiers"));
            }

            nom := Champ {
                libelle: @tr("Nom");
                lecture-seule: !root.modifiable;
            }

            adresse := Champ {
                libelle: @tr("Adresse ou boîte postale");
                lecture-seule: !root.modifiable;
            }

            GridLayout {
                spacing: 10px;

                Row {
                    telephone := Champ {
                        libelle: @tr("Téléphone");
                        lecture-seule: !root.modifiable;
                    }

                    localisation := Champ {
                        libelle: @tr("Localisation");
                        lecture-seule: !root.modifiable;
                    }
                }

                Row {
                    ifu := Champ {
                        libelle: @tr("IFU");
                        lecture-seule: !root.modifiable;
                    }

                    rccm := Champ {
                        libelle: @tr("RCCM");
                        lecture-seule: !root.modifiable;
                    }
                }

                Row {
                    regime := Champ {
                        libelle: @tr("Régime d'imposition");
                        lecture-seule: !root.modifiable;
                    }

                    VerticalLayout {
                        spacing: 4px;

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("Type");
                            font-size: 12px;
                            color: Theme.texte-secondaire;
                        }

                        type-tiers := ComboBox {
                            model: [@tr("Client"), @tr("Fournisseur"), @tr("Client et fournisseur")];
                            enabled: root.modifiable;
                        }
                    }
                }
            }

            ActionsFiche {
                existe: root.fiche.existe;
                actif: root.fiche.actif;
                modifiable: root.modifiable;
                peut-retirer: Droits.modifier-referentiel;
                enregistrer => {
                    root.retour = Alerte.relayer(TiersApi.enregistrer(root.saisie()));
                    if (root.retour.ok) {
                        root.charger(TiersApi.fiche-courante());
                    }
                }
                retirer => {
                    root.retour = Alerte.relayer(TiersApi.retirer());
                    root.charger(TiersApi.fiche-courante());
                }
                reactiver => {
                    root.retour = Alerte.relayer(TiersApi.reactiver());
                    root.charger(TiersApi.fiche-courante());
                }
            }

            MessageRetour {
                retour: root.retour;
            }

            if !root.fiche.existe && !Droits.ajouter-referentiel: Text {
                horizontal-alignment: Theme.debut;
                text: @tr("Sélectionner un tiers dans la liste pour afficher sa fiche.");
                color: Theme.texte-secondaire;
                wrap: word-wrap;
            }

            Rectangle { }
        }
    }
}

export component PageProduits inherits VerticalLayout {
    property <FicheProduitUi> fiche;
    property <Retour> retour;
    property <bool> modifiable: root.fiche.existe ? Droits.modifier-referentiel : Droits.ajouter-referentiel;

    function charger(f: FicheProduitUi) {
        root.fiche = f;
        designation.valeur = f.designation;
        reference.valeur = f.reference;
        prix.valeur = f.prix;
        sens.current-index = f.sens;
    }

    function saisie() -> FicheProduitUi {
        {
            designation: designation.valeur,
            reference: reference.valeur,
            prix: prix.valeur,
            sens: sens.current-index,
            actif: root.fiche.actif,
            existe: root.fiche.existe,
        }
    }

    function filtrer() {
        ProduitsApi.filtrer(recherche.text, filtre-sens.current-index, inactifs.checked);
    }

    init => {
        ProduitsApi.ouvrir();
        root.charger(ProduitsApi.nouvelle());
    }

    // Poste relié : liste rechargée quand un autre poste change un produit.
    property <int> changements: ConnexionApi.changements-produits;
    changed changements => {
        ProduitsApi.ouvrir();
    }

    padding: 24px;
    spacing: 12px;

    Titre {
        text: @tr("Produits et services");
    }

    Rangee {
        spacing: 8px;

        recherche := LineEdit {
            placeholder-text: @tr("Rechercher : désignation ou référence");
            edited => {
                root.filtrer();
            }
        }

        filtre-sens := ComboBox {
            width: 200px;
            model: [@tr("Tous les produits"), @tr("Vente"), @tr("Achat"), @tr("Vente et achat")];
            selected => {
                root.filtrer();
            }
        }

        inactifs := CheckBox {
            text: @tr("Fiches désactivées");
            toggled => {
                root.filtrer();
            }
        }

        Bouton {
            text: @tr("Exporter en Excel");
            clicked => {
                root.retour = ProduitsApi.exporter();
            }
        }

        if Droits.ajouter-referentiel: Bouton {
            text: @tr("Importer");
            clicked => {
                ImportApi.demarrer(1);
            }
        }

        if Droits.ajouter-referentiel: Bouton {
            text: @tr("Nouveau produit");
            clicked => {
                root.retour = { };
                root.charger(ProduitsApi.nouvelle());
            }
        }
    }

    Rangee {
        remplit: true;
        spacing: 16px;

        VerticalLayout {
            spacing: 4px;

            StandardTableView {
                // De droite à gauche, colonnes en ordre inverse (cellules inversées dans modele_lignes).
                columns: Theme.rtl ? [
                    { title: @tr("État"), min-width: 90px, horizontal-stretch: 1 },
                    { title: @tr("Sens"), min-width: 120px, horizontal-stretch: 1 },
                    { title: @tr("Prix (FCFA)"), min-width: 110px, horizontal-stretch: 1 },
                    { title: @tr("Désignation"), min-width: 180px, horizontal-stretch: 3 },
                    { title: @tr("Référence"), min-width: 110px, horizontal-stretch: 1 },
                ] : [
                    { title: @tr("Référence"), min-width: 110px, horizontal-stretch: 1 },
                    { title: @tr("Désignation"), min-width: 180px, horizontal-stretch: 3 },
                    { title: @tr("Prix (FCFA)"), min-width: 110px, horizontal-stretch: 1 },
                    { title: @tr("Sens"), min-width: 120px, horizontal-stretch: 1 },
                    { title: @tr("État"), min-width: 90px, horizontal-stretch: 1 },
                ];
                rows: ProduitsApi.lignes;
                current-row <=> ProduitsApi.ligne-courante;
                current-row-changed(ligne) => {
                    root.retour = { };
                    root.charger(ProduitsApi.selectionner(ligne));
                }
                sort-ascending(colonne) => {
                    ProduitsApi.trier(Theme.rtl ? 4 - colonne : colonne, true);
                }
                sort-descending(colonne) => {
                    ProduitsApi.trier(Theme.rtl ? 4 - colonne : colonne, false);
                }
            }

            Text {
                horizontal-alignment: Theme.debut;
                text: ProduitsApi.resume;
                font-size: 12px;
                color: Theme.texte-secondaire;
            }
        }

        VerticalLayout {
            width: 360px;
            spacing: 10px;

            Section {
                text: root.fiche.existe ? (root.fiche.actif ? @tr("Fiche du produit") : @tr("Fiche du produit (désactivée)")) : (Droits.ajouter-referentiel ? @tr("Nouveau produit") : @tr("Fiche du produit"));
            }

            designation := Champ {
                libelle: @tr("Désignation");
                lecture-seule: !root.modifiable;
            }

            GridLayout {
                spacing: 10px;

                Row {
                    reference := Champ {
                        libelle: @tr("Référence (unique)");
                        lecture-seule: !root.modifiable;
                    }

                    prix := Champ {
                        libelle: @tr("Prix unitaire (FCFA)");
                        lecture-seule: !root.modifiable;
                    }
                }
            }

            VerticalLayout {
                spacing: 4px;

                Text {
                    horizontal-alignment: Theme.debut;
                    text: @tr("Sens d'utilisation");
                    font-size: 12px;
                    color: Theme.texte-secondaire;
                }

                sens := ComboBox {
                    model: [@tr("Vente"), @tr("Achat"), @tr("Vente et achat")];
                    enabled: root.modifiable;
                }
            }

            ActionsFiche {
                existe: root.fiche.existe;
                actif: root.fiche.actif;
                modifiable: root.modifiable;
                peut-retirer: Droits.modifier-referentiel;
                enregistrer => {
                    root.retour = Alerte.relayer(ProduitsApi.enregistrer(root.saisie()));
                    if (root.retour.ok) {
                        root.charger(ProduitsApi.fiche-courante());
                    }
                }
                retirer => {
                    root.retour = Alerte.relayer(ProduitsApi.retirer());
                    root.charger(ProduitsApi.fiche-courante());
                }
                reactiver => {
                    root.retour = Alerte.relayer(ProduitsApi.reactiver());
                    root.charger(ProduitsApi.fiche-courante());
                }
            }

            MessageRetour {
                retour: root.retour;
            }

            if !root.fiche.existe && !Droits.ajouter-referentiel: Text {
                horizontal-alignment: Theme.debut;
                text: @tr("Sélectionner un produit dans la liste pour afficher sa fiche.");
                color: Theme.texte-secondaire;
                wrap: word-wrap;
            }

            Rectangle { }
        }
    }
}

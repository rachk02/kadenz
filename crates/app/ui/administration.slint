// Écrans d'administration : fiche entreprise et logos, paramètres système
// (cahier des charges, sections 5.1 et 5.4).

import { ComboBox, ScrollView, TextEdit } from "std-widgets.slint";
import { Alerte, Bouton, Champ, Confirmation, MessageRetour, Modules, Rangee, Retour, Section, Theme, Titre } from "composants.slint";

export struct FicheEntrepriseUi {
    nom: string,
    adresse: string,
    telephone: string,
    email: string,
    site-web: string,
    localisation: string,
    regime: string,
    rccm: string,
    ifu: string,
    banque1: string,
    banque2: string,
    responsable-facturation: string,
    responsable-comptabilite: string,
}

export global EntrepriseApi {
    in property <image> logo-principal;
    in property <image> logo-secondaire;
    in property <bool> a-logo-principal;
    in property <bool> a-logo-secondaire;
    callback ouvrir() -> FicheEntrepriseUi;
    callback enregistrer(fiche: FicheEntrepriseUi) -> Retour;
    // Rang du logo : 0 principal, 1 secondaire.
    callback choisir-logo(rang: int) -> Retour;
    callback retirer-logo(rang: int) -> Retour;
}

// Réglages imprimés d'un type de document, dans l'ordre des types du domaine.
export struct TexteDocumentUi {
    titre: string,
    phrase: string,
    signataire: string,
    dossier: string,
}

// Textes de la lettre de relance (section 8), réglés à part des types de document.
export struct TextesRelanceUi {
    titre: string,
    objet: string,
    avant: string,
    apres: string,
    signataire: string,
}

export struct ParametresUi {
    taux-tva: string,
    taux-remise: string,
    taux-retenue: string,
    modes-paiement: string,
    // 0 rectifiée (1990), 1 traditionnelle.
    orthographe: int,
    validite-devis: string,
    delai-paiement: string,
    // Numérotation : préfixes par type, compteur annuel (sinon mensuel), chiffres du rang.
    prefixe-devis: string,
    prefixe-proforma: string,
    prefixe-commande: string,
    prefixe-livraison: string,
    prefixe-facture: string,
    prefixe-avoir: string,
    remise-annuelle: bool,
    chiffres: string,
    // Documents imprimés : un jeu de textes par type, couleur « #rrggbb ».
    textes: [TexteDocumentUi],
    couleur: string,
    relance: TextesRelanceUi,
}

export global ParametresApi {
    // Exemples d'écriture d'un même montant dans les deux orthographes.
    in property <string> exemple-rectifiee;
    in property <string> exemple-traditionnelle;
    callback ouvrir() -> ParametresUi;
    callback enregistrer(parametres: ParametresUi) -> Retour;
    // Exemple de numéro de facture pour un préfixe, un compteur et un nombre de chiffres.
    pure callback exemple-numero(prefixe: string, annuelle: bool, chiffres: string) -> string;
    // Couleur saisie « #rrggbb », transparente si elle est illisible.
    pure callback couleur-apercu(texte: string) -> color;
    // Choix d'un dossier ; rend le dossier actuel si l'on renonce.
    callback choisir-dossier(actuel: string) -> string;
    // Textes par défaut d'un type (rang dans l'ordre des types).
    pure callback textes-par-defaut(rang: int) -> TexteDocumentUi;
    // Texte de la lettre de relance validé par l'utilisateur (jalon J7).
    pure callback relance-par-defaut() -> TextesRelanceUi;
}

component CadreLogo inherits VerticalLayout {
    in property <string> libelle;
    in property <image> source;
    in property <bool> present;
    in property <Retour> retour;
    callback choisir();
    callback retirer();

    spacing: 8px;

    Text {
        horizontal-alignment: Theme.debut;
        text: root.libelle;
        font-size: 12px;
        color: Theme.texte-secondaire;
    }

    Rectangle {
        height: 110px;
        border-width: 1px;
        border-color: Theme.bordure;
        border-radius: 4px;

        if root.present: Image {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: parent.height - 16px;
            source: root.source;
            image-fit: contain;
        }

        if !root.present: Text {
            text: @tr("Aucun logo");
            color: Theme.texte-secondaire;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Rangee {
        spacing: 8px;
        alignment: start;

        Bouton {
            text: root.present ? @tr("Remplacer") : @tr("Choisir une image");
            clicked => {
                root.choisir();
            }
        }

        if root.present: Bouton {
            text: @tr("Retirer");
            clicked => {
                root.retirer();
            }
        }
    }

    if root.retour.message != "": MessageRetour {
        erreurs-seules: true;
        retour: root.retour;
    }
}

export component PageEntreprise inherits ScrollView {
    // Page étroite (Paramètres à côté d'une barre latérale) : les logos passent sous la fiche.
    in property <bool> etroit;
    property <Retour> retour;
    property <Retour> retour-logo-principal;
    property <Retour> retour-logo-secondaire;
    // Logo dont le retrait attend la fenêtre de confirmation (-1 aucun).
    property <int> logo-a-retirer: -1;
    property <int> reponses: Confirmation.reponses;
    changed reponses => {
        if (self.logo-a-retirer >= 0) {
            if (Confirmation.accepte) {
                if (self.logo-a-retirer == 0) {
                    root.retour-logo-principal = EntrepriseApi.retirer-logo(0);
                    Alerte.retour(root.retour-logo-principal);
                } else {
                    root.retour-logo-secondaire = EntrepriseApi.retirer-logo(1);
                    Alerte.retour(root.retour-logo-secondaire);
                }
            }
            self.logo-a-retirer = -1;
        }
    }

    function demander-retrait(rang: int) {
        root.logo-a-retirer = rang;
        Confirmation.demander(@tr("Retirer ce logo ?"), @tr("Retirer"), true);
    }

    function charger(f: FicheEntrepriseUi) {
        nom.valeur = f.nom;
        adresse.valeur = f.adresse;
        telephone.valeur = f.telephone;
        email.valeur = f.email;
        site-web.valeur = f.site-web;
        localisation.valeur = f.localisation;
        regime.valeur = f.regime;
        rccm.valeur = f.rccm;
        ifu.valeur = f.ifu;
        banque1.valeur = f.banque1;
        banque2.valeur = f.banque2;
        responsable-facturation.valeur = f.responsable-facturation;
        responsable-comptabilite.valeur = f.responsable-comptabilite;
    }

    function saisie() -> FicheEntrepriseUi {
        {
            nom: nom.valeur,
            adresse: adresse.valeur,
            telephone: telephone.valeur,
            email: email.valeur,
            site-web: site-web.valeur,
            localisation: localisation.valeur,
            regime: regime.valeur,
            rccm: rccm.valeur,
            ifu: ifu.valeur,
            banque1: banque1.valeur,
            banque2: banque2.valeur,
            responsable-facturation: responsable-facturation.valeur,
            responsable-comptabilite: responsable-comptabilite.valeur,
        }
    }

    init => {
        root.charger(EntrepriseApi.ouvrir());
    }

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        alignment: start;

        Titre {
            text: @tr("Entreprise");
        }

        Text {
            horizontal-alignment: Theme.debut;
            text: @tr("Ces informations figurent en en-tête et en pied de page des documents.");
            color: Theme.texte-secondaire;
        }

        // Grille et non Rangee : la note sur les logos, à la ligne, y garde une hauteur stable.
        GridLayout {
            spacing: 32px;

            GridLayout {
                row: 0;
                col: root.etroit ? 0 : (Theme.rtl ? 1 : 0);
                spacing: 12px;
                horizontal-stretch: 2;

                Row {
                    nom := Champ {
                        libelle: @tr("Nom");
                        colspan: 2;
                    }
                }

                Row {
                    adresse := Champ {
                        libelle: @tr("Adresse");
                    }

                    localisation := Champ {
                        libelle: @tr("Localisation");
                    }
                }

                Row {
                    telephone := Champ {
                        libelle: @tr("Téléphone");
                    }

                    email := Champ {
                        libelle: @tr("Email");
                    }
                }

                Row {
                    site-web := Champ {
                        libelle: @tr("Site web");
                    }

                    regime := Champ {
                        libelle: @tr("Régime d'imposition");
                    }
                }

                Row {
                    rccm := Champ {
                        libelle: @tr("RCCM");
                    }

                    ifu := Champ {
                        libelle: @tr("IFU");
                    }
                }

                Row {
                    banque1 := Champ {
                        libelle: @tr("Compte bancaire 1");
                    }

                    banque2 := Champ {
                        libelle: @tr("Compte bancaire 2");
                    }
                }

                Row {
                    responsable-facturation := Champ {
                        libelle: @tr("Responsable de la facturation");
                    }

                    responsable-comptabilite := Champ {
                        libelle: @tr("Responsable de la comptabilité");
                    }
                }

                Row {
                    Rangee {
                        colspan: 2;
                        spacing: 12px;
                        alignment: start;

                        Bouton {
                            text: @tr("Enregistrer");
                            primary: true;
                            clicked => {
                                root.retour = EntrepriseApi.enregistrer(root.saisie());
                                Alerte.retour(root.retour);
                            }
                        }
                    }
                }

                // Sous le bouton : un texte à la ligne dans une Rangee ferait boucler la mise en page.
                Row {
                    MessageRetour {
                        erreurs-seules: true;
                        colspan: 2;
                        retour: root.retour;
                    }
                }
            }

            VerticalLayout {
                row: root.etroit ? 1 : 0;
                col: root.etroit ? 0 : (Theme.rtl ? 0 : 1);
                min-width: root.etroit ? 0px : 280px;
                max-width: root.etroit ? 100000px : 280px;
                spacing: 16px;
                alignment: start;

                Section {
                    text: @tr("Logos");
                }

                Text {
                    horizontal-alignment: Theme.debut;
                    text: @tr("Image PNG ou JPEG, 2 Mo au plus. Le logo principal figure à gauche de l'en-tête, le second à droite.");
                    color: Theme.texte-secondaire;
                    wrap: word-wrap;
                }

                CadreLogo {
                    libelle: @tr("Logo principal");
                    source: EntrepriseApi.logo-principal;
                    present: EntrepriseApi.a-logo-principal;
                    retour: root.retour-logo-principal;
                    choisir => {
                        root.retour-logo-principal = EntrepriseApi.choisir-logo(0);
                        Alerte.retour(root.retour-logo-principal);
                    }
                    retirer => {
                        root.demander-retrait(0);
                    }
                }

                CadreLogo {
                    libelle: @tr("Second logo");
                    source: EntrepriseApi.logo-secondaire;
                    present: EntrepriseApi.a-logo-secondaire;
                    retour: root.retour-logo-secondaire;
                    choisir => {
                        root.retour-logo-secondaire = EntrepriseApi.choisir-logo(1);
                        Alerte.retour(root.retour-logo-secondaire);
                    }
                    retirer => {
                        root.demander-retrait(1);
                    }
                }
            }
        }
    }
}

// Bloc d'une rubrique des Paramètres : masqué hors de sa rubrique (hauteur nulle),
// ses champs restent chargés et partent avec l'enregistrement commun.
component Bloc inherits Rectangle {
    in property <bool> montre;

    height: root.montre ? contenu.preferred-height : 0px;
    visible: root.montre;
    clip: true;

    contenu := VerticalLayout {
        width: parent.width;
        spacing: 12px;
        padding-bottom: 12px;

        @children
    }
}

// Réglages communs, découpés en rubriques : 0 documents (taux, délais, numérotation,
// montant en lettres), 1 paiements (modes, lettre de relance), 2 textes imprimés et
// dossiers d'export. Un seul enregistrement pour toutes les parties.
export component PageParametres inherits ScrollView {
    in property <int> partie: 0;
    in property <string> titre;
    property <Retour> retour;
    // Textes de chaque type ; le type affiché est édité dans les champs.
    property <[TexteDocumentUi]> textes;
    property <int> rang-texte: 0;
    property <TexteDocumentUi> defaut;
    property <TextesRelanceUi> relance-defaut;

    // Retour aux textes par défaut en attente de la fenêtre de confirmation :
    // 1 pour les textes du type affiché, 2 pour la lettre de relance.
    property <int> defaut-demande: 0;
    property <int> reponses: Confirmation.reponses;
    changed reponses => {
        if (self.defaut-demande != 0) {
            if (Confirmation.accepte) {
                if (self.defaut-demande == 1) {
                    root.defaut = ParametresApi.textes-par-defaut(root.rang-texte);
                    titre-doc.valeur = root.defaut.titre;
                    phrase-doc.valeur = root.defaut.phrase;
                    signataire-doc.valeur = root.defaut.signataire;
                } else {
                    root.relance-defaut = ParametresApi.relance-par-defaut();
                    root.afficher-relance(root.relance-defaut);
                }
            }
            self.defaut-demande = 0;
        }
    }

    function afficher-relance(t: TextesRelanceUi) {
        titre-relance.valeur = t.titre;
        objet-relance.valeur = t.objet;
        avant-relance.text = t.avant;
        apres-relance.text = t.apres;
        signataire-relance.valeur = t.signataire;
    }

    // Recopie les champs dans le jeu du type affiché.
    function memoriser-textes() {
        root.textes[root.rang-texte] = {
            titre: titre-doc.valeur,
            phrase: phrase-doc.valeur,
            signataire: signataire-doc.valeur,
            dossier: dossier-doc.valeur,
        };
    }

    function afficher-textes() {
        titre-doc.valeur = root.textes[root.rang-texte].titre;
        phrase-doc.valeur = root.textes[root.rang-texte].phrase;
        signataire-doc.valeur = root.textes[root.rang-texte].signataire;
        dossier-doc.valeur = root.textes[root.rang-texte].dossier;
    }

    function charger(p: ParametresUi) {
        tva.valeur = p.taux-tva;
        remise.valeur = p.taux-remise;
        retenue.valeur = p.taux-retenue;
        modes.valeur = p.modes-paiement;
        orthographe.current-index = p.orthographe;
        validite.valeur = p.validite-devis;
        delai.valeur = p.delai-paiement;
        prefixe-devis.valeur = p.prefixe-devis;
        prefixe-proforma.valeur = p.prefixe-proforma;
        prefixe-commande.valeur = p.prefixe-commande;
        prefixe-livraison.valeur = p.prefixe-livraison;
        prefixe-facture.valeur = p.prefixe-facture;
        prefixe-avoir.valeur = p.prefixe-avoir;
        compteur.current-index = p.remise-annuelle ? 1 : 0;
        chiffres.valeur = p.chiffres;
        root.textes = p.textes;
        root.afficher-textes();
        couleur.valeur = p.couleur;
        root.afficher-relance(p.relance);
    }

    init => {
        root.charger(ParametresApi.ouvrir());
    }

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        alignment: start;

        Titre {
            text: root.titre;
        }

        // Une seule colonne, calée au début du sens de lecture ; HorizontalLayout et non Rangee :
        // ses textes à la ligne feraient boucler la mise en page d'une Rangee.
        HorizontalLayout {
            alignment: Theme.rangee-debut;

            // 560 px au plus ; moins quand la page est étroite (barre latérale épinglée).
            VerticalLayout {
                max-width: 560px;
                horizontal-stretch: 1;
                spacing: 0px;

                Bloc {
                montre: root.partie == 0;

                Section {
                    text: @tr("Taux proposés dans les documents");
                }

                Text {
                    horizontal-alignment: Theme.debut;
                    text: @tr("Pourcentages séparés par des points-virgules, par exemple « 0 ; 18 » ou « 0 ; 2,5 ; 5 ».");
                    color: Theme.texte-secondaire;
                    wrap: word-wrap;
                }

                tva := Champ {
                    libelle: @tr("TVA (%)");
                }

                remise := Champ {
                    libelle: @tr("Remise (%)");
                }

                retenue := Champ {
                    libelle: @tr("Retenue à la source (%)");
                }

                Section {
                    text: @tr("Délais (en jours, laisser vide pour ne pas en fixer)");
                }

                Rangee {
                    spacing: 12px;

                    validite := Champ {
                        libelle: @tr("Validité des devis");
                    }

                    delai := Champ {
                        libelle: @tr("Délai de paiement des factures");
                    }
                }

                Section {
                    text: @tr("Numérotation des documents");
                }

                Text {
                    horizontal-alignment: Theme.debut;
                    text: @tr("Préfixes de 1 à 6 lettres, différents d'un type à l'autre.");
                    color: Theme.texte-secondaire;
                    wrap: word-wrap;
                }

                Rangee {
                    spacing: 8px;

                    prefixe-devis := Champ {
                        libelle: @tr("Devis");
                    }

                    prefixe-proforma := Champ {
                        libelle: @tr("Proforma");
                    }

                    prefixe-commande := Champ {
                        libelle: @tr("Bon de commande");
                    }
                }

                Rangee {
                    spacing: 8px;

                    prefixe-livraison := Champ {
                        libelle: @tr("Bordereau de livraison");
                    }

                    prefixe-facture := Champ {
                        libelle: @tr("Facture");
                    }

                    prefixe-avoir := Champ {
                        libelle: @tr("Avoir");
                    }
                }

                Rangee {
                    spacing: 12px;

                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 2;

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("Remise à zéro du compteur");
                            font-size: 12px;
                            color: Theme.texte-secondaire;
                        }

                        compteur := ComboBox {
                            model: [@tr("Chaque mois"), @tr("Chaque année")];
                        }
                    }

                    chiffres := Champ {
                        horizontal-stretch: 1;
                        libelle: @tr("Chiffres du rang");
                    }
                }

                Text {
                    horizontal-alignment: Theme.debut;
                    text: ParametresApi.exemple-numero(prefixe-facture.valeur, compteur.current-index == 1, chiffres.valeur);
                    color: Theme.texte-secondaire;
                    wrap: word-wrap;
                }

                Text {
                    horizontal-alignment: Theme.debut;
                    text: @tr("Un changement vaut pour les validations suivantes ; les numéros déjà attribués ne changent pas. Changer de compteur en cours d'année interrompt la suite des numéros de l'année.");
                    font-size: 12px;
                    color: Theme.texte-secondaire;
                    wrap: word-wrap;
                }

                Section {
                    text: @tr("Montant en lettres");
                }

                orthographe := ComboBox {
                    model: [@tr("Orthographe rectifiée (1990)"), @tr("Orthographe traditionnelle")];
                }

                Text {
                    horizontal-alignment: Theme.debut;
                    text: orthographe.current-index == 0 ? ParametresApi.exemple-rectifiee : ParametresApi.exemple-traditionnelle;
                    color: Theme.texte-secondaire;
                    wrap: word-wrap;
                }
                }

                Bloc {
                montre: root.partie == 2;

                Section {
                    text: @tr("Documents imprimés");
                }

                Text {
                    text: @tr("Textes imprimés sur les documents remis aux clients, toujours en français. Un document validé garde les textes, la couleur et les coordonnées de l'entreprise du jour de sa validation.");
                    color: Theme.texte-secondaire;
                    horizontal-alignment: Theme.debut;
                    wrap: word-wrap;
                }

                VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: @tr("Type de document");
                        font-size: 12px;
                        color: Theme.texte-secondaire;
                        horizontal-alignment: Theme.debut;
                    }

                    ComboBox {
                        model: [@tr("Devis"), @tr("Proforma"), @tr("Bon de commande"), @tr("Bordereau de livraison"), @tr("Facture"), @tr("Avoir")];
                        current-index: root.rang-texte;
                        selected => {
                            root.memoriser-textes();
                            root.rang-texte = self.current-index;
                            root.afficher-textes();
                        }
                    }
                }

                titre-doc := Champ {
                    libelle: @tr("Titre imprimé");
                }

                phrase-doc := Champ {
                    libelle: @tr("Phrase avant le montant en lettres (vide : aucune phrase)");
                }

                signataire-doc := Champ {
                    libelle: @tr("Signataire (vide : aucune signature)");
                }

                Rangee {
                    spacing: 8px;

                    dossier-doc := Champ {
                        horizontal-stretch: 1;
                        libelle: @tr("Dossier d'export (vide : choisi à chaque enregistrement)");
                    }

                    VerticalLayout {
                        alignment: end;

                        Bouton {
                            text: @tr("Choisir le dossier");
                            clicked => {
                                dossier-doc.valeur = ParametresApi.choisir-dossier(dossier-doc.valeur);
                            }
                        }
                    }
                }

                Rangee {
                    alignment: start;

                    Bouton {
                        text: @tr("Textes par défaut de ce type");
                        clicked => {
                            root.defaut-demande = 1;
                            Confirmation.demander(@tr("Remplacer le titre, la phrase et le signataire de ce type par les textes par défaut ? Rien n'est enregistré avant « Enregistrer »."), @tr("Remplacer"), false);
                        }
                    }
                }

                Rangee {
                    spacing: 8px;

                    couleur := Champ {
                        horizontal-stretch: 1;
                        libelle: @tr("Couleur principale (code hexadécimal, par exemple #2d3a8c)");
                    }

                    VerticalLayout {
                        alignment: end;

                        Rectangle {
                            width: 36px;
                            height: 36px;
                            background: ParametresApi.couleur-apercu(couleur.valeur);
                            border-width: 1px;
                            border-color: Theme.bordure;
                            border-radius: 4px;
                        }
                    }

                    VerticalLayout {
                        alignment: end;

                        Bouton {
                            text: @tr("Couleur par défaut");
                            clicked => {
                                couleur.valeur = "#2d3a8c";
                            }
                        }
                    }
                }
                }

                Bloc {
                montre: root.partie == 1;

                Section {
                    text: @tr("Paiements");
                }

                modes := Champ {
                    libelle: @tr("Modes de paiement, séparés par des points-virgules");
                }

                // Lettre de relance : masquée quand la licence n'active pas le module Relances.
                Rectangle {
                    height: Modules.relances ? bloc-relance.preferred-height : 0px;
                    visible: Modules.relances;
                    clip: true;

                    bloc-relance := VerticalLayout {
                        width: parent.width;
                        spacing: 12px;

                        Section {
                            text: @tr("Lettre de relance");
                        }

                        Text {
                            text: @tr("Imprimée depuis la page Relances, toujours en français. Dans l'objet et le texte, les champs suivants reçoivent, dans l'ordre, le numéro, la date, l'échéance, le reste dû et les jours de retard de la facture :");
                            color: Theme.texte-secondaire;
                            horizontal-alignment: Theme.debut;
                            wrap: word-wrap;
                        }

                        // Noms de champs, jamais traduits : ils doivent rester tels quels dans le texte.
                        Text {
                            text: "{numero}   {date}   {echeance}   {reste}   {retard}";
                            horizontal-alignment: Theme.debut;
                        }

                        titre-relance := Champ {
                            libelle: @tr("Titre imprimé");
                        }

                        objet-relance := Champ {
                            libelle: @tr("Objet");
                        }

                        VerticalLayout {
                            spacing: 4px;

                            Text {
                                text: @tr("Texte avant le tableau récapitulatif (une ligne vide sépare deux paragraphes)");
                                font-size: 12px;
                                color: Theme.texte-secondaire;
                                horizontal-alignment: Theme.debut;
                                wrap: word-wrap;
                            }

                            avant-relance := TextEdit {
                                height: 110px;
                                wrap: word-wrap;
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;

                            Text {
                                text: @tr("Texte après le tableau récapitulatif");
                                font-size: 12px;
                                color: Theme.texte-secondaire;
                                horizontal-alignment: Theme.debut;
                                wrap: word-wrap;
                            }

                            apres-relance := TextEdit {
                                height: 110px;
                                wrap: word-wrap;
                            }
                        }

                        signataire-relance := Champ {
                            libelle: @tr("Signataire (vide : aucune signature)");
                        }

                        Rangee {
                            alignment: start;

                            Bouton {
                                text: @tr("Texte par défaut de la lettre");
                                clicked => {
                                    root.defaut-demande = 2;
                                    Confirmation.demander(@tr("Remplacer la lettre de relance par le texte par défaut ? Rien n'est enregistré avant « Enregistrer »."), @tr("Remplacer"), false);
                                }
                            }
                        }
                    }
                }
                }

                Rangee {
                    spacing: 12px;
                    alignment: start;

                    Bouton {
                        text: @tr("Enregistrer");
                        primary: true;
                        clicked => {
                            root.memoriser-textes();
                            root.retour = ParametresApi.enregistrer({
                                taux-tva: tva.valeur,
                                taux-remise: remise.valeur,
                                taux-retenue: retenue.valeur,
                                modes-paiement: modes.valeur,
                                orthographe: orthographe.current-index,
                                validite-devis: validite.valeur,
                                delai-paiement: delai.valeur,
                                prefixe-devis: prefixe-devis.valeur,
                                prefixe-proforma: prefixe-proforma.valeur,
                                prefixe-commande: prefixe-commande.valeur,
                                prefixe-livraison: prefixe-livraison.valeur,
                                prefixe-facture: prefixe-facture.valeur,
                                prefixe-avoir: prefixe-avoir.valeur,
                                remise-annuelle: compteur.current-index == 1,
                                chiffres: chiffres.valeur,
                                textes: root.textes,
                                couleur: couleur.valeur,
                                relance: {
                                    titre: titre-relance.valeur,
                                    objet: objet-relance.valeur,
                                    avant: avant-relance.text,
                                    apres: apres-relance.text,
                                    signataire: signataire-relance.valeur,
                                },
                            });
                            Alerte.retour(root.retour);
                            if (root.retour.ok) {
                                root.charger(ParametresApi.ouvrir());
                            }
                        }
                    }
                }

                // Sous le bouton : un texte à la ligne dans une Rangee ferait boucler la mise en page.
                Rectangle {
                    height: 12px;
                }

                MessageRetour {
                    erreurs-seules: true;
                    retour: root.retour;
                }
            }
        }
    }
}

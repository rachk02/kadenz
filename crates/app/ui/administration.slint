// Écrans d'administration : fiche entreprise et logos, paramètres système
// (cahier des charges, sections 5.1 et 5.4).

import { ComboBox, ScrollView } from "std-widgets.slint";
import { Bouton, Champ, MessageRetour, Retour, Section, Theme, Titre } from "composants.slint";

export struct FicheEntrepriseUi {
    nom: string,
    adresse: string,
    telephone: string,
    email: string,
    site-web: string,
    localisation: string,
    regime: string,
    rccm: string,
    ifu: string,
    banque1: string,
    banque2: string,
    responsable-facturation: string,
    responsable-comptabilite: string,
}

export global EntrepriseApi {
    in property <image> logo-principal;
    in property <image> logo-secondaire;
    in property <bool> a-logo-principal;
    in property <bool> a-logo-secondaire;
    callback ouvrir() -> FicheEntrepriseUi;
    callback enregistrer(fiche: FicheEntrepriseUi) -> Retour;
    // Rang du logo : 0 principal, 1 secondaire.
    callback choisir-logo(rang: int) -> Retour;
    callback retirer-logo(rang: int) -> Retour;
}

export struct ParametresUi {
    taux-tva: string,
    taux-remise: string,
    taux-retenue: string,
    modes-paiement: string,
    // 0 rectifiée (1990), 1 traditionnelle.
    orthographe: int,
    validite-devis: string,
    delai-paiement: string,
    // Numérotation : préfixes par type, compteur annuel (sinon mensuel), chiffres du rang.
    prefixe-devis: string,
    prefixe-proforma: string,
    prefixe-commande: string,
    prefixe-livraison: string,
    prefixe-facture: string,
    prefixe-avoir: string,
    remise-annuelle: bool,
    chiffres: string,
}

export global ParametresApi {
    // Exemples d'écriture d'un même montant dans les deux orthographes.
    in property <string> exemple-rectifiee;
    in property <string> exemple-traditionnelle;
    callback ouvrir() -> ParametresUi;
    callback enregistrer(parametres: ParametresUi) -> Retour;
    // Exemple de numéro de facture pour un préfixe, un compteur et un nombre de chiffres.
    pure callback exemple-numero(prefixe: string, annuelle: bool, chiffres: string) -> string;
}

component CadreLogo inherits VerticalLayout {
    in property <string> libelle;
    in property <image> source;
    in property <bool> present;
    in property <Retour> retour;
    callback choisir();
    callback retirer();

    spacing: 8px;

    Text {
        text: root.libelle;
        font-size: 12px;
        color: Theme.texte-secondaire;
    }

    Rectangle {
        height: 110px;
        border-width: 1px;
        border-color: Theme.bordure;
        border-radius: 4px;

        if root.present: Image {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: parent.height - 16px;
            source: root.source;
            image-fit: contain;
        }

        if !root.present: Text {
            text: @tr("Aucun logo");
            color: Theme.texte-secondaire;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        Bouton {
            text: root.present ? @tr("Remplacer") : @tr("Choisir une image");
            clicked => {
                root.choisir();
            }
        }

        if root.present: Bouton {
            text: @tr("Retirer");
            clicked => {
                root.retirer();
            }
        }
    }

    if root.retour.message != "": MessageRetour {
        retour: root.retour;
    }
}

export component PageEntreprise inherits ScrollView {
    property <Retour> retour;
    property <Retour> retour-logo-principal;
    property <Retour> retour-logo-secondaire;

    function charger(f: FicheEntrepriseUi) {
        nom.valeur = f.nom;
        adresse.valeur = f.adresse;
        telephone.valeur = f.telephone;
        email.valeur = f.email;
        site-web.valeur = f.site-web;
        localisation.valeur = f.localisation;
        regime.valeur = f.regime;
        rccm.valeur = f.rccm;
        ifu.valeur = f.ifu;
        banque1.valeur = f.banque1;
        banque2.valeur = f.banque2;
        responsable-facturation.valeur = f.responsable-facturation;
        responsable-comptabilite.valeur = f.responsable-comptabilite;
    }

    function saisie() -> FicheEntrepriseUi {
        {
            nom: nom.valeur,
            adresse: adresse.valeur,
            telephone: telephone.valeur,
            email: email.valeur,
            site-web: site-web.valeur,
            localisation: localisation.valeur,
            regime: regime.valeur,
            rccm: rccm.valeur,
            ifu: ifu.valeur,
            banque1: banque1.valeur,
            banque2: banque2.valeur,
            responsable-facturation: responsable-facturation.valeur,
            responsable-comptabilite: responsable-comptabilite.valeur,
        }
    }

    init => {
        root.charger(EntrepriseApi.ouvrir());
    }

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        alignment: start;

        Titre {
            text: @tr("Entreprise");
        }

        Text {
            text: @tr("Ces informations figurent en en-tête et en pied de page des documents.");
            color: Theme.texte-secondaire;
        }

        HorizontalLayout {
            spacing: 32px;

            GridLayout {
                spacing: 12px;
                horizontal-stretch: 2;

                Row {
                    nom := Champ {
                        libelle: @tr("Nom");
                        colspan: 2;
                    }
                }

                Row {
                    adresse := Champ {
                        libelle: @tr("Adresse");
                    }

                    localisation := Champ {
                        libelle: @tr("Localisation");
                    }
                }

                Row {
                    telephone := Champ {
                        libelle: @tr("Téléphone");
                    }

                    email := Champ {
                        libelle: @tr("Email");
                    }
                }

                Row {
                    site-web := Champ {
                        libelle: @tr("Site web");
                    }

                    regime := Champ {
                        libelle: @tr("Régime d'imposition");
                    }
                }

                Row {
                    rccm := Champ {
                        libelle: @tr("RCCM");
                    }

                    ifu := Champ {
                        libelle: @tr("IFU");
                    }
                }

                Row {
                    banque1 := Champ {
                        libelle: @tr("Compte bancaire 1");
                    }

                    banque2 := Champ {
                        libelle: @tr("Compte bancaire 2");
                    }
                }

                Row {
                    responsable-facturation := Champ {
                        libelle: @tr("Responsable de la facturation");
                    }

                    responsable-comptabilite := Champ {
                        libelle: @tr("Responsable de la comptabilité");
                    }
                }

                Row {
                    HorizontalLayout {
                        colspan: 2;
                        spacing: 12px;
                        alignment: start;

                        Bouton {
                            text: @tr("Enregistrer");
                            primary: true;
                            clicked => {
                                root.retour = EntrepriseApi.enregistrer(root.saisie());
                            }
                        }

                        MessageRetour {
                            retour: root.retour;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            VerticalLayout {
                width: 280px;
                spacing: 16px;
                alignment: start;

                Section {
                    text: @tr("Logos");
                }

                Text {
                    text: @tr("Image PNG ou JPEG, 2 Mo au plus. Le logo principal figure à gauche de l'en-tête, le second à droite.");
                    color: Theme.texte-secondaire;
                    wrap: word-wrap;
                }

                CadreLogo {
                    libelle: @tr("Logo principal");
                    source: EntrepriseApi.logo-principal;
                    present: EntrepriseApi.a-logo-principal;
                    retour: root.retour-logo-principal;
                    choisir => {
                        root.retour-logo-principal = EntrepriseApi.choisir-logo(0);
                    }
                    retirer => {
                        root.retour-logo-principal = EntrepriseApi.retirer-logo(0);
                    }
                }

                CadreLogo {
                    libelle: @tr("Second logo");
                    source: EntrepriseApi.logo-secondaire;
                    present: EntrepriseApi.a-logo-secondaire;
                    retour: root.retour-logo-secondaire;
                    choisir => {
                        root.retour-logo-secondaire = EntrepriseApi.choisir-logo(1);
                    }
                    retirer => {
                        root.retour-logo-secondaire = EntrepriseApi.retirer-logo(1);
                    }
                }
            }
        }
    }
}

export component PageParametres inherits ScrollView {
    property <Retour> retour;

    function charger(p: ParametresUi) {
        tva.valeur = p.taux-tva;
        remise.valeur = p.taux-remise;
        retenue.valeur = p.taux-retenue;
        modes.valeur = p.modes-paiement;
        orthographe.current-index = p.orthographe;
        validite.valeur = p.validite-devis;
        delai.valeur = p.delai-paiement;
        prefixe-devis.valeur = p.prefixe-devis;
        prefixe-proforma.valeur = p.prefixe-proforma;
        prefixe-commande.valeur = p.prefixe-commande;
        prefixe-livraison.valeur = p.prefixe-livraison;
        prefixe-facture.valeur = p.prefixe-facture;
        prefixe-avoir.valeur = p.prefixe-avoir;
        compteur.current-index = p.remise-annuelle ? 1 : 0;
        chiffres.valeur = p.chiffres;
    }

    init => {
        root.charger(ParametresApi.ouvrir());
    }

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        alignment: start;

        Titre {
            text: @tr("Paramètres");
        }

        HorizontalLayout {
            alignment: start;

            VerticalLayout {
                width: 560px;
                spacing: 12px;

                Section {
                    text: @tr("Taux proposés dans les documents");
                }

                Text {
                    text: @tr("Pourcentages séparés par des points-virgules, par exemple « 0 ; 18 » ou « 0 ; 2,5 ; 5 ».");
                    color: Theme.texte-secondaire;
                    wrap: word-wrap;
                }

                tva := Champ {
                    libelle: @tr("TVA (%)");
                }

                remise := Champ {
                    libelle: @tr("Remise (%)");
                }

                retenue := Champ {
                    libelle: @tr("Retenue à la source (%)");
                }

                Section {
                    text: @tr("Paiements");
                }

                modes := Champ {
                    libelle: @tr("Modes de paiement, séparés par des points-virgules");
                }

                Section {
                    text: @tr("Délais (en jours, laisser vide pour ne pas en fixer)");
                }

                HorizontalLayout {
                    spacing: 12px;

                    validite := Champ {
                        libelle: @tr("Validité des devis");
                    }

                    delai := Champ {
                        libelle: @tr("Délai de paiement des factures");
                    }
                }

                Section {
                    text: @tr("Numérotation des documents");
                }

                Text {
                    text: @tr("Préfixes de 1 à 6 lettres, différents d'un type à l'autre.");
                    color: Theme.texte-secondaire;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;

                    prefixe-devis := Champ {
                        libelle: @tr("Devis");
                    }

                    prefixe-proforma := Champ {
                        libelle: @tr("Proforma");
                    }

                    prefixe-commande := Champ {
                        libelle: @tr("Bon de commande");
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    prefixe-livraison := Champ {
                        libelle: @tr("Bordereau de livraison");
                    }

                    prefixe-facture := Champ {
                        libelle: @tr("Facture");
                    }

                    prefixe-avoir := Champ {
                        libelle: @tr("Avoir");
                    }
                }

                HorizontalLayout {
                    spacing: 12px;

                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 2;

                        Text {
                            text: @tr("Remise à zéro du compteur");
                            font-size: 12px;
                            color: Theme.texte-secondaire;
                        }

                        compteur := ComboBox {
                            model: [@tr("Chaque mois"), @tr("Chaque année")];
                        }
                    }

                    chiffres := Champ {
                        horizontal-stretch: 1;
                        libelle: @tr("Chiffres du rang");
                    }
                }

                Text {
                    text: ParametresApi.exemple-numero(prefixe-facture.valeur, compteur.current-index == 1, chiffres.valeur);
                    color: Theme.texte-secondaire;
                    wrap: word-wrap;
                }

                Text {
                    text: @tr("Un changement vaut pour les validations suivantes ; les numéros déjà attribués ne changent pas. Changer de compteur en cours d'année interrompt la suite des numéros de l'année.");
                    font-size: 12px;
                    color: Theme.texte-secondaire;
                    wrap: word-wrap;
                }

                Section {
                    text: @tr("Montant en lettres");
                }

                orthographe := ComboBox {
                    model: [@tr("Orthographe rectifiée (1990)"), @tr("Orthographe traditionnelle")];
                }

                Text {
                    text: orthographe.current-index == 0 ? ParametresApi.exemple-rectifiee : ParametresApi.exemple-traditionnelle;
                    color: Theme.texte-secondaire;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Bouton {
                        text: @tr("Enregistrer");
                        primary: true;
                        clicked => {
                            root.retour = ParametresApi.enregistrer({
                                taux-tva: tva.valeur,
                                taux-remise: remise.valeur,
                                taux-retenue: retenue.valeur,
                                modes-paiement: modes.valeur,
                                orthographe: orthographe.current-index,
                                validite-devis: validite.valeur,
                                delai-paiement: delai.valeur,
                                prefixe-devis: prefixe-devis.valeur,
                                prefixe-proforma: prefixe-proforma.valeur,
                                prefixe-commande: prefixe-commande.valeur,
                                prefixe-livraison: prefixe-livraison.valeur,
                                prefixe-facture: prefixe-facture.valeur,
                                prefixe-avoir: prefixe-avoir.valeur,
                                remise-annuelle: compteur.current-index == 1,
                                chiffres: chiffres.valeur,
                            });
                            if (root.retour.ok) {
                                root.charger(ParametresApi.ouvrir());
                            }
                        }
                    }

                    MessageRetour {
                        retour: root.retour;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: @tr("Les textes des documents, l'apparence des PDF et les dossiers d'export se régleront ici avec le jalon du PDF (J4). La matrice des droits par rôle se règle dans l'écran Utilisateurs.");
                    font-size: 12px;
                    color: Theme.texte-secondaire;
                    wrap: word-wrap;
                }
            }
        }
    }
}

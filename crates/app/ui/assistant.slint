// Assistant de premier lancement (cahier des charges, section 4.1).
// L'étape de licence s'ajoutera en tête au jalon J9. L'import des produits et des
// tiers se fait depuis les écrans Tiers et Produits ; l'étape d'import facultative
// de l'assistant reste à ajouter.

import { CheckBox } from "std-widgets.slint";
import { Bouton, Champ, MessageErreur, Rangee, Theme, Titre } from "composants.slint";

export struct DonneesAssistant {
    nom: string,
    adresse: string,
    telephone: string,
    email: string,
    site-web: string,
    localisation: string,
    regime: string,
    rccm: string,
    ifu: string,
    banque1: string,
    banque2: string,
    responsable-facturation: string,
    responsable-comptabilite: string,
    admin-nom: string,
    admin-identifiant: string,
    admin-mot-de-passe: string,
    taux-tva: string,
    taux-remise: string,
    taux-retenue: string,
    modes-paiement: string,
    orthographe-traditionnelle: bool,
}

export component EcranAssistant inherits Rectangle {
    // Valeurs proposées pour l'étape « Taux et paiements », fournies par l'application.
    in property <string> defaut-taux-tva;
    in property <string> defaut-taux-remise;
    in property <string> defaut-taux-retenue;
    in property <string> defaut-modes-paiement;

    // Renvoie un message d'erreur, ou une chaîne vide si l'installation a réussi.
    callback terminer(DonneesAssistant) -> string;

    property <[string]> etapes: [@tr("Entreprise"), @tr("Administrateur"), @tr("Taux et paiements"), @tr("Récapitulatif")];
    property <int> etape: 0;
    property <string> erreur;

    property <string> nom;
    property <string> adresse;
    property <string> telephone;
    property <string> email;
    property <string> site-web;
    property <string> localisation;
    property <string> regime;
    property <string> rccm;
    property <string> ifu;
    property <string> banque1;
    property <string> banque2;
    property <string> responsable-facturation;
    property <string> responsable-comptabilite;
    property <string> admin-nom;
    property <string> admin-identifiant;
    property <string> admin-mot-de-passe;
    property <string> admin-confirmation;
    property <string> taux-tva: root.defaut-taux-tva;
    property <string> taux-remise: root.defaut-taux-remise;
    property <string> taux-retenue: root.defaut-taux-retenue;
    property <string> modes-paiement: root.defaut-modes-paiement;
    property <bool> orthographe-traditionnelle: false;

    function suivant() {
        if (root.etape == 0 && root.nom == "") {
            root.erreur = @tr("Le nom de l'entreprise est obligatoire.");
        } else if (root.etape == 1 && (root.admin-nom == "" || root.admin-identifiant == "")) {
            root.erreur = @tr("Le nom complet et l'identifiant sont obligatoires.");
        } else if (root.etape == 1 && root.admin-mot-de-passe != root.admin-confirmation) {
            root.erreur = @tr("Les deux mots de passe ne correspondent pas.");
        } else {
            root.erreur = "";
            root.etape += 1;
        }
    }

    background: white;

    Rangee {
        remplit: true;
        // Bandeau de marque : logo Kadenz et étapes, sur le motif Cadence (docs/marque).
        Rectangle {
            width: 240px;
            background: Theme.nuit;
            clip: true;

            Image {
                source: @image-url("icones/motif-cadence.svg");
                width: parent.width;
                height: parent.height;
                image-fit: cover;
            }

            VerticalLayout {
                padding: 28px;
                spacing: 14px;
                alignment: start;

                Image {
                    source: @image-url("icones/kadenz-logo-horizontal-negatif.svg");
                    width: 130px;
                    height: 36px;
                    image-fit: contain;
                    horizontal-alignment: Theme.rtl ? ImageHorizontalAlignment.right : ImageHorizontalAlignment.left;
                }

                Rectangle {
                    height: 20px;
                }

                for nom[i] in root.etapes: Rangee {
                    spacing: 8px;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        cross-axis-self-alignment: CrossAxisAlignment.center;
                        background: i == root.etape ? Theme.ambre : transparent;
                    }

                    Text {
                        horizontal-alignment: Theme.debut;
                        text: nom;
                        font-size: 13px;
                        font-weight: i == root.etape ? 600 : 400;
                        color: i == root.etape ? white : #c5cae0;
                    }
                }
            }
        }

        VerticalLayout {
            alignment: center;

            Rangee {
                alignment: center;

                VerticalLayout {
                    width: 720px;
                    spacing: 16px;
                    padding: 24px;

                    Titre {
                        text: @tr("Première installation");
                    }

                    Text {
                        horizontal-alignment: Theme.debut;
                        text: @tr("Étape {} sur {} : {}", root.etape + 1, root.etapes.length, root.etapes[root.etape]);
                        color: Theme.texte-secondaire;
                    }

                    if root.etape == 0: GridLayout {
                        spacing: 12px;
                        Row {
                            Champ {
                                libelle: @tr("Nom de l'entreprise (obligatoire)");
                                valeur <=> root.nom;
                            }

                            Champ {
                                libelle: @tr("Adresse / boîte postale");
                                valeur <=> root.adresse;
                            }
                        }

                        Row {
                            Champ {
                                libelle: @tr("Téléphone");
                                valeur <=> root.telephone;
                            }

                            Champ {
                                libelle: @tr("Email");
                                valeur <=> root.email;
                            }
                        }

                        Row {
                            Champ {
                                libelle: @tr("Site web");
                                valeur <=> root.site-web;
                            }

                            Champ {
                                libelle: @tr("Localisation");
                                valeur <=> root.localisation;
                            }
                        }

                        Row {
                            Champ {
                                libelle: @tr("Régime d'imposition");
                                valeur <=> root.regime;
                            }

                            Champ {
                                libelle: @tr("RCCM");
                                valeur <=> root.rccm;
                            }
                        }

                        Row {
                            Champ {
                                libelle: @tr("IFU");
                                valeur <=> root.ifu;
                            }

                            Champ {
                                libelle: @tr("Compte bancaire 1");
                                valeur <=> root.banque1;
                            }
                        }

                        Row {
                            Champ {
                                libelle: @tr("Compte bancaire 2");
                                valeur <=> root.banque2;
                            }

                            Champ {
                                libelle: @tr("Responsable facturation");
                                valeur <=> root.responsable-facturation;
                            }
                        }

                        Row {
                            Champ {
                                libelle: @tr("Responsable comptabilité");
                                valeur <=> root.responsable-comptabilite;
                            }
                        }
                    }

                    if root.etape == 1: VerticalLayout {
                        spacing: 12px;

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("Ce compte administre l'installation : utilisateurs, droits, sauvegardes.");
                            color: Theme.texte-secondaire;
                            wrap: word-wrap;
                        }

                        Champ {
                            libelle: @tr("Nom complet");
                            valeur <=> root.admin-nom;
                        }

                        Champ {
                            libelle: @tr("Identifiant de connexion");
                            valeur <=> root.admin-identifiant;
                        }

                        Champ {
                            libelle: @tr("Mot de passe (8 caractères au moins)");
                            secret: true;
                            valeur <=> root.admin-mot-de-passe;
                        }

                        Champ {
                            libelle: @tr("Confirmation du mot de passe");
                            secret: true;
                            valeur <=> root.admin-confirmation;
                        }
                    }

                    if root.etape == 2: VerticalLayout {
                        spacing: 12px;

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("Valeurs séparées par des points-virgules, en pourcentage (ex. 0 ; 18). Modifiables plus tard dans les paramètres.");
                            color: Theme.texte-secondaire;
                            wrap: word-wrap;
                        }

                        Champ {
                            libelle: @tr("Taux de TVA (%)");
                            valeur <=> root.taux-tva;
                        }

                        Champ {
                            libelle: @tr("Taux de remise (%)");
                            valeur <=> root.taux-remise;
                        }

                        Champ {
                            libelle: @tr("Taux de retenue (%)");
                            valeur <=> root.taux-retenue;
                        }

                        Champ {
                            libelle: @tr("Modes de paiement");
                            valeur <=> root.modes-paiement;
                        }

                        CheckBox {
                            text: @tr("Montant en lettres en orthographe traditionnelle (sinon : orthographe rectifiée de 1990)");
                            checked <=> root.orthographe-traditionnelle;
                        }
                    }

                    if root.etape == 3: VerticalLayout {
                        spacing: 8px;

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("Entreprise : {}", root.nom);
                            color: Theme.texte;
                        }

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("Administrateur : {} ({})", root.admin-nom, root.admin-identifiant);
                            color: Theme.texte;
                        }

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("TVA : {}   Remise : {}   Retenue : {}", root.taux-tva, root.taux-remise, root.taux-retenue);
                            color: Theme.texte;
                        }

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("Modes de paiement : {}", root.modes-paiement);
                            color: Theme.texte;
                            wrap: word-wrap;
                        }

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("Montant en lettres : {}", root.orthographe-traditionnelle ? @tr("orthographe traditionnelle") : @tr("orthographe rectifiée"));
                            color: Theme.texte;
                        }
                    }

                    if root.erreur != "": MessageErreur {
                        text: root.erreur;
                    }

                    Rangee {
                        spacing: 8px;
                        alignment: end;

                        if root.etape > 0: Bouton {
                            text: @tr("Précédent");
                            clicked => {
                                root.erreur = "";
                                root.etape -= 1;
                            }
                        }

                        if root.etape < root.etapes.length - 1: Bouton {
                            text: @tr("Suivant");
                            primary: true;
                            clicked => {
                                root.suivant();
                            }
                        }

                        if root.etape == root.etapes.length - 1: Bouton {
                            text: @tr("Terminer l'installation");
                            primary: true;
                            clicked => {
                                root.erreur = root.terminer({
                                    nom: root.nom,
                                    adresse: root.adresse,
                                    telephone: root.telephone,
                                    email: root.email,
                                    site-web: root.site-web,
                                    localisation: root.localisation,
                                    regime: root.regime,
                                    rccm: root.rccm,
                                    ifu: root.ifu,
                                    banque1: root.banque1,
                                    banque2: root.banque2,
                                    responsable-facturation: root.responsable-facturation,
                                    responsable-comptabilite: root.responsable-comptabilite,
                                    admin-nom: root.admin-nom,
                                    admin-identifiant: root.admin-identifiant,
                                    admin-mot-de-passe: root.admin-mot-de-passe,
                                    taux-tva: root.taux-tva,
                                    taux-remise: root.taux-remise,
                                    taux-retenue: root.taux-retenue,
                                    modes-paiement: root.modes-paiement,
                                    orthographe-traditionnelle: root.orthographe-traditionnelle,
                                });
                            }
                        }
                    }
                }
            }
        }
    }
}

// Assistant de premier lancement (cahier des charges, section 4.1).
// L'étape de licence est en tête (jalon J9) : clé facultative. L'import des produits et des
// tiers se fait depuis les écrans Tiers et Produits ; l'étape d'import facultative
// de l'assistant reste à ajouter.
// Mode serveur (phase 2, jalon F4) : le même assistant installe l'entreprise dans la
// fenêtre d'administration du serveur. La licence d'abonnement y est liée à
// l'entreprise ; sans elle, le serveur reste en lecture seule avec un seul poste
// permis, pour l'installer plus tard depuis ce poste (décisions 40 et 41).
// LicenceApi.poste porte alors l'identifiant de l'entreprise, et la restauration
// attend le jalon F7. Une étape « Sauvegardes » demande le dossier, l'heure et le
// mot de passe des sauvegardes du serveur (décision 56).

import { ScrollView } from "std-widgets.slint";
import { Bouton, Case, Champ, ChampCode, MessageErreur, Rangee, Section, Theme } from "composants.slint";
import { GrandTitre } from "connexion.slint";
import { MotifTournant } from "motifs-ecrans.slint";
import { ActivationUi, IdentifiantPoste, LicenceApi, SaisieCle, VerificationUi } from "licence.slint";
import { RestaurationFichier, SauvegardesApi } from "sauvegardes.slint";

export struct DonneesAssistant {
    nom: string,
    adresse: string,
    telephone: string,
    email: string,
    site-web: string,
    localisation: string,
    regime: string,
    rccm: string,
    ifu: string,
    banque1: string,
    banque2: string,
    responsable-facturation: string,
    responsable-comptabilite: string,
    admin-nom: string,
    admin-identifiant: string,
    admin-mot-de-passe: string,
    taux-tva: string,
    taux-remise: string,
    taux-retenue: string,
    modes-paiement: string,
    orthographe-traditionnelle: bool,
    // Clé de licence vérifiée à la première étape, vide pour le socle seul.
    cle-licence: string,
    // Sauvegardes du serveur (mode serveur seulement, décision 56).
    sauvegarde-dossier: string,
    sauvegarde-heure: string,
    sauvegarde-mot-de-passe: string,
}

export component EcranAssistant inherits Rectangle {
    // Valeurs proposées pour l'étape « Taux et paiements », fournies par l'application.
    in property <string> defaut-taux-tva;
    in property <string> defaut-taux-remise;
    in property <string> defaut-taux-retenue;
    in property <string> defaut-modes-paiement;

    // Fenêtre d'administration du serveur (voir l'en-tête).
    in property <bool> serveur: false;
    // Édition monoposte (docs/spec-monoposte.md, section 3) : avec `serveur`, le
    // même parcours sur le serveur intégré à l'application ; seuls des textes
    // changent (pas de service, un seul poste).
    in property <bool> monoposte: false;
    // Réglage proposé pour les sauvegardes du serveur, et choix d'un dossier
    // (rend le dossier choisi, ou le dossier actuel si le choix est abandonné).
    in property <string> defaut-dossier-sauvegardes;
    in property <string> defaut-heure-sauvegardes;
    callback choisir-dossier-sauvegardes(actuel: string) -> string;

    // Renvoie un message d'erreur, ou une chaîne vide si l'installation a réussi.
    callback terminer(DonneesAssistant) -> string;

    property <[string]> etapes: root.serveur
        ? [@tr("Licence"), @tr("Entreprise"), @tr("Administrateur"), @tr("Taux et paiements"), @tr("Sauvegardes"), @tr("Récapitulatif")]
        : [@tr("Licence"), @tr("Entreprise"), @tr("Administrateur"), @tr("Taux et paiements"), @tr("Récapitulatif")];
    property <int> recapitulatif: root.etapes.length - 1;
    property <int> etape: 0;
    property <string> erreur;
    property <string> cle-licence;
    // Résumé de la clé vérifiée (client et modules), vide sans clé.
    property <string> resume-licence;
    // Serveur (décision 74) : code de licence court, activé auprès du portail au
    // passage de l'étape Entreprise (le portail a besoin de la raison sociale) ;
    // la licence reçue remplit alors cle-licence.
    property <string> code-licence;
    property <bool> code-valide;
    property <int> etat-activation: ActivationUi.etat;
    changed etat-activation => {
        if (root.etape != 1) {
            return;
        }
        if (root.etat-activation == 2) {
            root.cle-licence = ActivationUi.licence;
            root.resume-licence = ActivationUi.resume;
            root.erreur = "";
            root.etape = 2;
        } else if (root.etat-activation == 3) {
            root.erreur = ActivationUi.message;
            root.etape = 0;
        }
    }
    property <VerificationUi> verification;

    property <string> nom;
    property <string> adresse;
    property <string> telephone;
    property <string> email;
    property <string> site-web;
    property <string> localisation;
    property <string> regime;
    property <string> rccm;
    property <string> ifu;
    property <string> banque1;
    property <string> banque2;
    property <string> responsable-facturation;
    property <string> responsable-comptabilite;
    property <string> admin-nom;
    property <string> admin-identifiant;
    property <string> admin-mot-de-passe;
    property <string> admin-confirmation;
    property <string> taux-tva: root.defaut-taux-tva;
    property <string> taux-remise: root.defaut-taux-remise;
    property <string> taux-retenue: root.defaut-taux-retenue;
    property <string> modes-paiement: root.defaut-modes-paiement;
    // Orthographe traditionnelle par défaut (décision de l'utilisateur du 2026-11-11).
    property <bool> orthographe-traditionnelle: true;
    property <string> sauvegarde-dossier: root.defaut-dossier-sauvegardes;
    property <string> sauvegarde-heure: root.defaut-heure-sauvegardes;
    property <string> sauvegarde-mot-de-passe;
    property <string> sauvegarde-confirmation;
    // Étape Entreprise : champs facultatifs dépliés.
    property <bool> plus-ouvert: false;

    function suivant() {
        if (!root.serveur && root.etape == 0 && root.cle-licence != "") {
            root.verification = LicenceApi.verifier(root.cle-licence);
        }
        if (!root.serveur && root.etape == 0 && root.cle-licence != "" && !root.verification.ok) {
            root.erreur = root.verification.message;
            root.resume-licence = "";
        } else if (root.serveur && root.etape == 0 && root.code-licence != "" && !root.code-valide) {
            root.erreur = @tr("Le code de licence est incomplet ou erroné : corrigez-le, ou videz le champ pour continuer sans licence.");
        } else if (root.etape == 1 && root.nom == "") {
            root.erreur = @tr("Le nom de l'entreprise est obligatoire.");
        } else if (root.serveur && root.etape == 1 && root.code-licence != "" && root.cle-licence == "") {
            // Activation en ligne ; la suite vient de changed etat-activation.
            root.erreur = "";
            ActivationUi.activer(root.code-licence, root.nom);
        } else if (root.etape == 2 && (root.admin-nom == "" || root.admin-identifiant == "")) {
            root.erreur = @tr("Le nom complet et l'identifiant sont obligatoires.");
        } else if (root.etape == 2 && root.admin-mot-de-passe != root.admin-confirmation) {
            root.erreur = @tr("Les deux mots de passe ne correspondent pas.");
        } else if (root.serveur && root.etape == 4 && (root.sauvegarde-dossier == "" || root.sauvegarde-heure == "")) {
            root.erreur = @tr("Le dossier et l'heure des sauvegardes sont obligatoires.");
        } else if (root.serveur && root.etape == 4 && root.sauvegarde-mot-de-passe.character-count < 8) {
            root.erreur = @tr("Le mot de passe des sauvegardes doit compter au moins 8 caractères.");
        } else if (root.serveur && root.etape == 4 && root.sauvegarde-mot-de-passe != root.sauvegarde-confirmation) {
            root.erreur = @tr("Les deux mots de passe ne correspondent pas.");
        } else {
            if (!root.serveur && root.etape == 0) {
                root.resume-licence = root.cle-licence == "" ? "" : root.verification.message;
            }
            root.erreur = "";
            root.etape += 1;
        }
    }

    background: Theme.fond;

    // Refonte du 2026-11-18 (docs/marque/propositions-2026-11-18-refonte-ecrans) : le bloc
    // de l'étape reste à la même place et à la même largeur à toutes les étapes ; il défile
    // s'il dépasse, les boutons restent fixes dans la bande du bas.
    property <length> marge: 68px;
    property <length> haut: 72px;
    property <length> bande: 100px;

    Rangee {
        remplit: true;

        // Colonne de marque : logo, étapes (faites cochées, en cours marquée d'un carré
        // ambre) et, en bas, le motif C Tournant qui avance à chaque étape, sur Nuit.
        Rectangle {
            width: 232px;
            background: Theme.nuit;
            clip: true;

            MotifTournant {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                etape: root.etape;
            }

            VerticalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-top: 44px;
                spacing: 0px;
                alignment: start;

                Image {
                    source: @image-url("icones/kadenz-logo-horizontal-negatif.svg");
                    width: 120px;
                    height: 26px;
                    image-fit: contain;
                    horizontal-alignment: Theme.rtl ? ImageHorizontalAlignment.right : ImageHorizontalAlignment.left;
                }

                Rectangle { height: 62px; }

                Text {
                    horizontal-alignment: Theme.debut;
                    text: @tr("PREMIÈRE INSTALLATION");
                    font-size: 12px;
                    font-weight: 600;
                    letter-spacing: 1.2px;
                    color: #c5cae0;
                    // Colonne étroite : le titre passe à la ligne plutôt que d'être coupé.
                    wrap: word-wrap;
                }

                Rectangle { height: 14px; }

                for nom[i] in root.etapes: Rangee {
                    height: 34px;
                    spacing: 12px;

                    Rectangle {
                        width: 12px;
                        cross-axis-self-alignment: CrossAxisAlignment.center;
                        height: 12px;

                        if i < root.etape: Path {
                            width: 12px;
                            height: 12px;
                            viewbox-width: 12;
                            viewbox-height: 12;
                            commands: "M 1.5 6.5 L 4.5 9.5 L 10.5 2.5";
                            stroke: Theme.ambre;
                            stroke-width: 2px;
                        }

                        if i == root.etape: Rectangle {
                            x: 2px;
                            y: 2px;
                            width: 8px;
                            height: 8px;
                            background: Theme.ambre;
                        }
                    }

                    Text {
                        vertical-alignment: center;
                        horizontal-alignment: Theme.debut;
                        text: nom;
                        font-size: 14.5px;
                        font-weight: i == root.etape ? 600 : 400;
                        color: i == root.etape ? white : i < root.etape ? #c5cae0 : #8c94c2;
                    }
                }
            }
        }

        zone := Rectangle {
            horizontal-stretch: 1;

            property <length> largeur: min(620px, self.width - 2 * root.marge);

            ScrollView {
                x: Theme.rtl ? parent.width - self.width - root.marge + 12px : root.marge - 12px;
                y: root.haut;
                width: parent.largeur + 24px;
                height: parent.height - root.haut - root.bande - 8px;
                content-width: self.visible-width;
                content-height: corps.preferred-height + 24px;

                corps := VerticalLayout {
                    x: 12px;
                    width: parent.width - 24px;
                    spacing: 20px;
                    alignment: start;

                    GrandTitre {
                        text: root.etapes[root.etape];
                    }

                    if root.etape == 0: VerticalLayout {
                        spacing: 16px;

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: root.monoposte
                                ? @tr("Saisissez le code de licence reçu avec l'abonnement. Il est activé en ligne, auprès du portail de Kadenz, au passage de l'étape Entreprise : une connexion à Internet est nécessaire. Sans code, Kadenz reste en lecture seule jusqu'à l'activation d'un code, dans les Paramètres, rubrique « Abonnement ».")
                                : root.serveur
                                ? @tr("Saisissez le code de licence reçu avec l'abonnement. Il est activé en ligne, auprès du portail de Kadenz, au passage de l'étape Entreprise : une connexion à Internet est nécessaire. Sans code, le serveur reste en lecture seule et un seul poste peut s'inscrire.")
                                : @tr("La licence est liée à ce poste. Transmettez l'identifiant ci-dessous pour recevoir la clé, puis collez-la ici. Sans clé, seul le socle est disponible : tiers, produits, factures, avoirs et administration. La clé peut aussi être saisie plus tard, dans les Paramètres.");
                            font-size: 15px;
                            color: Theme.texte-secondaire;
                            wrap: word-wrap;
                        }

                        Section {
                            text: root.serveur ? @tr("Identifiant de l'entreprise") : @tr("Identifiant du poste");
                        }

                        IdentifiantPoste { }

                        if !root.serveur: SaisieCle {
                            cle <=> root.cle-licence;
                        }

                        if root.serveur: ChampCode {
                            libelle: @tr("Code de licence");
                            init => {
                                self.remplir(root.code-licence);
                            }
                            changed code => {
                                // Un autre code : la licence reçue ne vaut plus.
                                if (self.code != root.code-licence) {
                                    root.code-licence = self.code;
                                    root.cle-licence = "";
                                    root.resume-licence = "";
                                    root.erreur = "";
                                }
                                root.code-valide = self.valide;
                            }
                            valide-entree => {
                                root.suivant();
                            }
                        }

                        if root.serveur: Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("Vous pourrez aussi l'installer plus tard.");
                            font-size: 12.5px;
                            color: Theme.texte-secondaire;
                        }

                        // Réinstallation : reprendre une sauvegarde au lieu de tout ressaisir.
                        // Sur le serveur, la restauration passe par la fenêtre du serveur.
                        if !root.serveur: Section {
                            text: @tr("Données d'une installation précédente");
                        }

                        if !root.serveur: Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("Vous avez une sauvegarde de Kadenz ? Restaurez-la pour retrouver l'entreprise, les comptes et les documents, sans passer par les étapes suivantes.");
                            color: Theme.texte-secondaire;
                            wrap: word-wrap;
                        }

                        if !root.serveur: RestaurationFichier {
                            bouton-principal: false;
                            question: @tr("Restaurer cette sauvegarde ? L'installation neuve est remplacée par les données de la sauvegarde.");
                            choisir-fichier => {
                                SauvegardesApi.choisir-fichier()
                            }
                            restaurer-fichier(chemin, mot-de-passe) => {
                                SauvegardesApi.restaurer-installation-neuve(chemin, mot-de-passe)
                            }
                        }
                    }

                    // Entreprise : six champs visibles (nom, adresse, téléphone et email, RCCM
                    // et IFU), les sept autres repliés (décision de l'utilisateur du 2026-11-18).
                    if root.etape == 1: VerticalLayout {
                        spacing: 16px;

                        Champ {
                            libelle: @tr("Nom de l'entreprise (obligatoire)");
                            valeur <=> root.nom;
                        }

                        Champ {
                            libelle: @tr("Adresse / boîte postale");
                            valeur <=> root.adresse;
                        }

                        HorizontalLayout {
                            spacing: 16px;
                            Champ {
                                width: (parent.width - 16px) / 2;
                                libelle: @tr("Téléphone");
                                valeur <=> root.telephone;
                            }

                            Champ {
                                width: (parent.width - 16px) / 2;
                                libelle: @tr("Email");
                                valeur <=> root.email;
                            }
                        }

                        HorizontalLayout {
                            spacing: 16px;
                            Champ {
                                width: (parent.width - 16px) / 2;
                                libelle: @tr("RCCM");
                                valeur <=> root.rccm;
                            }

                            Champ {
                                width: (parent.width - 16px) / 2;
                                libelle: @tr("IFU");
                                valeur <=> root.ifu;
                            }
                        }

                        Rectangle {
                            height: 42px;
                            background: Theme.fond-lateral;
                            border-width: 1px;
                            border-color: Theme.bordure;
                            border-radius: 4px;

                            Rangee {
                                padding-left: 14px;
                                padding-right: 14px;

                                Text {
                                    vertical-alignment: center;
                                    horizontal-alignment: Theme.debut;
                                    text: @tr("Plus d'informations");
                                    font-size: 14px;
                                    color: Theme.texte;
                                }

                                Rectangle { horizontal-stretch: 1; }

                                Text {
                                    vertical-alignment: center;
                                    text: root.plus-ouvert ? @tr("Replier") : @tr("{} champs facultatifs", 7);
                                    font-size: 13px;
                                    color: Theme.texte-secondaire;
                                }
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.plus-ouvert = !root.plus-ouvert;
                                }
                            }
                        }

                        if !root.plus-ouvert: Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("Tout se modifie plus tard dans les Paramètres.");
                            font-size: 12.5px;
                            color: Theme.texte-secondaire;
                        }

                        if root.plus-ouvert: VerticalLayout {
                            spacing: 16px;

                            HorizontalLayout {
                                spacing: 16px;
                                Champ {
                                    width: (parent.width - 16px) / 2;
                                    libelle: @tr("Localisation");
                                    valeur <=> root.localisation;
                                }

                                Champ {
                                    width: (parent.width - 16px) / 2;
                                    libelle: @tr("Site web");
                                    valeur <=> root.site-web;
                                }
                            }

                            Champ {
                                libelle: @tr("Régime d'imposition");
                                valeur <=> root.regime;
                            }

                            HorizontalLayout {
                                spacing: 16px;
                                Champ {
                                    width: (parent.width - 16px) / 2;
                                    libelle: @tr("Compte bancaire 1");
                                    valeur <=> root.banque1;
                                }

                                Champ {
                                    width: (parent.width - 16px) / 2;
                                    libelle: @tr("Compte bancaire 2");
                                    valeur <=> root.banque2;
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;
                                Champ {
                                    width: (parent.width - 16px) / 2;
                                    libelle: @tr("Responsable facturation");
                                    valeur <=> root.responsable-facturation;
                                }

                                Champ {
                                    width: (parent.width - 16px) / 2;
                                    libelle: @tr("Responsable comptabilité");
                                    valeur <=> root.responsable-comptabilite;
                                }
                            }
                        }
                    }

                    if root.etape == 2: VerticalLayout {
                        spacing: 16px;

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("Ce compte administre l'installation : utilisateurs, droits, sauvegardes.");
                            font-size: 15px;
                            color: Theme.texte-secondaire;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 16px;
                            Champ {
                                width: (parent.width - 16px) / 2;
                                libelle: @tr("Nom complet");
                                valeur <=> root.admin-nom;
                            }

                            Champ {
                                width: (parent.width - 16px) / 2;
                                libelle: @tr("Identifiant de connexion");
                                valeur <=> root.admin-identifiant;
                            }
                        }

                        HorizontalLayout {
                            spacing: 16px;
                            Champ {
                                width: (parent.width - 16px) / 2;
                                libelle: @tr("Mot de passe");
                                secret: true;
                                valeur <=> root.admin-mot-de-passe;
                            }

                            Champ {
                                width: (parent.width - 16px) / 2;
                                libelle: @tr("Confirmation du mot de passe");
                                secret: true;
                                valeur <=> root.admin-confirmation;
                            }
                        }

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("8 caractères au moins.");
                            font-size: 12.5px;
                            color: Theme.texte-secondaire;
                        }
                    }

                    if root.etape == 3: VerticalLayout {
                        spacing: 16px;

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("En pourcentage, séparés par des points-virgules. Modifiables plus tard.");
                            font-size: 15px;
                            color: Theme.texte-secondaire;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 16px;
                            Champ {
                                width: (parent.width - 32px) / 3;
                                libelle: @tr("Taux de TVA (%)");
                                valeur <=> root.taux-tva;
                            }

                            Champ {
                                width: (parent.width - 32px) / 3;
                                libelle: @tr("Taux de remise (%)");
                                valeur <=> root.taux-remise;
                            }

                            Champ {
                                width: (parent.width - 32px) / 3;
                                libelle: @tr("Taux de retenue (%)");
                                valeur <=> root.taux-retenue;
                            }
                        }

                        Champ {
                            libelle: @tr("Modes de paiement");
                            valeur <=> root.modes-paiement;
                        }

                        Case {
                            text: @tr("Montant en lettres en orthographe traditionnelle (sinon : orthographe rectifiée de 1990)");
                            checked <=> root.orthographe-traditionnelle;
                        }
                    }

                    if root.serveur && root.etape == 4: VerticalLayout {
                        spacing: 16px;

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: root.monoposte
                                ? @tr("Sauvegarde chiffrée chaque jour, Kadenz ouvert, et à chaque fermeture. Sans ce mot de passe, aucune sauvegarde ne peut être restaurée, et l'éditeur ne peut pas le retrouver : notez-le en lieu sûr.")
                                : @tr("Sauvegarde chiffrée chaque jour et à l'arrêt du service. Sans ce mot de passe, aucune sauvegarde ne peut être restaurée, et l'éditeur ne peut pas le retrouver : notez-le en lieu sûr.");
                            font-size: 15px;
                            color: Theme.texte-secondaire;
                            wrap: word-wrap;
                        }

                        VerticalLayout {
                            spacing: 6px;

                            Rangee {
                                spacing: 10px;

                                Champ {
                                    horizontal-stretch: 1;
                                    libelle: @tr("Dossier des sauvegardes");
                                    valeur <=> root.sauvegarde-dossier;
                                }

                                VerticalLayout {
                                    alignment: end;

                                    Bouton {
                                        text: @tr("Choisir un dossier");
                                        clicked => {
                                            root.sauvegarde-dossier = root.choisir-dossier-sauvegardes(root.sauvegarde-dossier);
                                        }
                                    }
                                }
                            }

                            Text {
                                horizontal-alignment: Theme.debut;
                                text: @tr("De préférence sur un autre disque (externe ou partage réseau).");
                                font-size: 12.5px;
                                color: Theme.texte-secondaire;
                            }
                        }

                        Champ {
                            libelle: @tr("Heure de la sauvegarde quotidienne (HH:MM)");
                            valeur <=> root.sauvegarde-heure;
                        }

                        HorizontalLayout {
                            spacing: 16px;
                            Champ {
                                width: (parent.width - 16px) / 2;
                                libelle: @tr("Mot de passe des sauvegardes");
                                secret: true;
                                valeur <=> root.sauvegarde-mot-de-passe;
                            }

                            Champ {
                                width: (parent.width - 16px) / 2;
                                libelle: @tr("Confirmation du mot de passe");
                                secret: true;
                                valeur <=> root.sauvegarde-confirmation;
                            }
                        }

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("8 caractères au moins.");
                            font-size: 12.5px;
                            color: Theme.texte-secondaire;
                        }
                    }

                    if root.etape == root.recapitulatif: VerticalLayout {
                        spacing: 10px;

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: root.resume-licence != "" ? @tr("Licence : {}", root.resume-licence)
                                : root.monoposte ? @tr("Licence : aucune pour l'instant, lecture seule")
                                : root.serveur ? @tr("Licence : aucune pour l'instant, serveur en lecture seule")
                                : @tr("Licence : aucune clé, socle seul");
                            color: Theme.texte;
                            wrap: word-wrap;
                        }

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("Entreprise : {}", root.nom);
                            color: Theme.texte;
                        }

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("Administrateur : {} ({})", root.admin-nom, root.admin-identifiant);
                            color: Theme.texte;
                        }

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("TVA : {}   Remise : {}   Retenue : {}", root.taux-tva, root.taux-remise, root.taux-retenue);
                            color: Theme.texte;
                        }

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("Modes de paiement : {}", root.modes-paiement);
                            color: Theme.texte;
                            wrap: word-wrap;
                        }

                        Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("Montant en lettres : {}", root.orthographe-traditionnelle ? @tr("orthographe traditionnelle") : @tr("orthographe rectifiée"));
                            color: Theme.texte;
                        }

                        if root.serveur: Text {
                            horizontal-alignment: Theme.debut;
                            text: @tr("Sauvegardes : chaque jour à {}, dans {}", root.sauvegarde-heure, root.sauvegarde-dossier);
                            color: Theme.texte;
                            wrap: word-wrap;
                        }
                    }

                    if root.erreur != "": MessageErreur {
                        text: root.erreur;
                    }
                }
            }

            // Bande du bas : boutons à place fixe.
            Rectangle {
                x: 0;
                y: parent.height - root.bande;
                width: parent.width;
                height: root.bande;
                background: Theme.fond-lateral;

                Rangee {
                    x: Theme.rtl ? parent.width - self.width - root.marge : root.marge;
                    y: (parent.height - 40px) / 2;
                    width: zone.largeur;
                    height: 40px;
                    spacing: 10px;

                    if root.etape > 0: Bouton {
                        text: @tr("Précédent");
                        enabled: !(ActivationUi.etat == 1 && root.etape == 1);
                        clicked => {
                            root.erreur = "";
                            root.etape -= 1;
                        }
                    }

                    Rectangle { }

                    if root.etape < root.etapes.length - 1: Bouton {
                        text: ActivationUi.etat == 1 && root.etape == 1 ? @tr("Activation de la licence…") : @tr("Suivant");
                        enabled: !(ActivationUi.etat == 1 && root.etape == 1);
                        primary: true;
                        clicked => {
                            root.suivant();
                        }
                    }

                    if root.etape == root.etapes.length - 1: Bouton {
                        text: @tr("Terminer l'installation");
                        primary: true;
                        clicked => {
                            root.erreur = root.terminer({
                                nom: root.nom,
                                adresse: root.adresse,
                                telephone: root.telephone,
                                email: root.email,
                                site-web: root.site-web,
                                localisation: root.localisation,
                                regime: root.regime,
                                rccm: root.rccm,
                                ifu: root.ifu,
                                banque1: root.banque1,
                                banque2: root.banque2,
                                responsable-facturation: root.responsable-facturation,
                                responsable-comptabilite: root.responsable-comptabilite,
                                admin-nom: root.admin-nom,
                                admin-identifiant: root.admin-identifiant,
                                admin-mot-de-passe: root.admin-mot-de-passe,
                                taux-tva: root.taux-tva,
                                taux-remise: root.taux-remise,
                                taux-retenue: root.taux-retenue,
                                modes-paiement: root.modes-paiement,
                                orthographe-traditionnelle: root.orthographe-traditionnelle,
                                cle-licence: root.cle-licence,
                                sauvegarde-dossier: root.sauvegarde-dossier,
                                sauvegarde-heure: root.sauvegarde-heure,
                                sauvegarde-mot-de-passe: root.serveur ? root.sauvegarde-mot-de-passe : "",
                            });
                        }
                    }
                }
            }
        }
    }
}

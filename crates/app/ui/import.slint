// Panneau d'import des tiers ou des produits : aperçu ligne par ligne, puis
// enregistrement des seules lignes valides (cahier des charges, section 6.8).

import { ComboBox, StandardTableView } from "std-widgets.slint";
import { Bouton, MessageRetour, Rangee, Retour, Theme, Titre } from "composants.slint";

export global ImportApi {
    in property <bool> actif;
    in property <string> titre;
    in property <string> fichier;
    // Message d'erreur de lecture ou d'analyse ; l'aperçu est alors vide.
    in property <string> erreur;
    in property <string> libelle-defaut;
    in property <[string]> choix-defaut;
    in-out property <int> defaut;
    in property <[[StandardListViewItem]]> lignes;
    in property <string> resume;
    in property <string> colonnes;
    in property <bool> peut-importer;
    in-out property <Retour> retour;
    // Cible : 0 tiers, 1 produits.
    callback demarrer(cible: int);
    callback choisir-fichier();
    callback changer-defaut(rang: int);
    callback importer();
    callback fermer();
}

export component PanneauImport inherits Rectangle {
    background: white;

    // Les clics ne doivent pas atteindre l'écran recouvert.
    TouchArea { }

    VerticalLayout {
        padding: 24px;
        spacing: 12px;

        Titre {
            text: ImportApi.titre;
        }

        Rangee {
            spacing: 8px;

            Text {
                horizontal-alignment: Theme.debut;
                text: ImportApi.fichier == "" ? @tr("Aucun fichier choisi.") : @tr("Fichier : {}", ImportApi.fichier);
                color: Theme.texte;
                vertical-alignment: center;
                overflow: elide;
            }

            Bouton {
                text: @tr("Choisir un autre fichier");
                clicked => {
                    ImportApi.choisir-fichier();
                }
            }
        }

        if ImportApi.erreur != "": Text {
            horizontal-alignment: Theme.debut;
            text: ImportApi.erreur;
            color: Theme.erreur;
            wrap: word-wrap;
        }

        if ImportApi.erreur == "": Rangee {
            spacing: 8px;
            alignment: start;

            Text {
                horizontal-alignment: Theme.debut;
                text: ImportApi.libelle-defaut;
                color: Theme.texte-secondaire;
                vertical-alignment: center;
            }

            ComboBox {
                width: 220px;
                model: ImportApi.choix-defaut;
                current-index <=> ImportApi.defaut;
                selected => {
                    ImportApi.changer-defaut(self.current-index);
                }
            }
        }

        if ImportApi.erreur == "": Text {
            horizontal-alignment: Theme.debut;
            text: ImportApi.colonnes;
            font-size: 12px;
            color: Theme.texte-secondaire;
            wrap: word-wrap;
        }

        StandardTableView {
            // De droite à gauche, colonnes en ordre inverse (cellules inversées dans modele_lignes).
            columns: Theme.rtl ? [
                { title: @tr("Remarque"), min-width: 220px, horizontal-stretch: 3 },
                { title: @tr("Fiche"), min-width: 200px, horizontal-stretch: 2 },
                { title: @tr("État"), min-width: 100px, horizontal-stretch: 0 },
                { title: @tr("Ligne"), min-width: 60px, horizontal-stretch: 0 },
            ] : [
                { title: @tr("Ligne"), min-width: 60px, horizontal-stretch: 0 },
                { title: @tr("État"), min-width: 100px, horizontal-stretch: 0 },
                { title: @tr("Fiche"), min-width: 200px, horizontal-stretch: 2 },
                { title: @tr("Remarque"), min-width: 220px, horizontal-stretch: 3 },
            ];
            rows: ImportApi.lignes;
        }

        Text {
            horizontal-alignment: Theme.debut;
            text: ImportApi.resume;
            color: Theme.texte;
            wrap: word-wrap;
        }

        Rangee {
            spacing: 8px;
            alignment: start;

            if ImportApi.peut-importer: Bouton {
                text: @tr("Importer les fiches valides");
                primary: true;
                clicked => {
                    ImportApi.importer();
                }
            }

            Bouton {
                text: ImportApi.peut-importer ? @tr("Annuler") : @tr("Fermer");
                clicked => {
                    ImportApi.fermer();
                }
            }
        }

        // Sous les boutons : un texte à la ligne dans une Rangee ferait boucler la mise en page.
        MessageRetour {
            retour: ImportApi.retour;
        }
    }
}

import { LineEdit } from "std-widgets.slint";

// Polices de la marque (docs/marque), SIL Open Font License 1.1 : Inter pour le texte,
// Manrope pour les titres. Instances statiques réduites au latin, embarquées dans l'exécutable.
import "polices/Inter-Regular.ttf";
import "polices/Inter-Medium.ttf";
import "polices/Inter-SemiBold.ttf";
import "polices/Inter-Bold.ttf";
import "polices/Manrope-Bold.ttf";
import "polices/Manrope-ExtraBold.ttf";

export global Theme {
    // Interface en chinois : Inter et Manrope n'ont pas les idéogrammes, et la police
    // de secours choisie par Windows est japonaise, sans les caractères simplifiés.
    // Microsoft YaHei, livrée avec Windows, couvre le chinois simplifié et le latin.
    in property <bool> chinois: false;
    out property <string> police-texte: root.chinois ? "Microsoft YaHei UI" : root.rtl ? "Segoe UI" : "Inter";
    out property <string> police-titre: root.chinois ? "Microsoft YaHei UI" : root.rtl ? "Segoe UI" : "Manrope";

    // Sens de lecture, déduit de la traduction : seul ar.po traduit « ltr » par « rtl ».
    // De droite à gauche, les écrans sont mis en miroir : rangées inversées (Rangee),
    // textes alignés à droite (debut), menu et panneaux de marque à droite.
    // Arabe : Segoe UI, livrée avec Windows, dessine l'arabe à la taille du latin.
    out property <bool> rtl: @tr("ltr") == "rtl";
    out property <TextHorizontalAlignment> debut: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    out property <TextHorizontalAlignment> fin: root.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
    out property <LayoutAlignment> rangee-debut: root.rtl ? LayoutAlignment.end : LayoutAlignment.start;
    out property <LayoutAlignment> rangee-fin: root.rtl ? LayoutAlignment.start : LayoutAlignment.end;
    // Couleurs de la marque : Indigo (accent), Nuit pour les fonds sombres, Ambre en
    // touche d'accent (jamais en texte sur blanc ; Ambre foncé pour cet usage).
    out property <color> nuit: #1a2259;
    out property <color> ambre: #e3a23b;
    out property <color> ambre-fonce: #a8650f;
    out property <color> accent: #2d3a8c;
    out property <color> accent-survol: #e8eaf6;
    out property <color> texte: #1f2933;
    out property <color> texte-secondaire: #52606d;
    out property <color> erreur: #b42318;
    out property <color> succes: #067647;
    out property <color> fond-lateral: #f4f5f9;
    out property <color> bordure: #d9dce3;
}

// Rangée horizontale qui suit le sens de lecture : à utiliser à la place de
// HorizontalLayout (même comportement de gauche à droite : éléments étirés selon
// horizontal-stretch, sans retour à la ligne), inversée de droite à gauche.
// Un FlexboxLayout se déclare extensible en hauteur sans limite, alors qu'une
// rangée de boutons ou de champs doit garder sa hauteur. Une rangée qui remplit
// l'écran (`remplit: true`, par exemple une liste et sa fiche) a donc un facteur
// d'extension de 1 : la colonne qui la contient lui donne seule l'espace libre.
// (Un plafond `max-height: preferred-height` boucle à l'exécution entre rangées
// imbriquées.)
export component Rangee inherits FlexboxLayout {
    in property <bool> remplit: false;
    flex-direction: Theme.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
    flex-wrap: FlexboxLayoutWrap.no-wrap;
    alignment: LayoutAlignment.stretch;
    vertical-stretch: root.remplit ? 1 : 0;
}

// Champ de saisie avec son libellé au-dessus.
export component Champ inherits VerticalLayout {
    in property <string> libelle;
    in property <bool> secret: false;
    in property <bool> lecture-seule: false;
    in-out property <string> valeur <=> saisie.text;
    callback modifie(string);
    callback valide();

    spacing: 4px;

    Text {
        text: root.libelle;
        font-size: 12px;
        color: Theme.texte-secondaire;
        horizontal-alignment: Theme.debut;
    }

    saisie := LineEdit {
        horizontal-alignment: Theme.debut;
        input-type: root.secret ? InputType.password : InputType.text;
        read-only: root.lecture-seule;
        edited(texte) => {
            root.modifie(texte);
        }
        accepted => {
            root.valide();
        }
    }
}

// Résultat d'une action, renvoyé par l'application : message vide si rien à dire.
export struct Retour {
    ok: bool,
    message: string,
}

// Message de résultat, vert en cas de succès, rouge sinon.
export component MessageRetour inherits Text {
    in property <Retour> retour;
    text: root.retour.message;
    color: root.retour.ok ? Theme.succes : Theme.erreur;
    horizontal-alignment: Theme.debut;
    wrap: word-wrap;
    visible: root.retour.message != "";
}

// Droits du compte connecté, recalculés à chaque connexion depuis la matrice.
export global Droits {
    in property <bool> ajouter-referentiel;
    in property <bool> modifier-referentiel;
    in property <bool> gerer-parametres;
    in property <bool> gerer-utilisateurs;
}

// Modules activés par la licence de ce poste (jalon J9), recalculés à l'ouverture
// de la base et au remplacement de la clé. Un module désactivé est masqué.
export global Modules {
    in property <bool> devis;
    in property <bool> proforma;
    in property <bool> bons-commande;
    in property <bool> livraisons;
    in property <bool> paiements;
    in property <bool> tableau-de-bord;
    in property <bool> relances;
}

// Libellé de section dans un panneau.
export component Section inherits Text {
    horizontal-alignment: Theme.debut;
    font-family: Theme.police-titre;
    font-size: 15px;
    font-weight: 700;
    color: Theme.texte;
}

export component Titre inherits Text {
    horizontal-alignment: Theme.debut;
    font-family: Theme.police-titre;
    font-size: 22px;
    font-weight: 800;
    color: Theme.texte;
}

// Symbole de la marque (docs/marque) : tuile Indigo, jambe du K en trois temps.
// Le K découpé sert à toutes les tailles, petites comprises (décision de l'utilisateur du 2026-11-11).
export component Symbole inherits Image {
    source: @image-url("icones/kadenz-icone.svg");
    image-rendering: smooth;
}

// Bouton aux couleurs de la marque, à la place du Button standard (dont l'accent suit
// celui de Windows). Même interface : text, primary, enabled, clicked.
// Principal : fond Indigo, texte blanc. Secondaire : fond blanc, bordure, texte Encre.
// Clavier : Tab pour l'atteindre, Entrée ou Espace pour l'activer.
export component Bouton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    min-width: max(72px, etiquette.preferred-width + 24px);
    preferred-width: etiquette.preferred-width + 32px;
    min-height: 32px;
    preferred-height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 4px;
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.bordure;
    background: !root.enabled ? (root.primary ? #9aa3c7 : Theme.fond-lateral)
        : root.primary ? (zone.pressed ? #1f2866 : zone.has-hover ? #25307a : Theme.accent)
        : (zone.pressed ? #dfe2f1 : zone.has-hover ? Theme.accent-survol : white);

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.clicked();
    }

    // Anneau de focus, visible quand le bouton est atteint au clavier.
    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 6px;
        border-width: 2px;
        border-color: Theme.accent;
        visible: clavier.has-focus;
    }

    etiquette := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: 13px;
        font-weight: root.primary ? 600 : 500;
        color: !root.enabled ? (root.primary ? white : #9aa3b5) : root.primary ? white : Theme.texte;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    // Le TouchArea est à l'intérieur du FocusScope : un FocusScope placé au-dessus
    // capterait le premier appui pour prendre le focus, et le clic serait perdu.
    clavier := FocusScope {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(evenement) => {
            if (evenement.text == Key.Return || evenement.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }

        zone := TouchArea {
            width: parent.width;
            height: parent.height;
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }
}

export component MessageErreur inherits Text {
    horizontal-alignment: Theme.debut;
    color: Theme.erreur;
    wrap: word-wrap;
}

// Entrée du menu latéral : icône Kadenz (ui/icones/menu, traits droits) et libellé.
// L'entrée active est sur fond Indigo, avec un repère Ambre à gauche.
export component ElementNavigation inherits Rectangle {
    in property <string> libelle;
    in property <image> icone;
    in property <bool> actif;
    callback clique();

    height: 36px;
    border-radius: 4px;
    background: root.actif ? Theme.accent : (zone.has-hover ? Theme.accent-survol : transparent);

    accessible-role: button;
    accessible-label: root.libelle;
    accessible-action-default => {
        root.clique();
    }

    // Icône et libellé partent du bord de début : à droite en arabe. L'entrée
    // active se distingue par son seul fond, sans repère sur un côté.
    Image {
        x: Theme.rtl ? parent.width - 12px - self.width : 12px;
        width: 18px;
        height: 18px;
        source: root.icone;
        colorize: root.actif ? white : Theme.texte-secondaire;
    }

    Text {
        x: Theme.rtl ? 8px : 40px;
        width: parent.width - 48px;
        horizontal-alignment: Theme.debut;
        text: root.libelle;
        color: root.actif ? white : Theme.texte;
        font-weight: root.actif ? 600 : 400;
        vertical-alignment: center;
        font-size: 14px;
        overflow: elide;
    }

    zone := TouchArea {
        clicked => {
            root.clique();
        }
    }
}

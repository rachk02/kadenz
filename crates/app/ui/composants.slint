import { LineEdit } from "std-widgets.slint";

// Polices de la marque (docs/marque), SIL Open Font License 1.1 : Inter pour le texte,
// Space Grotesk (Bold) pour les titres. Instances statiques réduites au latin, embarquées dans
// l'exécutable. Les titres demandés en 800 prennent le Bold, graisse la plus forte de Space Grotesk.
import "polices/Inter-Regular.ttf";
import "polices/Inter-Medium.ttf";
import "polices/Inter-SemiBold.ttf";
import "polices/Inter-Bold.ttf";
import "polices/SpaceGrotesk-Bold.ttf";

export global Theme {
    // Interface en chinois : Inter et Space Grotesk n'ont pas les idéogrammes, et la police
    // de secours choisie par Windows est japonaise, sans les caractères simplifiés.
    // Microsoft YaHei, livrée avec Windows, couvre le chinois simplifié et le latin.
    in property <bool> chinois: false;
    out property <string> police-texte: root.chinois ? "Microsoft YaHei UI" : root.rtl ? "Segoe UI" : "Inter";
    out property <string> police-titre: root.chinois ? "Microsoft YaHei UI" : root.rtl ? "Segoe UI" : "Space Grotesk";

    // Sens de lecture, déduit de la traduction : seul ar.po traduit « ltr » par « rtl ».
    // De droite à gauche, les écrans sont mis en miroir : rangées inversées (Rangee),
    // textes alignés à droite (debut), menu et panneaux de marque à droite.
    // Arabe : Segoe UI, livrée avec Windows, dessine l'arabe à la taille du latin.
    out property <bool> rtl: @tr("ltr") == "rtl";
    out property <TextHorizontalAlignment> debut: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    out property <TextHorizontalAlignment> fin: root.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
    out property <LayoutAlignment> rangee-debut: root.rtl ? LayoutAlignment.end : LayoutAlignment.start;
    out property <LayoutAlignment> rangee-fin: root.rtl ? LayoutAlignment.start : LayoutAlignment.end;
    // Couleurs de la marque (docs/marque) : Indigo (accent, logo), Nuit pour les panneaux
    // de marque, les bulles et les alertes sombres ; couleurs de l'ancienne identité,
    // reprises le 2026-11-12 à la demande de l'utilisateur.
    out property <color> nuit: #1a2259;
    out property <color> accent: #2d3a8c;
    out property <color> accent-survol: #e8eaf6;
    // Ambre : touche d'accent sur les fonds sombres (jamais en texte sur blanc).
    out property <color> ambre: #e3a23b;
    out property <color> texte: #1f2933;
    out property <color> texte-secondaire: #52606d;
    out property <color> erreur: #b42318;
    out property <color> succes: #067647;
    out property <color> fond-lateral: #f4f5f9;
    out property <color> bordure: #d9dce3;
}

// Préférences d'affichage du compte connecté (migration 0006) : navigation par
// bandeau en haut (0, par défaut) ou par barre latérale repliable (1), animations.
// Animations coupées : toutes les durées tombent à zéro.
export global Affichage {
    in-out property <int> navigation: 0;
    in-out property <bool> animations: true;
    out property <duration> duree: root.animations ? 160ms : 0ms;
    out property <duration> duree-longue: root.animations ? 220ms : 0ms;
}

// Rangée horizontale qui suit le sens de lecture : à utiliser à la place de
// HorizontalLayout (même comportement de gauche à droite : éléments étirés selon
// horizontal-stretch, sans retour à la ligne), inversée de droite à gauche.
// Un FlexboxLayout se déclare extensible en hauteur sans limite, alors qu'une
// rangée de boutons ou de champs doit garder sa hauteur. Une rangée qui remplit
// l'écran (`remplit: true`, par exemple une liste et sa fiche) a donc un facteur
// d'extension de 1 : la colonne qui la contient lui donne seule l'espace libre.
// (Un plafond `max-height: preferred-height` boucle à l'exécution entre rangées
// imbriquées.)
export component Rangee inherits FlexboxLayout {
    in property <bool> remplit: false;
    flex-direction: Theme.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
    flex-wrap: FlexboxLayoutWrap.no-wrap;
    alignment: LayoutAlignment.stretch;
    vertical-stretch: root.remplit ? 1 : 0;
}

// Champ de saisie avec son libellé au-dessus.
export component Champ inherits VerticalLayout {
    in property <string> libelle;
    in property <bool> secret: false;
    in property <bool> lecture-seule: false;
    in-out property <string> valeur <=> saisie.text;
    callback modifie(string);
    callback valide();

    spacing: 4px;

    Text {
        text: root.libelle;
        font-size: 12px;
        color: Theme.texte-secondaire;
        horizontal-alignment: Theme.debut;
    }

    saisie := LineEdit {
        horizontal-alignment: Theme.debut;
        input-type: root.secret ? InputType.password : InputType.text;
        read-only: root.lecture-seule;
        edited(texte) => {
            root.modifie(texte);
        }
        accepted => {
            root.valide();
        }
    }
}

// Résultat d'une action, renvoyé par l'application : message vide si rien à dire.
export struct Retour {
    ok: bool,
    message: string,
}

// Message de résultat, vert en cas de succès, rouge sinon.
export component MessageRetour inherits Text {
    in property <Retour> retour;
    // Vrai : un succès part en alerte brève (Alerte) ; seules les erreurs restent ici.
    in property <bool> erreurs-seules: false;
    property <bool> montre: root.retour.message != "" && !(root.erreurs-seules && root.retour.ok);
    text: root.montre ? root.retour.message : "";
    color: root.retour.ok ? Theme.succes : Theme.erreur;
    horizontal-alignment: Theme.debut;
    wrap: word-wrap;
    visible: root.montre;
    height: root.montre ? self.preferred-height : 0px;
}

// Alerte brève (révision 2.34) : message de réussite affiché quelques secondes en
// bas de la fenêtre ; une nouvelle alerte remplace la précédente.
export global Alerte {
    in-out property <string> texte;
    in-out property <bool> visible;
    in-out property <int> numero;

    public function montrer(texte: string) {
        root.texte = texte;
        root.visible = true;
        root.numero += 1;
    }

    // Retour d'une action : alerte s'il est réussi et porte un message.
    public function retour(r: Retour) {
        if (r.ok && r.message != "") {
            root.montrer(r.message);
        }
    }

    // Comme retour, puis rend le retour sans son message de réussite : la page
    // n'affiche plus que les erreurs.
    public function relayer(r: Retour) -> Retour {
        if (r.ok && r.message != "") {
            root.montrer(r.message);
            return { ok: true, message: "" };
        }
        return r;
    }
}

export component FenetreAlerte inherits Rectangle {
    in property <length> largeur-fenetre;
    in property <length> hauteur-fenetre;

    width: min(ligne.preferred-width, root.largeur-fenetre - 48px);
    height: 40px;
    x: (root.largeur-fenetre - self.width) / 2;
    // Assez haut pour laisser visible le bouton qu'on vient de cliquer en bas de page.
    y: root.hauteur-fenetre - self.height - 64px + (Alerte.visible ? 0px : 12px);
    animate y { duration: Affichage.duree-longue; easing: ease-out; }
    opacity: Alerte.visible ? 1 : 0;
    animate opacity { duration: Affichage.duree; }
    visible: self.opacity > 0;
    background: Theme.nuit;
    border-radius: 4px;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #0f172a40;

    accessible-role: text;
    accessible-label: Alerte.texte;

    // Un clic referme l'alerte.
    TouchArea {
        clicked => {
            Alerte.visible = false;
        }
    }

    // Carré vert au début du sens de lecture (la Rangee s'inverse de droite à gauche).
    ligne := Rangee {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        alignment: center;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 8px;
                height: 8px;
                background: #3ccb7f;
            }
        }

        Text {
            text: Alerte.texte;
            color: white;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // Trois secondes d'affichage ; une nouvelle alerte relance le compte.
    minuteur := Timer {
        interval: 3s;
        running: Alerte.visible;
        triggered => {
            Alerte.visible = false;
        }
    }

    property <int> numero: Alerte.numero;
    changed numero => {
        minuteur.restart();
    }
}

// Droits du compte connecté, recalculés à chaque connexion depuis la matrice.
export global Droits {
    in property <bool> ajouter-referentiel;
    in property <bool> modifier-referentiel;
    in property <bool> gerer-parametres;
    in property <bool> gerer-utilisateurs;
}

// Modules activés par la licence de ce poste (jalon J9), recalculés à l'ouverture
// de la base et au remplacement de la clé. Un module désactivé est masqué.
export global Modules {
    in property <bool> devis;
    in property <bool> proforma;
    in property <bool> bons-commande;
    in property <bool> livraisons;
    in property <bool> paiements;
    in property <bool> tableau-de-bord;
    in property <bool> relances;
}

// Libellé de section dans un panneau.
export component Section inherits Text {
    horizontal-alignment: Theme.debut;
    font-family: Theme.police-titre;
    font-size: 15px;
    font-weight: 700;
    color: Theme.texte;
}

export component Titre inherits Text {
    horizontal-alignment: Theme.debut;
    font-family: Theme.police-titre;
    font-size: 22px;
    font-weight: 800;
    color: Theme.texte;
}

// Symbole de la marque (docs/marque) : quatre pièces (carré, quart de disque, triangle,
// disque) en blanc sur une tuile Bleu vif, dans la petite coupe aux jeux élargis.
// Motif Quatre pièces des bandeaux de marque (docs/marque, règle 2 : jamais derrière un texte).
// Le motif garde un pas fixe (pièces entières) ; les zones calmes du haut (logo, étapes) et du
// bas (textes) sont arrondies à des rangées entières, pour qu'aucune pièce ne soit rognée.
// motif-quatre-pieces.svg : 6 colonnes et 20 rangées ; 20 est un multiple du cycle de 4 rangées,
// les deux images empilées se raccordent sans couture.
// Les trois temps de la marque (ancienne identité) : deux traits blancs décalés, le
// troisième en Ambre. Décalage vers la fin de la ligne : vers la gauche en arabe.
export component TroisTemps inherits VerticalLayout {
    spacing: 6px;

    Rectangle {
        x: Theme.rtl ? parent.width - self.width : 0px;
        width: 56px;
        height: 4px;
        background: white;
    }

    Rectangle {
        x: Theme.rtl ? parent.width - self.width - 10px : 10px;
        width: 56px;
        height: 4px;
        background: white;
    }

    Rectangle {
        x: Theme.rtl ? parent.width - self.width - 20px : 20px;
        width: 56px;
        height: 4px;
        background: Theme.ambre;
    }
}

export component MotifMarque inherits Rectangle {
    in property <length> pas: 80px;
    in property <length> haut: 0px;
    in property <length> bas: 0px;
    property <length> fin-haut: ceil(root.haut / root.pas) * root.pas;
    property <length> debut-bas: max(root.fin-haut, floor((root.height - root.bas) / root.pas) * root.pas);
    clip: true;

    Image {
        x: 0;
        y: 0;
        width: 6 * root.pas;
        height: 20 * root.pas;
        source: @image-url("icones/motif-quatre-pieces.svg");
        image-fit: fill;
    }

    Image {
        x: 0;
        y: 20 * root.pas;
        width: 6 * root.pas;
        height: 20 * root.pas;
        source: @image-url("icones/motif-quatre-pieces.svg");
        image-fit: fill;
    }

    // Deuxième colonne de tuiles : 6 colonnes est aussi un multiple du cycle du motif.
    Image {
        x: 6 * root.pas;
        y: 0;
        width: 6 * root.pas;
        height: 20 * root.pas;
        source: @image-url("icones/motif-quatre-pieces.svg");
        image-fit: fill;
    }

    Image {
        x: 6 * root.pas;
        y: 20 * root.pas;
        width: 6 * root.pas;
        height: 20 * root.pas;
        source: @image-url("icones/motif-quatre-pieces.svg");
        image-fit: fill;
    }

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.fin-haut;
        background: Theme.nuit;
    }

    Rectangle {
        x: 0;
        y: root.debut-bas;
        width: root.width;
        height: max(0px, root.height - root.debut-bas);
        background: Theme.nuit;
    }
}

export component Symbole inherits Image {
    source: @image-url("icones/kadenz-icone.svg");
    image-rendering: smooth;
}

// Bouton aux couleurs de la marque, à la place du Button standard (dont l'accent suit
// celui de Windows). Même interface : text, primary, enabled, clicked.
// Principal : fond Bleu vif, texte blanc. Secondaire : fond blanc, bordure, texte Encre.
// Clavier : Tab pour l'atteindre, Entrée ou Espace pour l'activer.
export component Bouton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    // Avec primary : bouton rouge des actions qui suppriment ou annulent.
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();
    out property <bool> a-le-focus: clavier.has-focus;

    // Donne le focus clavier au bouton (fenêtre de confirmation).
    public function focaliser() {
        clavier.focus();
    }

    min-width: max(72px, etiquette.preferred-width + 24px);
    preferred-width: etiquette.preferred-width + 32px;
    min-height: 32px;
    preferred-height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 4px;
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.bordure;
    background: !root.enabled ? (root.primary ? #9aa3c7 : Theme.fond-lateral)
        : root.primary && root.danger ? (zone.pressed ? #7a150e : zone.has-hover ? #951c13 : Theme.erreur)
        : root.primary ? (zone.pressed ? #1f2866 : zone.has-hover ? #25307a : Theme.accent)
        : (zone.pressed ? #dfe2f1 : zone.has-hover ? Theme.accent-survol : white);
    animate background { duration: Affichage.duree; }

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.clicked();
    }

    // Anneau de focus, visible quand le bouton est atteint au clavier.
    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 6px;
        border-width: 2px;
        border-color: root.danger ? Theme.erreur : Theme.accent;
        visible: clavier.has-focus;
    }

    etiquette := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: 13px;
        font-weight: root.primary ? 600 : 500;
        color: !root.enabled ? (root.primary ? white : #9aa3b5) : root.primary ? white : Theme.texte;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    // Le TouchArea est à l'intérieur du FocusScope : un FocusScope placé au-dessus
    // capterait le premier appui pour prendre le focus, et le clic serait perdu.
    clavier := FocusScope {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(evenement) => {
            if (evenement.text == Key.Return || evenement.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }

        zone := TouchArea {
            width: parent.width;
            height: parent.height;
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }
}

// Demande de confirmation commune (révision 2.34) : une seule fenêtre, dessinée
// par la fenêtre principale au-dessus de tout. Un écran appelle demander() et garde
// sa propre demande en cours ; à la réponse, accepte est posé puis reponses avance :
// l'écran qui a une demande en cours agit (ou non) puis l'oublie.
export global Confirmation {
    in-out property <bool> ouverte;
    in-out property <string> message;
    in-out property <string> bouton;
    in-out property <bool> danger;
    in-out property <bool> accepte;
    in-out property <int> reponses;

    public function demander(message: string, bouton: string, danger: bool) {
        root.message = message;
        root.bouton = bouton;
        root.danger = danger;
        root.ouverte = true;
    }

    public function repondre(accepte: bool) {
        root.accepte = accepte;
        root.ouverte = false;
        root.reponses += 1;
    }
}

// Fenêtre de confirmation : fond voilé, message, Revenir et le bouton d'action
// (rouge pour une suppression ou une annulation). Échap revient ; Entrée active le
// bouton qui a le focus, Revenir d'abord quand l'action est destructrice.
export component FenetreConfirmation inherits Rectangle {
    property <bool> ouverte: Confirmation.ouverte;
    changed ouverte => {
        if (self.ouverte) {
            if (Confirmation.danger) {
                revenir.focaliser();
            } else {
                confirmer.focaliser();
            }
        }
    }

    opacity: Confirmation.ouverte ? 1 : 0;
    animate opacity { duration: Affichage.duree; }
    visible: self.opacity > 0;
    background: #0f172a80;

    // Les clics ne doivent pas atteindre l'écran recouvert.
    TouchArea { }

    FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                Confirmation.repondre(false);
                return accept;
            }
            // Tab reste dans la fenêtre : il passe d'un bouton à l'autre et
            // n'atteint jamais l'écran recouvert.
            if (e.text == Key.Tab || e.text == Key.Backtab) {
                if (revenir.a-le-focus) {
                    confirmer.focaliser();
                } else {
                    revenir.focaliser();
                }
                return accept;
            }
            return reject;
        }

        carte := Rectangle {
            width: min(460px, root.width - 48px);
            height: contenu.preferred-height;
            y: (root.height - self.height) / 2 + (Confirmation.ouverte ? 0px : 12px);
            animate y { duration: Affichage.duree-longue; easing: ease-out; }
            background: white;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.bordure;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #0f172a33;

            contenu := VerticalLayout {
                padding: 24px;
                spacing: 20px;

                Text {
                    horizontal-alignment: Theme.debut;
                    text: Confirmation.message;
                    color: Theme.texte;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                // Boutons en fin de ligne ; la Rangee s'inverse de droite à gauche.
                Rangee {
                    alignment: end;
                    spacing: 8px;

                    revenir := Bouton {
                        text: @tr("Revenir");
                        clicked => {
                            Confirmation.repondre(false);
                        }
                    }

                    confirmer := Bouton {
                        text: Confirmation.bouton;
                        primary: true;
                        danger: Confirmation.danger;
                        clicked => {
                            Confirmation.repondre(true);
                        }
                    }
                }
            }
        }
    }
}

export component MessageErreur inherits Text {
    horizontal-alignment: Theme.debut;
    color: Theme.erreur;
    wrap: word-wrap;
}

// Entrée du menu latéral : icône Kadenz (ui/icones/menu, traits droits) et libellé.
// L'entrée active est sur fond Bleu vif.
export component ElementNavigation inherits Rectangle {
    in property <string> libelle;
    in property <image> icone;
    in property <bool> actif;
    callback clique();

    height: 36px;
    border-radius: 4px;
    background: root.actif ? Theme.accent : (zone.has-hover ? Theme.accent-survol : transparent);
    animate background { duration: Affichage.duree; }

    accessible-role: button;
    accessible-label: root.libelle;
    accessible-action-default => {
        root.clique();
    }

    // Icône et libellé partent du bord de début : à droite en arabe. L'entrée
    // active se distingue par son seul fond, sans repère sur un côté.
    Image {
        x: Theme.rtl ? parent.width - 12px - self.width : 12px;
        width: 18px;
        height: 18px;
        source: root.icone;
        colorize: root.actif ? white : Theme.texte-secondaire;
    }

    Text {
        x: Theme.rtl ? 8px : 40px;
        width: parent.width - 48px;
        horizontal-alignment: Theme.debut;
        text: root.libelle;
        color: root.actif ? white : Theme.texte;
        font-weight: root.actif ? 600 : 400;
        vertical-alignment: center;
        font-size: 14px;
        overflow: elide;
    }

    zone := TouchArea {
        clicked => {
            root.clique();
        }
    }
}

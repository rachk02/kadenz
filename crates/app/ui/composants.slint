import { LineEdit } from "std-widgets.slint";

// Polices de la marque (docs/marque), SIL Open Font License 1.1 : Inter pour le texte,
// Space Grotesk (Bold) pour les titres. Instances statiques réduites au latin, embarquées dans
// l'exécutable. Les titres demandés en 800 prennent le Bold, graisse la plus forte de Space Grotesk.
import "polices/Inter-Regular.ttf";
import "polices/Inter-Medium.ttf";
import "polices/Inter-SemiBold.ttf";
import "polices/Inter-Bold.ttf";
import "polices/SpaceGrotesk-Bold.ttf";

export global Theme {
    // Interface en chinois : Inter et Space Grotesk n'ont pas les idéogrammes, et la police
    // de secours choisie par Windows est japonaise, sans les caractères simplifiés.
    // Microsoft YaHei, livrée avec Windows, couvre le chinois simplifié et le latin.
    in property <bool> chinois: false;
    out property <string> police-texte: root.chinois ? "Microsoft YaHei UI" : root.rtl ? "Segoe UI" : "Inter";
    out property <string> police-titre: root.chinois ? "Microsoft YaHei UI" : root.rtl ? "Segoe UI" : "Space Grotesk";

    // Sens de lecture, déduit de la traduction : seul ar.po traduit « ltr » par « rtl ».
    // De droite à gauche, les écrans sont mis en miroir : rangées inversées (Rangee),
    // textes alignés à droite (debut), menu et panneaux de marque à droite.
    // Arabe : Segoe UI, livrée avec Windows, dessine l'arabe à la taille du latin.
    out property <bool> rtl: @tr("ltr") == "rtl";
    out property <TextHorizontalAlignment> debut: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    out property <TextHorizontalAlignment> fin: root.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
    out property <LayoutAlignment> rangee-debut: root.rtl ? LayoutAlignment.end : LayoutAlignment.start;
    out property <LayoutAlignment> rangee-fin: root.rtl ? LayoutAlignment.start : LayoutAlignment.end;
    // Mode sombre (refonte du 2026-11-18) : vrai quand le compte a choisi le mode sombre, ou
    // « comme Windows » avec Windows en sombre. Trois palettes sombres au choix, des gris
    // (docs/marque/propositions-2026-11-18-mode-sombre, décision de l'utilisateur) :
    // 0 Graphite, 1 Ardoise, 2 Anthracite chaud (par défaut).
    // Mode : 0 comme Windows (par défaut), 1 clair, 2 sombre ; réglage de Windows relu par
    // l'application (theme.rs). Avant connexion, mode et palette du poste.
    in property <int> mode: 0;
    in property <int> palette: 2;
    in property <bool> windows-sombre: false;
    out property <bool> sombre: root.mode == 2 || (root.mode == 0 && root.windows-sombre);

    // Valeur claire, puis valeurs sombres Graphite, Ardoise, Anthracite.
    pure function choix(clair: color, graphite: color, ardoise: color, anthracite: color) -> color {
        if (!root.sombre) {
            return clair;
        }
        if (root.palette == 0) {
            return graphite;
        }
        if (root.palette == 1) {
            return ardoise;
        }
        return anthracite;
    }

    // Fond et accent d'une palette sombre, quel que soit le mode en cours : aperçus du choix.
    public pure function fond-de(palette: int) -> color {
        return palette == 0 ? #17181b : palette == 1 ? #15191e : #1a1918;
    }
    public pure function accent-de(palette: int) -> color {
        return palette == 1 ? #8f9bea : #e3a23b;
    }
    public pure function texte-de(palette: int) -> color {
        return palette == 0 ? #ecedef : palette == 1 ? #f4f5f9 : #eeebe7;
    }
    out property <color> fond-clair: #ffffff;
    out property <color> accent-clair: #2d3a8c;

    // Couleurs de la marque (docs/marque) : Indigo (accent, logo), Nuit pour les panneaux
    // de marque en clair ; couleurs de l'ancienne identité, reprises le 2026-11-12.
    // Fond des pages et des fenêtres.
    out property <color> fond: root.choix(#ffffff, #17181b, #15191e, #1a1918);
    // Navigation, en-têtes de tableaux.
    out property <color> fond-lateral: root.choix(#f4f5f9, #1e2024, #1c2229, #211f1e);
    // Cartes et tableaux.
    out property <color> surface: root.choix(#ffffff, #1e2024, #1f2933, #232120);
    // Panneaux de marque, bulles, alertes sombres.
    out property <color> nuit: root.choix(#1a2259, #111214, #101317, #131211);
    // Bouton principal, liens, éléments actifs : Indigo en clair ; Ambre ou Indigo éclairci.
    out property <color> accent: root.choix(#2d3a8c, #e3a23b, #8f9bea, #e3a23b);
    // Texte posé sur l'accent (bouton principal).
    out property <color> texte-sur-accent: root.choix(#ffffff, #17181b, #15191e, #1a1918);
    // Ligne choisie, survol.
    out property <color> accent-survol: root.choix(#e8eaf6, #2b2e34, #2a3542, #302d2a);
    // Fond des champs de saisie et des boutons secondaires.
    out property <color> champ: root.choix(#ffffff, #26282d, #27313c, #2b2927);
    // Séparateurs de zones (décoratifs).
    out property <color> bordure: root.choix(#d9dce3, #33363c, #334050, #383533);
    // Contours des champs et des boutons secondaires : 3 : 1 au moins (WCAG 1.4.11).
    out property <color> bordure-champ: root.choix(#7b8794, #6e737d, #6f7d8c, #77716b);
    // Contour du champ actif, 2 px.
    out property <color> focus: root.choix(#2d3a8c, #e3a23b, #8f9bea, #e3a23b);
    out property <color> texte: root.choix(#1f2933, #ecedef, #f4f5f9, #eeebe7);
    out property <color> texte-secondaire: root.choix(#52606d, #a3a8b0, #a9b4c0, #ada69f);
    // Ambre : touche d'accent sur les fonds sombres (jamais en texte sur blanc).
    out property <color> ambre: #e3a23b;
    // Couleurs d'état, éclaircies en sombre ; fonds pâles des bandeaux et étiquettes.
    out property <color> erreur: root.choix(#b42318, #f97066, #f97066, #f97066);
    // Ambre foncé, lisible sur fond blanc : résultat attendu du serveur.
    out property <color> attente: root.choix(#b54708, #fdb022, #fdb022, #fdb022);
    out property <color> succes: root.choix(#067647, #47cd89, #47cd89, #47cd89);
    out property <color> fond-erreur: root.choix(#fef3f2, #3a2224, #3a2226, #3b2322);
    out property <color> fond-attente: root.choix(#fff8eb, #3a3020, #3a3122, #3b311f);
    out property <color> fond-succes: root.choix(#ecfdf3, #1e3329, #1d332b, #20322a);
    // Survol et appui des boutons principaux, normaux et de suppression.
    out property <color> accent-fonce: root.choix(#25307a, #cf9030, #7a87e0, #cf9030);
    out property <color> accent-presse: root.choix(#1f2866, #b87f28, #6874d4, #b87f28);
    out property <color> danger-fonce: root.choix(#951c13, #e85d54, #e85d54, #e85d54);
    out property <color> danger-presse: root.choix(#7a150e, #d14a42, #d14a42, #d14a42);
    // Appui d'un bouton secondaire.
    out property <color> secondaire-presse: root.choix(#dfe2f1, #33363c, #334050, #383533);
    // Bouton principal grisé et texte grisé.
    out property <color> desactive: root.choix(#9aa3c7, #3a3d44, #3a4756, #403c39);
    out property <color> texte-desactive: root.choix(#9aa3b5, #6e737d, #6f7d8c, #77716b);
    // Fond discret : barres de graphiques, grilles.
    out property <color> fond-discret: root.choix(#eceef3, #26282d, #27313c, #2b2927);

    // Couleur d'état envoyée par l'application avec ses valeurs claires (pilotage.rs :
    // impayé, partiel, payé) : rendue par le jeton du thème, pour suivre le mode et la
    // palette ; toute autre couleur est rendue telle quelle.
    public pure function etat(c: color) -> color {
        return c == #b42318 ? root.erreur : c == #a8650f ? root.attente : c == #067647 ? root.succes : c;
    }
}

// Préférences d'affichage du compte connecté (migration 0006) : navigation par
// bandeau en haut (0, par défaut) ou par barre latérale repliable (1), animations.
// Animations coupées : toutes les durées tombent à zéro.
export global Affichage {
    // Réglage d'affichage du poste, avant toute connexion (premier lancement) : mode
    // (0 comme Windows, 1 clair, 2 sombre) et palette sombre (0 Graphite, 1 Ardoise,
    // 2 Anthracite) ; enregistré et appliqué aussitôt par l'application.
    callback choisir-poste(int, int);
    in-out property <int> navigation: 0;
    in-out property <bool> animations: true;
    out property <duration> duree: root.animations ? 160ms : 0ms;
    out property <duration> duree-longue: root.animations ? 220ms : 0ms;
}

// Rangée horizontale qui suit le sens de lecture : à utiliser à la place de
// HorizontalLayout (même comportement de gauche à droite : éléments étirés selon
// horizontal-stretch, sans retour à la ligne), inversée de droite à gauche.
// Un FlexboxLayout se déclare extensible en hauteur sans limite, alors qu'une
// rangée de boutons ou de champs doit garder sa hauteur. Une rangée qui remplit
// l'écran (`remplit: true`, par exemple une liste et sa fiche) a donc un facteur
// d'extension de 1 : la colonne qui la contient lui donne seule l'espace libre.
// (Un plafond `max-height: preferred-height` boucle à l'exécution entre rangées
// imbriquées.)
export component Rangee inherits FlexboxLayout {
    in property <bool> remplit: false;
    flex-direction: Theme.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
    flex-wrap: FlexboxLayoutWrap.no-wrap;
    alignment: LayoutAlignment.stretch;
    vertical-stretch: root.remplit ? 1 : 0;
}

// Champ de nombre des tableaux de saisie (prix, quantité) : même aspect qu'un
// LineEdit, sans sa croix d'effacement, qui mange un champ étroit et efface la
// valeur au moindre clic à côté du chiffre. À la prise du focus, le contenu est
// sélectionné : un nombre tapé remplace la valeur proposée.
export component ChampNombre inherits Rectangle {
    in-out property <string> text <=> saisie.text;
    in property <bool> read-only: false;
    in property <bool> enabled: true;
    in property <string> placeholder-text;
    in property <TextHorizontalAlignment> horizontal-alignment: Theme.fin;
    out property <bool> has-focus: saisie.has-focus;
    callback edited(string);
    callback accepted(string);

    min-width: 40px;
    min-height: 32px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.bordure;
    background: root.enabled ? Theme.champ : Theme.fond-lateral;
    clip: true;
    forward-focus: saisie;

    if saisie.text == "": Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        vertical-alignment: center;
        horizontal-alignment: root.horizontal-alignment;
        text: root.placeholder-text;
        color: Theme.texte-secondaire;
        overflow: elide;
    }

    saisie := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        vertical-alignment: center;
        horizontal-alignment: root.horizontal-alignment;
        single-line: true;
        read-only: root.read-only;
        enabled: root.enabled;
        color: root.enabled ? Theme.texte : Theme.texte-secondaire;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.texte-sur-accent;
        accessible-role: text-input;
        accessible-value: self.text;
        accessible-placeholder-text: root.placeholder-text;
        // Le clic qui donne le focus place ensuite le curseur : la sélection
        // attend la fin de ce clic.
        changed has-focus => {
            if (self.has-focus && !root.read-only) {
                selection.running = true;
            }
        }
        edited => {
            root.edited(self.text);
        }
        accepted => {
            root.accepted(self.text);
        }
    }

    selection := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            saisie.select-all();
        }
    }

    // Trait d'accent sous le champ actif, comme le LineEdit.
    if saisie.has-focus && !root.read-only: Rectangle {
        x: 4px;
        y: parent.height - 2px;
        width: parent.width - 8px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent;
    }
}

// Champ de saisie avec son libellé au-dessus.
export component Champ inherits VerticalLayout {
    in property <string> libelle;
    in property <bool> secret: false;
    in property <bool> lecture-seule: false;
    in-out property <string> valeur <=> saisie.text;
    callback modifie(string);
    callback valide();

    spacing: 4px;

    Text {
        text: root.libelle;
        font-size: 12px;
        color: Theme.texte-secondaire;
        horizontal-alignment: Theme.debut;
    }

    saisie := LineEdit {
        horizontal-alignment: Theme.debut;
        input-type: root.secret ? InputType.password : InputType.text;
        read-only: root.lecture-seule;
        edited(texte) => {
            root.modifie(texte);
        }
        accepted => {
            root.valide();
        }
    }
}

// Résultat d'une action, renvoyé par l'application : message vide si rien à dire.
export struct Retour {
    ok: bool,
    message: string,
    // Écriture partie sans réponse du serveur à temps : ni réussie ni
    // refusée, son résultat viendra au retour (message ambre, pas rouge).
    attente: bool,
}

// Message de résultat, vert en cas de succès, ambre pour une écriture dont la
// réponse est attendue, rouge sinon.
export component MessageRetour inherits Text {
    in property <Retour> retour;
    // Vrai : un succès part en alerte brève (Alerte) ; seules les erreurs restent ici.
    in property <bool> erreurs-seules: false;
    property <bool> montre: root.retour.message != "" && !(root.erreurs-seules && root.retour.ok);
    text: root.montre ? root.retour.message : "";
    color: root.retour.ok ? Theme.succes : root.retour.attente ? Theme.attente : Theme.erreur;
    horizontal-alignment: Theme.debut;
    wrap: word-wrap;
    visible: root.montre;
    height: root.montre ? self.preferred-height : 0px;
}

// Alerte brève (révision 2.34) : message de réussite affiché quelques secondes en
// bas de la fenêtre ; une nouvelle alerte remplace la précédente.
export global Alerte {
    in-out property <string> texte;
    in-out property <bool> visible;
    in-out property <int> numero;
    // Message venu du serveur sans geste de l'utilisateur : il reste affiché
    // jusqu'à ce qu'on le ferme (essai F6d : l'annonce du retour du serveur
    // disparaissait avant d'être lue).
    in-out property <bool> durable;

    public function montrer(texte: string) {
        root.texte = texte;
        root.visible = true;
        root.durable = false;
        root.numero += 1;
    }

    public function signaler(texte: string) {
        root.texte = texte;
        root.visible = true;
        root.durable = true;
        root.numero += 1;
    }

    // Retour d'une action : alerte s'il est réussi et porte un message.
    public function retour(r: Retour) {
        if (r.ok && r.message != "") {
            root.montrer(r.message);
        }
    }

    // Comme retour, puis rend le retour sans son message de réussite : la page
    // n'affiche plus que les erreurs.
    public function relayer(r: Retour) -> Retour {
        if (r.ok && r.message != "") {
            root.montrer(r.message);
            return { ok: true, message: "" };
        }
        return r;
    }
}

export component FenetreAlerte inherits Rectangle {
    in property <length> largeur-fenetre;
    in property <length> hauteur-fenetre;

    width: min(ligne.preferred-width, root.largeur-fenetre - 48px);
    height: 40px;
    x: (root.largeur-fenetre - self.width) / 2;
    // Assez haut pour laisser visible le bouton qu'on vient de cliquer en bas de page.
    y: root.hauteur-fenetre - self.height - 64px + (Alerte.visible ? 0px : 12px);
    animate y { duration: Affichage.duree-longue; easing: ease-out; }
    opacity: Alerte.visible ? 1 : 0;
    animate opacity { duration: Affichage.duree; }
    visible: self.opacity > 0;
    background: Theme.nuit;
    border-radius: 4px;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #0f172a40;

    accessible-role: text;
    accessible-label: Alerte.texte;

    // Un clic referme l'alerte.
    TouchArea {
        clicked => {
            Alerte.visible = false;
        }
    }

    // Carré au début du sens de lecture (la Rangee s'inverse de droite à
    // gauche) : vert pour une réussite, ambre pour un message du serveur.
    ligne := Rangee {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        alignment: center;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 8px;
                height: 8px;
                background: Alerte.durable ? Theme.ambre : #3ccb7f;
            }
        }

        Text {
            text: Alerte.texte;
            color: white;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }

        // Croix de fermeture sur toute alerte (essai F6d, essai 4).
        Text {
            text: "×";
            color: #c5cae0;
            font-size: 16px;
            vertical-alignment: center;
        }
    }

    // Trois secondes d'affichage ; une nouvelle alerte relance le compte. Un
    // message du serveur attend d'être fermé : le minuteur s'arrête. Il est
    // piloté ici seulement : restart() réarme un minuteur déjà démarré une
    // fois même quand running est faux, si bien qu'un message durable se
    // fermait au bout de trois secondes (essai F6d, essai 3) ; et il ne fait
    // rien sur un minuteur jamais démarré, d'où running posé avant.
    minuteur := Timer {
        interval: 3s;
        running: false;
        triggered => {
            Alerte.visible = false;
            self.running = false;
        }
    }

    property <int> numero: Alerte.numero;
    changed numero => {
        if (Alerte.durable) {
            minuteur.running = false;
        } else {
            minuteur.running = true;
            minuteur.restart();
        }
    }
}

// Saisie permise sur ce poste (décisions 40, 46 et 50) : faux quand le serveur
// est en lecture seule. Les boutons qui enregistrent quelque chose sont alors
// inactifs ; consultation, impression, exports et navigation restent ouverts.
// Serveur injoignable avec la file d'envoi : la saisie reste permise, mais la
// validation (numéro du serveur) et les comptes et réglages attendent le
// serveur. Un poste V1, sans serveur, est toujours permis.
export global Ecriture {
    in property <bool> permise: true;
    in property <bool> validation: true;
    in property <bool> reglages: true;
}

// Droits du compte connecté, recalculés à chaque connexion depuis la matrice.
export global Droits {
    in property <bool> ajouter-referentiel;
    in property <bool> modifier-referentiel;
    in property <bool> gerer-parametres;
    in property <bool> gerer-utilisateurs;
    // Stock (docs/spec-stock.md, 3.7).
    in property <bool> ajuster-stock;
    in property <bool> voir-valeur-stock;
    in property <bool> exporter-comptabilite;
}

// Modules activés par la licence de ce poste (jalon J9), recalculés à l'ouverture
// de la base et au remplacement de la clé. Un module désactivé est masqué.
export global Modules {
    in property <bool> devis;
    in property <bool> proforma;
    in property <bool> bons-commande;
    in property <bool> livraisons;
    in property <bool> paiements;
    in property <bool> tableau-de-bord;
    in property <bool> relances;
}

// Libellé de section dans un panneau.
export component Section inherits Text {
    horizontal-alignment: Theme.debut;
    font-family: Theme.police-titre;
    font-size: 15px;
    font-weight: 700;
    color: Theme.texte;
}

export component Titre inherits Text {
    horizontal-alignment: Theme.debut;
    font-family: Theme.police-titre;
    font-size: 22px;
    font-weight: 800;
    color: Theme.texte;
}

// Symbole de la marque (docs/marque) : quatre pièces (carré, quart de disque, triangle,
// disque) en blanc sur une tuile Bleu vif, dans la petite coupe aux jeux élargis.
// Motif Quatre pièces des bandeaux de marque (docs/marque, règle 2 : jamais derrière un texte).
// Le motif garde un pas fixe (pièces entières) ; les zones calmes du haut (logo, étapes) et du
// bas (textes) sont arrondies à des rangées entières, pour qu'aucune pièce ne soit rognée.
// motif-quatre-pieces.svg : 6 colonnes et 20 rangées ; 20 est un multiple du cycle de 4 rangées,
// les deux images empilées se raccordent sans couture.
// Les trois temps de la marque (ancienne identité) : deux traits blancs décalés, le
// troisième en Ambre. Décalage vers la fin de la ligne : vers la gauche en arabe.
export component TroisTemps inherits VerticalLayout {
    spacing: 6px;

    Rectangle {
        x: Theme.rtl ? parent.width - self.width : 0px;
        width: 56px;
        height: 4px;
        background: white;
    }

    Rectangle {
        x: Theme.rtl ? parent.width - self.width - 10px : 10px;
        width: 56px;
        height: 4px;
        background: white;
    }

    Rectangle {
        x: Theme.rtl ? parent.width - self.width - 20px : 20px;
        width: 56px;
        height: 4px;
        background: Theme.ambre;
    }
}

export component MotifMarque inherits Rectangle {
    in property <length> pas: 80px;
    in property <length> haut: 0px;
    in property <length> bas: 0px;
    property <length> fin-haut: ceil(root.haut / root.pas) * root.pas;
    property <length> debut-bas: max(root.fin-haut, floor((root.height - root.bas) / root.pas) * root.pas);
    clip: true;

    Image {
        x: 0;
        y: 0;
        width: 6 * root.pas;
        height: 20 * root.pas;
        source: @image-url("icones/motif-quatre-pieces.svg");
        image-fit: fill;
    }

    Image {
        x: 0;
        y: 20 * root.pas;
        width: 6 * root.pas;
        height: 20 * root.pas;
        source: @image-url("icones/motif-quatre-pieces.svg");
        image-fit: fill;
    }

    // Deuxième colonne de tuiles : 6 colonnes est aussi un multiple du cycle du motif.
    Image {
        x: 6 * root.pas;
        y: 0;
        width: 6 * root.pas;
        height: 20 * root.pas;
        source: @image-url("icones/motif-quatre-pieces.svg");
        image-fit: fill;
    }

    Image {
        x: 6 * root.pas;
        y: 20 * root.pas;
        width: 6 * root.pas;
        height: 20 * root.pas;
        source: @image-url("icones/motif-quatre-pieces.svg");
        image-fit: fill;
    }

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.fin-haut;
        background: Theme.nuit;
    }

    Rectangle {
        x: 0;
        y: root.debut-bas;
        width: root.width;
        height: max(0px, root.height - root.debut-bas);
        background: Theme.nuit;
    }
}

export component Symbole inherits Image {
    source: @image-url("icones/kadenz-icone.svg");
    image-rendering: smooth;
}

// Bouton aux couleurs de la marque, à la place du Button standard (dont l'accent suit
// celui de Windows). Même interface : text, primary, enabled, clicked.
// Principal : fond Bleu vif, texte blanc. Secondaire : fond blanc, bordure, texte Encre.
// Clavier : Tab pour l'atteindre, Entrée ou Espace pour l'activer.
export component Bouton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    // Avec primary : bouton rouge des actions qui suppriment ou annulent.
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();
    out property <bool> a-le-focus: clavier.has-focus;

    // Donne le focus clavier au bouton (fenêtre de confirmation).
    public function focaliser() {
        clavier.focus();
    }

    min-width: max(72px, etiquette.preferred-width + 24px);
    preferred-width: etiquette.preferred-width + 32px;
    min-height: 32px;
    preferred-height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 4px;
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.bordure;
    background: !root.enabled ? (root.primary ? Theme.desactive : Theme.fond-lateral)
        : root.primary && root.danger ? (zone.pressed ? Theme.danger-presse : zone.has-hover ? Theme.danger-fonce : Theme.erreur)
        : root.primary ? (zone.pressed ? Theme.accent-presse : zone.has-hover ? Theme.accent-fonce : Theme.accent)
        : (zone.pressed ? Theme.secondaire-presse : zone.has-hover ? Theme.accent-survol : Theme.champ);
    animate background { duration: Affichage.duree; }

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.clicked();
    }

    // Anneau de focus, visible quand le bouton est atteint au clavier.
    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 6px;
        border-width: 2px;
        border-color: root.danger ? Theme.erreur : Theme.accent;
        visible: clavier.has-focus;
    }

    etiquette := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: 13px;
        font-weight: root.primary ? 600 : 500;
        color: !root.enabled ? (root.primary ? Theme.texte-sur-accent : Theme.texte-desactive) : root.primary ? Theme.texte-sur-accent : Theme.texte;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    // Le TouchArea est à l'intérieur du FocusScope : un FocusScope placé au-dessus
    // capterait le premier appui pour prendre le focus, et le clic serait perdu.
    clavier := FocusScope {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(evenement) => {
            if (evenement.text == Key.Return || evenement.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }

        zone := TouchArea {
            width: parent.width;
            height: parent.height;
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }
}

// Demande de confirmation commune (révision 2.34) : une seule fenêtre, dessinée
// par la fenêtre principale au-dessus de tout. Un écran appelle demander() et garde
// sa propre demande en cours ; à la réponse, accepte est posé puis reponses avance :
// l'écran qui a une demande en cours agit (ou non) puis l'oublie.
export global Confirmation {
    in-out property <bool> ouverte;
    in-out property <string> message;
    in-out property <string> bouton;
    in-out property <bool> danger;
    in-out property <bool> accepte;
    in-out property <int> reponses;

    public function demander(message: string, bouton: string, danger: bool) {
        root.message = message;
        root.bouton = bouton;
        root.danger = danger;
        root.ouverte = true;
    }

    public function repondre(accepte: bool) {
        root.accepte = accepte;
        root.ouverte = false;
        root.reponses += 1;
    }
}

// Fenêtre de confirmation : fond voilé, message, Revenir et le bouton d'action
// (rouge pour une suppression ou une annulation). Échap revient ; Entrée active le
// bouton qui a le focus, Revenir d'abord quand l'action est destructrice.
export component FenetreConfirmation inherits Rectangle {
    property <bool> ouverte: Confirmation.ouverte;
    changed ouverte => {
        if (self.ouverte) {
            if (Confirmation.danger) {
                revenir.focaliser();
            } else {
                confirmer.focaliser();
            }
        }
    }

    opacity: Confirmation.ouverte ? 1 : 0;
    animate opacity { duration: Affichage.duree; }
    visible: self.opacity > 0;
    background: #0f172a80;

    // Les clics ne doivent pas atteindre l'écran recouvert.
    TouchArea { }

    FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                Confirmation.repondre(false);
                return accept;
            }
            // Tab reste dans la fenêtre : il passe d'un bouton à l'autre et
            // n'atteint jamais l'écran recouvert.
            if (e.text == Key.Tab || e.text == Key.Backtab) {
                if (revenir.a-le-focus) {
                    confirmer.focaliser();
                } else {
                    revenir.focaliser();
                }
                return accept;
            }
            return reject;
        }

        carte := Rectangle {
            width: min(460px, root.width - 48px);
            height: contenu.preferred-height;
            y: (root.height - self.height) / 2 + (Confirmation.ouverte ? 0px : 12px);
            animate y { duration: Affichage.duree-longue; easing: ease-out; }
            background: Theme.fond;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.bordure;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #0f172a33;

            contenu := VerticalLayout {
                padding: 24px;
                spacing: 20px;

                Text {
                    horizontal-alignment: Theme.debut;
                    text: Confirmation.message;
                    color: Theme.texte;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                // Boutons en fin de ligne ; la Rangee s'inverse de droite à gauche.
                Rangee {
                    alignment: end;
                    spacing: 8px;

                    revenir := Bouton {
                        text: @tr("Revenir");
                        clicked => {
                            Confirmation.repondre(false);
                        }
                    }

                    confirmer := Bouton {
                        text: Confirmation.bouton;
                        primary: true;
                        danger: Confirmation.danger;
                        clicked => {
                            Confirmation.repondre(true);
                        }
                    }
                }
            }
        }
    }
}

export component MessageErreur inherits Text {
    horizontal-alignment: Theme.debut;
    color: Theme.erreur;
    wrap: word-wrap;
}

// Entrée du menu latéral : icône Kadenz (ui/icones/menu, traits droits) et libellé.
// L'entrée active est sur fond Bleu vif.
export component ElementNavigation inherits Rectangle {
    in property <string> libelle;
    in property <image> icone;
    in property <bool> actif;
    callback clique();

    height: 36px;
    border-radius: 4px;
    background: root.actif ? Theme.accent : (zone.has-hover ? Theme.accent-survol : transparent);
    animate background { duration: Affichage.duree; }

    accessible-role: button;
    accessible-label: root.libelle;
    accessible-action-default => {
        root.clique();
    }

    // Icône et libellé partent du bord de début : à droite en arabe. L'entrée
    // active se distingue par son seul fond, sans repère sur un côté.
    Image {
        x: Theme.rtl ? parent.width - 12px - self.width : 12px;
        width: 18px;
        height: 18px;
        source: root.icone;
        colorize: root.actif ? Theme.texte-sur-accent : Theme.texte-secondaire;
    }

    Text {
        x: Theme.rtl ? 8px : 40px;
        width: parent.width - 48px;
        horizontal-alignment: Theme.debut;
        text: root.libelle;
        color: root.actif ? Theme.texte-sur-accent : Theme.texte;
        font-weight: root.actif ? 600 : 400;
        vertical-alignment: center;
        font-size: 14px;
        overflow: elide;
    }

    zone := TouchArea {
        clicked => {
            root.clique();
        }
    }
}

// Case à cocher aux couleurs du thème : la case standard (style Fluent) garde son bleu
// et ses gris, quels que soient le mode et la palette. Mêmes propriétés que CheckBox.
export component Case inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();

    min-height: 24px;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.basculer();
    }
    forward-focus: clavier;

    function basculer() {
        if (root.enabled) {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    clavier := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == " ") {
                root.basculer();
                return accept;
            }
            return reject;
        }
    }

    Rangee {
        spacing: 8px;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 3px;
                border-width: clavier.has-focus ? 2px : 1px;
                border-color: !root.enabled ? Theme.bordure
                    : clavier.has-focus ? Theme.focus
                    : root.checked ? Theme.accent : Theme.bordure-champ;
                background: !root.checked ? Theme.champ : root.enabled ? Theme.accent : Theme.desactive;
                animate background, border-color { duration: Affichage.duree; }

                if root.checked: Path {
                    width: 12px;
                    height: 12px;
                    viewbox-width: 12;
                    viewbox-height: 12;
                    commands: "M 1.5 6.5 L 4.5 9.5 L 10.5 2.5";
                    stroke: root.enabled ? Theme.texte-sur-accent : Theme.texte-desactive;
                    stroke-width: 2px;
                }
            }
        }

        Text {
            horizontal-alignment: Theme.debut;
            vertical-alignment: center;
            text: root.text;
            color: root.enabled ? Theme.texte : Theme.texte-desactive;
        }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            clavier.focus();
            root.basculer();
        }
    }
}

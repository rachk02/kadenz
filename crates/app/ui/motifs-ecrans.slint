// Motifs animés adoptés le 2026-11-18 (docs/marque/README.md, section Identité animée).
// Fichier généré par docs/marque/propositions-2026-11-18-ecrans-animes/generer_motifs_slint.py :
// le modifier là, puis relancer le script.
//
// - MotifA2 : Trame de pièces. Une pièce du symbole se compose en petites pièces ambre
//   sur le motif Quatre pièces ton sur ton (entrée jouée une fois), reflet lent en option.
// - MotifAnneaux : anneaux de points qui tournent lentement, pièce ambre au centre.
// - MotifTournant : quarts de disque qui tournent d'un quart de tour à chaque étape.
// Sans animation (réglage « Animer les transitions... » coupé), les motifs restent fixes.
import { Affichage, Theme } from "composants.slint";

// Couleurs des motifs : ton sur ton sur le fond du panneau (Theme.nuit), jamais de bleu
// en mode sombre ; seules les pièces vedettes sont en Ambre.
export global CouleursMotif {
    out property <color> motif: !Theme.sombre ? #232c6b : Theme.palette == 0 ? #212327 : Theme.palette == 1 ? #1c232b : #22201e;
    out property <color> reflet: !Theme.sombre ? #2a3478 : Theme.palette == 0 ? #2a2d32 : Theme.palette == 1 ? #253039 : #2c2a27;
    out property <color> lignes: Theme.sombre ? Theme.texte : #f4f5f9;
}

export struct CaseMotif { x: length, y: length, k: int, r: float }
struct CaseTournant { i: int, j: int, h: int, ambre: bool }

global DonneesMotif {
    out property <[CaseMotif]> carre: [{ x: 160px, y: 160px, k: 2, r: 0.062 }, { x: 205.71px, y: 160px, k: 3, r: 0.125 }, { x: 251.43px, y: 160px, k: 0, r: 0.188 }, { x: 297.14px, y: 160px, k: 1, r: 0.250 }, { x: 342.86px, y: 160px, k: 2, r: 0.313 }, { x: 388.57px, y: 160px, k: 3, r: 0.376 }, { x: 434.29px, y: 160px, k: 0, r: 0.438 }, { x: 480px, y: 160px, k: 1, r: 0.501 }, { x: 160px, y: 205.71px, k: 3, r: 0.125 }, { x: 205.71px, y: 205.71px, k: 0, r: 0.188 }, { x: 251.43px, y: 205.71px, k: 1, r: 0.250 }, { x: 297.14px, y: 205.71px, k: 2, r: 0.313 }, { x: 342.86px, y: 205.71px, k: 3, r: 0.376 }, { x: 388.57px, y: 205.71px, k: 0, r: 0.438 }, { x: 434.29px, y: 205.71px, k: 1, r: 0.501 }, { x: 480px, y: 205.71px, k: 2, r: 0.564 }, { x: 160px, y: 251.43px, k: 0, r: 0.188 }, { x: 205.71px, y: 251.43px, k: 1, r: 0.250 }, { x: 251.43px, y: 251.43px, k: 2, r: 0.313 }, { x: 297.14px, y: 251.43px, k: 3, r: 0.376 }, { x: 342.86px, y: 251.43px, k: 0, r: 0.438 }, { x: 388.57px, y: 251.43px, k: 1, r: 0.501 }, { x: 434.29px, y: 251.43px, k: 2, r: 0.564 }, { x: 480px, y: 251.43px, k: 3, r: 0.626 }, { x: 160px, y: 297.14px, k: 1, r: 0.250 }, { x: 205.71px, y: 297.14px, k: 2, r: 0.313 }, { x: 251.43px, y: 297.14px, k: 3, r: 0.376 }, { x: 297.14px, y: 297.14px, k: 0, r: 0.438 }, { x: 342.86px, y: 297.14px, k: 1, r: 0.501 }, { x: 388.57px, y: 297.14px, k: 2, r: 0.564 }, { x: 434.29px, y: 297.14px, k: 3, r: 0.626 }, { x: 480px, y: 297.14px, k: 0, r: 0.689 }, { x: 160px, y: 342.86px, k: 2, r: 0.313 }, { x: 205.71px, y: 342.86px, k: 3, r: 0.376 }, { x: 251.43px, y: 342.86px, k: 0, r: 0.438 }, { x: 297.14px, y: 342.86px, k: 1, r: 0.501 }, { x: 342.86px, y: 342.86px, k: 2, r: 0.564 }, { x: 388.57px, y: 342.86px, k: 3, r: 0.626 }, { x: 434.29px, y: 342.86px, k: 0, r: 0.689 }, { x: 480px, y: 342.86px, k: 1, r: 0.752 }, { x: 160px, y: 388.57px, k: 3, r: 0.376 }, { x: 205.71px, y: 388.57px, k: 0, r: 0.438 }, { x: 251.43px, y: 388.57px, k: 1, r: 0.501 }, { x: 297.14px, y: 388.57px, k: 2, r: 0.5
    out property <[CaseMotif]> disque: [{ x: 251.43px, y: 160px, k: 0, r: 0.188 }, { x: 297.14px, y: 160px, k: 1, r: 0.250 }, { x: 342.86px, y: 160px, k: 2, r: 0.313 }, { x: 388.57px, y: 160px, k: 3, r: 0.376 }, { x: 205.71px, y: 205.71px, k: 0, r: 0.188 }, { x: 251.43px, y: 205.71px, k: 1, r: 0.250 }, { x: 297.14px, y: 205.71px, k: 2, r: 0.313 }, { x: 342.86px, y: 205.71px, k: 3, r: 0.376 }, { x: 388.57px, y: 205.71px, k: 0, r: 0.438 }, { x: 434.29px, y: 205.71px, k: 1, r: 0.501 }, { x: 160px, y: 251.43px, k: 0, r: 0.188 }, { x: 205.71px, y: 251.43px, k: 1, r: 0.250 }, { x: 251.43px, y: 251.43px, k: 2, r: 0.313 }, { x: 297.14px, y: 251.43px, k: 3, r: 0.376 }, { x: 342.86px, y: 251.43px, k: 0, r: 0.438 }, { x: 388.57px, y: 251.43px, k: 1, r: 0.501 }, { x: 434.29px, y: 251.43px, k: 2, r: 0.564 }, { x: 480px, y: 251.43px, k: 3, r: 0.626 }, { x: 160px, y: 297.14px, k: 1, r: 0.250 }, { x: 205.71px, y: 297.14px, k: 2, r: 0.313 }, { x: 251.43px, y: 297.14px, k: 3, r: 0.376 }, { x: 297.14px, y: 297.14px, k: 0, r: 0.438 }, { x: 342.86px, y: 297.14px, k: 1, r: 0.501 }, { x: 388.57px, y: 297.14px, k: 2, r: 0.564 }, { x: 434.29px, y: 297.14px, k: 3, r: 0.626 }, { x: 480px, y: 297.14px, k: 0, r: 0.689 }, { x: 160px, y: 342.86px, k: 2, r: 0.313 }, { x: 205.71px, y: 342.86px, k: 3, r: 0.376 }, { x: 251.43px, y: 342.86px, k: 0, r: 0.438 }, { x: 297.14px, y: 342.86px, k: 1, r: 0.501 }, { x: 342.86px, y: 342.86px, k: 2, r: 0.564 }, { x: 388.57px, y: 342.86px, k: 3, r: 0.626 }, { x: 434.29px, y: 342.86px, k: 0, r: 0.689 }, { x: 480px, y: 342.86px, k: 1, r: 0.752 }, { x: 160px, y: 388.57px, k: 3, r: 0.376 }, { x: 205.71px, y: 388.57px, k: 0, r: 0.438 }, { x: 251.43px, y: 388.57px, k: 1, r: 0.501 }, { x: 297.14px, y: 388.57px, k: 2, r: 0.564 }, { x: 342.86px, y: 388.57px, k: 3, r: 0.626 }, { x: 388.57px, y: 388.57px, k: 0, r: 0.689 }, { x: 434.29px, y: 388.57px, k: 1, r: 0.752 }, { x: 480px, y: 388.57px, k: 2, r: 0.814 }, { x: 205.71px, y: 434.29px, k: 1, r: 0.501 }, { x: 251.43px, y: 434.29px, k: 2, r: 0.564 }, { x: 297.14px, y: 434.29px, k: 3, r: 0.626 }, { x: 342.86px, y: 434.29px, k: 0, r: 0.689 }, { x: 388.57px, y: 434.29px, k: 1, r: 0.752 }, { x: 434.29px, y: 434.29px, k: 2, r: 0.814 }, { x: 251.43px, y: 480px, k: 3, r: 0.626 }, { x: 297.14px, y: 480px, k: 0, r: 0.689 }, { x: 342.86px, y: 480px, k: 1, r: 0.752 }, { x: 388.57px, y: 480px, k: 2, r: 0.814 }];
    out property <[CaseTournant]> tournant: [{ i: 0, j: 0, h: 0, ambre: false }, { i: 1, j: 0, h: 1, ambre: false }, { i: 2, j: 0, h: 2, ambre: false }, { i: 0, j: 1, h: 3, ambre: false }, { i: 1, j: 1, h: 2, ambre: false }, { i: 2, j: 1, h: 1, ambre: false }, { i: 0, j: 2, h: 2, ambre: false }, { i: 1, j: 2, h: 3, ambre: true }, { i: 2, j: 2, h: 0, ambre: false }, { i: 0, j: 3, h: 1, ambre: false }, { i: 1, j: 3, h: 0, ambre: false }, { i: 2, j: 3, h: 3, ambre: false }];
}

// Entrée jouée une fois : t en secondes depuis l'apparition, figé à la fin (la fenêtre
// ne se redessine plus) ou d'emblée quand les animations sont coupées.
component Entree inherits Rectangle {
    width: 0px;
    height: 0px;
    in property <duration> longueur: 1900ms;
    out property <float> t: (self.fini || !Affichage.animations) ? 9 : (animation-tick() - self.depart) / 1s;
    property <duration> depart;
    property <bool> fini: false;
    init => {
        self.depart = animation-tick();
    }
    Timer {
        interval: root.longueur;
        running: !root.fini;
        triggered => {
            root.fini = true;
        }
    }
}

// Trame de pièces sur un panneau (référence 640 x 760 posée en « cover »).
// piece : 0 carré, 1 quart de disque, 2 triangle, 3 disque.
export component MotifA2 inherits Rectangle {
    in property <int> piece: 0;
    // Reflet très lent qui passe sur le motif (connexion ; quart de disque seulement).
    in property <bool> reflet: false;
    property <float> s: max(self.width / 640px, self.height / 760px);
    property <length> ox: (self.width - 640px * self.s) / 2;
    property <length> oy: (self.height - 760px * self.s) / 2;
    property <float> g: clamp((entree.t - 0.2) / 1.4, 0, 1) * 1.25;
    property <float> tr: Affichage.animations ? animation-tick() / 1s : 0;
    clip: true;
    // Taille imposée par l'écran : le motif ne réclame rien à la mise en page (sinon boucle).
    min-width: 0px;
    min-height: 0px;
    preferred-width: 0px;
    preferred-height: 0px;

    pure function rebond(x: float) -> float {
        return 1 + 2.70158 * (x - 1) * (x - 1) * (x - 1) + 1.70158 * (x - 1) * (x - 1);
    }

    entree := Entree { }

    // Taille donnée par le motif, jamais en pourcentage : une image en 100 % remonte sa
    // hauteur préférée au panneau, qui dépend de sa largeur (boucle).
    Image {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        image-fit: cover;
        colorize: CouleursMotif.motif;
        source: root.piece == 0 ? @image-url("icones/motifs/a2-fond-carre.svg") : root.piece == 1 ? @image-url("icones/motifs/a2-fond-quart.svg") : root.piece == 2 ? @image-url("icones/motifs/a2-fond-tri.svg") : @image-url("icones/motifs/a2-fond-disque.svg");
    }

    if root.reflet && root.piece == 1: Rectangle {
        for k in 7: Image {
            width: root.width;
            height: root.height;
            image-fit: cover;
            colorize: CouleursMotif.reflet;
            opacity: clamp((0.5 + 0.5 * sin((2 * k + 0.5) * 0.45rad - root.tr * 45deg) - 0.75) / 0.25, 0, 1);
            source: k == 0 ? @image-url("icones/motifs/a2-reflet-quart-0.svg") : k == 1 ? @image-url("icones/motifs/a2-reflet-quart-1.svg") : k == 2 ? @image-url("icones/motifs/a2-reflet-quart-2.svg") : k == 3 ? @image-url("icones/motifs/a2-reflet-quart-3.svg") : k == 4 ? @image-url("icones/motifs/a2-reflet-quart-4.svg") : k == 5 ? @image-url("icones/motifs/a2-reflet-quart-5.svg") : @image-url("icones/motifs/a2-reflet-quart-6.svg");
        }
    }

    for c in root.piece == 0 ? DonneesMotif.carre : root.piece == 1 ? DonneesMotif.quart : root.piece == 2 ? DonneesMotif.tri : DonneesMotif.disque: Image {
        property <float> e: root.rebond(clamp((root.g - c.r) / 0.25, 0, 1));
        x: root.ox + c.x * root.s - self.width / 2;
        y: root.oy + c.y * root.s - self.height / 2;
        width: 40.83px * root.s;
        height: self.width;
        visible: self.e > 0.01;
        colorize: Theme.ambre;
        source: c.k == 0 ? @image-url("icones/motifs/motif-piece-carre.svg") : c.k == 1 ? @image-url("icones/motifs/motif-piece-quart.svg") : c.k == 2 ? @image-url("icones/motifs/motif-piece-tri.svg") : @image-url("icones/motifs/motif-piece-disque.svg");
        transform-scale-x: self.e * 100%;
        transform-scale-y: self.e * 100%;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
    }
}

// Anneaux de points autour d'un centre hors du panneau, à gauche ; ils tournent très
// lentement (un tour en 288 s, la couche intérieure deux fois plus vite). Zone nette
// en haut (logo) et en bas (« Gestion commerciale »).
export component MotifAnneaux inherits Rectangle {
    in property <int> piece: 3;
    property <length> rayon: 1.15 * max(self.width, 1.4 * self.height);
    property <length> cx: -0.32 * self.width;
    property <length> cy: 0.36 * self.height;
    property <float> tours: Affichage.animations ? animation-tick() / 288s : 0;
    property <length> cote: 0.6 * min(self.width, 0.8 * self.height) * 0.62;
    clip: true;
    // Taille imposée par l'écran : le motif ne réclame rien à la mise en page (sinon boucle).
    min-width: 0px;
    min-height: 0px;
    preferred-width: 0px;
    preferred-height: 0px;

    pure function rebond(x: float) -> float {
        return 1 + 2.70158 * (x - 1) * (x - 1) * (x - 1) + 1.70158 * (x - 1) * (x - 1);
    }

    entree := Entree { longueur: 1300ms; }

    Rectangle {
        y: 100px;
        width: root.width;
        height: max(0px, root.height - 250px);
        clip: true;

        Image {
            x: root.cx + 0.08 * root.rayon;
            y: root.cy + -0.68 * root.rayon - 100px;
            width: 0.62 * root.rayon;
            height: 1.36 * root.rayon;
            source: Theme.sombre ? @image-url("icones/motifs/anneaux-1-sombre.svg") : @image-url("icones/motifs/anneaux-1-clair.svg");
            transform-rotation: mod(root.tours * 24, 1) * 15deg;
            transform-origin: { x: -0.08 * root.rayon, y: 0.68 * root.rayon };
        }

        Image {
            x: root.cx + 0.08 * root.rayon;
            y: root.cy + -0.68 * root.rayon - 100px;
            width: 0.62 * root.rayon;
            height: 1.36 * root.rayon;
            source: Theme.sombre ? @image-url("icones/motifs/anneaux-2-sombre.svg") : @image-url("icones/motifs/anneaux-2-clair.svg");
            transform-rotation: mod(root.tours * 48, 1) * 15deg;
            transform-origin: { x: -0.08 * root.rayon, y: 0.68 * root.rayon };
        }
    }

    Image {
        property <float> e: root.rebond(clamp((entree.t - 0.3) / 0.8, 0, 1));
        x: root.width / 2 - self.width / 2;
        y: 0.42 * root.height - self.height / 2;
        width: root.cote * 108 / 104;
        height: self.width;
        visible: self.e > 0.01;
        colorize: Theme.ambre;
        source: root.piece == 0 ? @image-url("icones/motifs/motif-piece-carre.svg") : root.piece == 1 ? @image-url("icones/motifs/motif-piece-quart.svg") : root.piece == 2 ? @image-url("icones/motifs/motif-piece-tri.svg") : @image-url("icones/motifs/motif-piece-disque.svg");
        transform-scale-x: self.e * 100%;
        transform-scale-y: self.e * 100%;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
    }
}

// Quarts de disque au bas d'une colonne étroite (3 cases de large, 4 rangées) : chaque
// case avance d'un quart de tour quand etape change, en vague (décalage par diagonale).
export component MotifTournant inherits Rectangle {
    in property <int> etape: 0;
    property <length> cote: self.width / 3;
    clip: true;
    // Taille imposée par l'écran : le motif ne réclame rien à la mise en page (sinon boucle).
    min-width: 0px;
    min-height: 0px;
    preferred-width: 0px;
    preferred-height: 0px;

    for c in DonneesMotif.tournant: Image {
        x: c.i * root.cote;
        y: root.height - (4 - c.j) * root.cote;
        width: root.cote;
        height: root.cote;
        colorize: c.ambre ? Theme.ambre : CouleursMotif.motif;
        source: @image-url("icones/motifs/tournant-quart.svg");
        transform-rotation: (c.h + root.etape) * 90deg;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        animate transform-rotation {
            duration: Affichage.animations ? 700ms : 0ms;
            delay: Affichage.animations ? (c.i + c.j) * 60ms : 0ms;
            easing: ease-in-out;
        }
    }
}

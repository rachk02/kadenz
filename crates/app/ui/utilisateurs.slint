// Écran Utilisateurs : comptes et matrice des droits par rôle
// (cahier des charges, sections 10.1 et 10.2).

import { CheckBox, ComboBox, ScrollView, StandardTableView, TabWidget } from "std-widgets.slint";
import { Alerte, Bouton, Champ, MessageRetour, Rangee, Retour, Section, Theme, Titre } from "composants.slint";

export struct CompteUi {
    nom: string,
    identifiant: string,
    // Rang dans Admin, Comptable, Commercial, Consultation.
    role: int,
    actif: bool,
    existe: bool,
    // Compte de la session en cours : son rôle et son état se changent depuis un autre compte.
    soi-meme: bool,
}

export struct LigneDroitUi {
    libelle: string,
    // Une case par rôle, dans l'ordre des rôles.
    autorisations: [bool],
    // Case non modifiable (le rôle Admin garde la gestion des utilisateurs).
    verrous: [bool],
}

export global UtilisateursApi {
    in property <[[StandardListViewItem]]> lignes;
    in-out property <int> ligne-courante: -1;
    in property <[string]> roles;
    callback ouvrir();
    callback selectionner(ligne: int) -> CompteUi;
    callback nouveau() -> CompteUi;
    callback compte-courant() -> CompteUi;
    callback creer(nom: string, identifiant: string, role: int, mot-de-passe: string, confirmation: string) -> Retour;
    callback changer-role(role: int) -> Retour;
    callback basculer-actif() -> Retour;
    callback reinitialiser(mot-de-passe: string, confirmation: string) -> Retour;

    in property <[LigneDroitUi]> matrice;
    callback ouvrir-matrice();
    callback basculer-droit(ligne: int, colonne: int, autorise: bool);
    callback matrice-par-defaut();
    callback enregistrer-matrice() -> Retour;
}

component OngletComptes inherits ScrollView {
    // Page étroite (Paramètres à côté d'une barre latérale) : le formulaire passe sous la liste.
    in property <bool> etroit;
    property <CompteUi> compte;
    property <Retour> retour;

    function charger(c: CompteUi) {
        root.compte = c;
        nom.valeur = c.nom;
        identifiant.valeur = c.identifiant;
        role.current-index = c.role;
        mot-de-passe.valeur = "";
        confirmation.valeur = "";
    }

    init => {
        UtilisateursApi.ouvrir();
        root.charger(UtilisateursApi.nouveau());
    }

    // Liste et formulaire côte à côte (échangés de droite à gauche), ou l'un sous l'autre.
    GridLayout {
        padding-top: 12px;
        spacing: 16px;

        VerticalLayout {
            row: 0;
            col: root.etroit ? 0 : (Theme.rtl ? 1 : 0);
            spacing: 8px;

            StandardTableView {
                min-height: root.etroit ? 220px : 120px;
                // De droite à gauche, colonnes en ordre inverse (cellules inversées dans modele_lignes).
                columns: Theme.rtl ? [
                    { title: @tr("État"), min-width: 90px, horizontal-stretch: 1 },
                    { title: @tr("Rôle"), min-width: 110px, horizontal-stretch: 1 },
                    { title: @tr("Identifiant"), min-width: 110px, horizontal-stretch: 1 },
                    { title: @tr("Nom complet"), min-width: 160px, horizontal-stretch: 2 },
                ] : [
                    { title: @tr("Nom complet"), min-width: 160px, horizontal-stretch: 2 },
                    { title: @tr("Identifiant"), min-width: 110px, horizontal-stretch: 1 },
                    { title: @tr("Rôle"), min-width: 110px, horizontal-stretch: 1 },
                    { title: @tr("État"), min-width: 90px, horizontal-stretch: 1 },
                ];
                rows: UtilisateursApi.lignes;
                current-row <=> UtilisateursApi.ligne-courante;
                current-row-changed(ligne) => {
                    root.retour = { };
                    root.charger(UtilisateursApi.selectionner(ligne));
                }
            }

            Rangee {
                alignment: start;

                Bouton {
                    text: @tr("Nouveau compte");
                    clicked => {
                        root.retour = { };
                        root.charger(UtilisateursApi.nouveau());
                    }
                }
            }
        }

        VerticalLayout {
            row: root.etroit ? 1 : 0;
            col: root.etroit ? 0 : (Theme.rtl ? 0 : 1);
            min-width: root.etroit ? 0px : 340px;
            max-width: root.etroit ? 100000px : 340px;
            spacing: 10px;

            Section {
                text: root.compte.existe ? (root.compte.actif ? @tr("Compte") : @tr("Compte (désactivé)")) : @tr("Nouveau compte");
            }

            nom := Champ {
                libelle: @tr("Nom complet");
                lecture-seule: root.compte.existe;
            }

            identifiant := Champ {
                libelle: @tr("Identifiant de connexion");
                lecture-seule: root.compte.existe;
            }

            VerticalLayout {
                spacing: 4px;

                Text {
                    horizontal-alignment: Theme.debut;
                    text: @tr("Rôle");
                    font-size: 12px;
                    color: Theme.texte-secondaire;
                }

                role := ComboBox {
                    model: UtilisateursApi.roles;
                    enabled: !root.compte.soi-meme;
                }
            }

            if root.compte.existe && !root.compte.soi-meme: Rangee {
                spacing: 8px;
                alignment: start;

                Bouton {
                    text: @tr("Changer le rôle");
                    enabled: role.current-index != root.compte.role;
                    clicked => {
                        root.retour = UtilisateursApi.changer-role(role.current-index);
                        Alerte.retour(root.retour);
                        root.charger(UtilisateursApi.compte-courant());
                    }
                }

                Bouton {
                    text: root.compte.actif ? @tr("Désactiver") : @tr("Réactiver");
                    clicked => {
                        root.retour = UtilisateursApi.basculer-actif();
                        Alerte.retour(root.retour);
                        root.charger(UtilisateursApi.compte-courant());
                    }
                }
            }

            if root.compte.soi-meme: Text {
                horizontal-alignment: Theme.debut;
                text: @tr("C'est le compte de la session en cours : son rôle et son état se changent depuis un autre compte administrateur. Le mot de passe se change dans « Mon compte ».");
                color: Theme.texte-secondaire;
                wrap: word-wrap;
            }

            if !root.compte.soi-meme: Section {
                text: root.compte.existe ? @tr("Réinitialiser le mot de passe") : @tr("Mot de passe");
            }

            mot-de-passe := Champ {
                visible: !root.compte.soi-meme;
                libelle: @tr("Mot de passe (8 caractères au moins)");
                secret: true;
            }

            confirmation := Champ {
                visible: !root.compte.soi-meme;
                libelle: @tr("Confirmation");
                secret: true;
            }

            if !root.compte.soi-meme: Rangee {
                alignment: start;

                Bouton {
                    text: root.compte.existe ? @tr("Réinitialiser le mot de passe") : @tr("Créer le compte");
                    primary: true;
                    clicked => {
                        if (root.compte.existe) {
                            root.retour = UtilisateursApi.reinitialiser(mot-de-passe.valeur, confirmation.valeur);
                            Alerte.retour(root.retour);
                        } else {
                            root.retour = UtilisateursApi.creer(nom.valeur, identifiant.valeur, role.current-index, mot-de-passe.valeur, confirmation.valeur);
                            Alerte.retour(root.retour);
                        }
                        if (root.retour.ok) {
                            root.charger(UtilisateursApi.compte-courant());
                        }
                    }
                }
            }

            MessageRetour {
                erreurs-seules: true;
                retour: root.retour;
            }

            Rectangle { }
        }
    }
}

component OngletDroits inherits ScrollView {
    // Page étroite : colonnes des rôles resserrées pour laisser de la place aux libellés.
    in property <bool> etroit;
    property <Retour> retour;
    property <length> largeur-role: root.etroit ? 92px : 110px;

    init => {
        UtilisateursApi.ouvrir-matrice();
    }

    VerticalLayout {
        padding-top: 12px;
        spacing: 6px;
        alignment: start;

        Text {
            horizontal-alignment: Theme.debut;
            text: @tr("Cocher ce que chaque rôle peut faire. Le rôle Admin garde toujours la gestion des utilisateurs et des droits. Les contrôles s'appliquent dès l'enregistrement ; le menu des autres comptes se met à jour à leur prochaine connexion.");
            color: Theme.texte-secondaire;
            wrap: word-wrap;
        }

        Rangee {
            spacing: 8px;
            height: 32px;

            Rectangle {
                horizontal-stretch: 1;
            }

            for nom in UtilisateursApi.roles: Text {
                width: root.largeur-role;
                text: nom;
                font-size: root.etroit ? 12px : 14px;
                font-weight: 700;
                color: Theme.texte;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        for ligne[i] in UtilisateursApi.matrice: Rectangle {
            height: 36px;
            background: mod(i, 2) == 0 ? Theme.fond-lateral : transparent;

            Rangee {
                padding-left: 8px;
                spacing: 8px;

                Text {
                    horizontal-alignment: Theme.debut;
                    horizontal-stretch: 1;
                    text: ligne.libelle;
                    color: Theme.texte;
                    vertical-alignment: center;
                    overflow: elide;
                }

                for autorise[j] in ligne.autorisations: Rangee {
                    width: root.largeur-role;
                    alignment: center;

                    CheckBox {
                        checked: autorise;
                        enabled: !ligne.verrous[j];
                        toggled => {
                            UtilisateursApi.basculer-droit(i, j, self.checked);
                        }
                    }
                }
            }
        }

        Rangee {
            padding-top: 8px;
            spacing: 8px;
            alignment: start;

            Bouton {
                text: @tr("Enregistrer les droits");
                primary: true;
                clicked => {
                    root.retour = UtilisateursApi.enregistrer-matrice();
                    Alerte.retour(root.retour);
                }
            }

            Bouton {
                text: @tr("Revenir à la matrice du cahier des charges");
                clicked => {
                    root.retour = { };
                    UtilisateursApi.matrice-par-defaut();
                }
            }
        }

        // Sous les boutons et non dans leur rangée : un texte à la ligne dans une
        // Rangee (FlexboxLayout) ferait boucler le calcul de largeur de la page défilante.
        MessageRetour {
            erreurs-seules: true;
            retour: root.retour;
        }
    }
}

export component PageUtilisateurs inherits VerticalLayout {
    in property <bool> etroit;
    padding: 24px;
    spacing: 8px;

    Titre {
        text: @tr("Utilisateurs");
    }

    TabWidget {
        Tab {
            title: @tr("Comptes");
            OngletComptes {
                etroit: root.etroit;
            }
        }

        Tab {
            title: @tr("Droits par rôle");
            OngletDroits {
                etroit: root.etroit;
            }
        }
    }
}

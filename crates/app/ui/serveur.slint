// Serveur de l'entreprise (phase 2, jalon F4 ; écrans, section 2) : rubrique
// « Serveur » des Paramètres. Un poste non relié s'inscrit avec un code créé par
// l'Admin : le code complet porte l'adresse et l'empreinte du serveur, que le
// poste vérifie seul ; le code court demande l'adresse (recherche sur le réseau
// local ou saisie), puis la comparaison de l'empreinte à celle de la fenêtre du
// serveur. Un poste relié montre son serveur et peut tester la connexion.
// Les appels au réseau tournent hors du fil de l'interface : les résultats
// arrivent par les propriétés (occupe, retour, trouves...).
import { ScrollView } from "std-widgets.slint";
import { Alerte, Bouton, Champ, Confirmation, Droits, Ecriture, MessageRetour, Retour, Section, Theme, Titre, ZoneTexte } from "composants.slint";

export struct ServeurTrouveUi {
    machine: string,
    adresse: string,
}

// Ligne du résumé d'une base V1 avant sa reprise (F7, section 8).
export struct LigneResumeUi {
    libelle: string,
    valeur: string,
}

// Brouillon dont la validation a été demandée hors connexion (section 4).
export struct DocumentAValiderUi {
    id: int,
    libelle: string,
}

export global ServeurApi {
    in property <bool> relie;
    in property <string> adresse;
    in property <string> entreprise;
    in property <string> nom-poste;
    in property <string> empreinte;
    // Appel au serveur en cours : boutons inactifs.
    in property <bool> occupe;
    in property <[ServeurTrouveUi]> trouves;
    in property <bool> recherche-faite;
    // Recours du code court : empreinte présentée par le serveur, à confirmer.
    in property <string> empreinte-a-confirmer;
    in property <Retour> retour;

    callback rechercher();
    callback inscrire(code: string, adresse: string);
    callback confirmer();
    callback abandonner();
    callback tester();

    // Documents à valider au retour du serveur : ouverts un par un, ou tous
    // validés ensemble, chacun recevant son numéro.
    in property <[DocumentAValiderUi]> a-valider;
    callback ouvrir-a-valider(id: int);
    callback tout-valider() -> Retour;

    // Reprise d'une base V1 (F7, section 8), Admin d'un poste relié et
    // connecté. reprise-etat : 0 pas encore vérifié, 1 serveur neuf, 2 serveur
    // qui a déjà des données (décision 55), 3 reprise faite.
    in property <int> reprise-etat;
    in property <string> reprise-fichier;
    in property <[LigneResumeUi]> reprise-resume;
    in property <[string]> reprise-ecartes;
    in property <bool> reprise-occupe;
    in property <Retour> reprise-retour;
    callback reprise-verifier();
    callback reprise-choisir-fichier();
    callback reprise-resumer(sauvegarde: bool, mot-de-passe: string);
    callback reprise-lancer(sauvegarde: bool, mot-de-passe: string);

    // Sauvegardes du serveur en défaut (décision 56), pour un compte Admin :
    // texte du bandeau permanent, vide sinon.
    in property <string> avertissement-sauvegarde;
}

// Bandeau permanent des sauvegardes du serveur (décision 56) : le réglage se
// fait dans la fenêtre du serveur, sur sa machine, d'où l'absence de bouton.
export component BandeauSauvegarde inherits Rectangle {
    background: Theme.fond-attente;
    border-width: 1px;
    border-color: Theme.ambre;
    border-radius: 4px;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 8px;
        padding-bottom: 8px;

        Text {
            horizontal-alignment: Theme.debut;
            text: ServeurApi.avertissement-sauvegarde;
            color: Theme.texte;
            font-weight: 600;
            wrap: word-wrap;
        }
    }
}

component Ligne inherits GridLayout {
    in property <string> libelle;
    in property <string> valeur;
    spacing: 16px;

    Text {
        row: 0;
        col: Theme.rtl ? 1 : 0;
        width: 160px;
        horizontal-alignment: Theme.debut;
        text: root.libelle;
        color: Theme.texte-secondaire;
    }

    Text {
        row: 0;
        col: Theme.rtl ? 0 : 1;
        horizontal-alignment: Theme.debut;
        text: root.valeur;
        color: Theme.texte;
        wrap: word-wrap;
    }
}

// Inscription d'un poste par code : rubrique « Serveur » d'un poste non relié,
// et écran de premier lancement.
export component InscriptionPoste inherits VerticalLayout {
    // Écran de premier lancement (refonte du 2026-11-18) : ni titre ni consigne au-dessus
    // du code, une aide courte dessous ; l'écran porte déjà le titre.
    in property <bool> compact: false;
    property <string> code;
    property <string> adresse;
    spacing: 12px;

    if !root.compact: Section {
        text: @tr("Inscription de ce poste");
    }

    if !root.compact: Text {
        horizontal-alignment: Theme.debut;
        text: @tr("Collez le code complet, ou tapez le code court (XXXX-XXXX-XXXX) et indiquez l'adresse du serveur.");
        color: Theme.texte-secondaire;
        wrap: word-wrap;
    }

    VerticalLayout {
        spacing: 4px;

        Text {
            horizontal-alignment: Theme.debut;
            text: @tr("Code d'inscription");
            font-size: 12px;
            color: Theme.texte-secondaire;
        }

        ZoneTexte {
            text <=> root.code;
            font-family: "ABC Diatype Mono";
            font-size: 12px;
            wrap: char-wrap;
            height: 72px;
            enabled: ServeurApi.empreinte-a-confirmer == "";
        }

        if root.compact: Text {
            horizontal-alignment: Theme.debut;
            text: @tr("Code complet, ou code court XXXX-XXXX-XXXX avec l'adresse du serveur.");
            font-size: 12px;
            color: Theme.texte-secondaire;
            wrap: word-wrap;
        }
    }

    HorizontalLayout {
        spacing: 8px;

        Champ {
            horizontal-stretch: 1;
            libelle: @tr("Adresse du serveur (code court seulement)");
            valeur <=> root.adresse;
        }

        VerticalLayout {
            alignment: end;

            Bouton {
                text: @tr("Rechercher sur le réseau");
                enabled: !ServeurApi.occupe;
                clicked => {
                    ServeurApi.rechercher();
                }
            }
        }
    }

    if ServeurApi.recherche-faite && ServeurApi.trouves.length == 0: Text {
        horizontal-alignment: Theme.debut;
        text: @tr("Aucun serveur Kadenz trouvé sur le réseau local. Saisissez son adresse, ou collez le code complet.");
        color: Theme.texte-secondaire;
        wrap: word-wrap;
    }

    for trouve in ServeurApi.trouves: HorizontalLayout {
        spacing: 12px;

        Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            horizontal-alignment: Theme.debut;
            text: @tr("{} ({})", trouve.machine, trouve.adresse);
            color: Theme.texte;
            wrap: word-wrap;
        }

        // Le serveur choisi le montre : bouton inactif, « Choisi ».
        Bouton {
            text: root.adresse == trouve.adresse ? @tr("Choisi") : @tr("Choisir");
            enabled: root.adresse != trouve.adresse;
            clicked => {
                root.adresse = trouve.adresse;
            }
        }
    }

    if ServeurApi.empreinte-a-confirmer == "": HorizontalLayout {
        alignment: Theme.rangee-debut;

        Bouton {
            text: @tr("Inscrire ce poste");
            primary: true;
            enabled: !ServeurApi.occupe;
            clicked => {
                ServeurApi.inscrire(root.code, root.adresse);
            }
        }
    }

    // Recours du code court : comparaison de l'empreinte, jamais une
    // acceptation silencieuse.
    if ServeurApi.empreinte-a-confirmer != "": Rectangle {
        border-width: 1px;
        border-color: Theme.bordure;
        border-radius: 4px;
        background: Theme.fond-lateral;

        VerticalLayout {
            padding: 14px;
            spacing: 8px;

            Text {
                horizontal-alignment: Theme.debut;
                text: @tr("Le serveur présente cette empreinte. Comparez-la à celle de la fenêtre du serveur : si elles diffèrent, n'allez pas plus loin.");
                color: Theme.texte;
                font-weight: 600;
                wrap: word-wrap;
            }

            Text {
                horizontal-alignment: Theme.debut;
                text: ServeurApi.empreinte-a-confirmer;
                font-family: "ABC Diatype Mono";
                color: Theme.texte;
                wrap: char-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: Theme.rangee-debut;

                Bouton {
                    text: @tr("Les empreintes sont identiques : inscrire");
                    primary: true;
                    enabled: !ServeurApi.occupe;
                    clicked => {
                        ServeurApi.confirmer();
                    }
                }

                Bouton {
                    text: @tr("Annuler");
                    enabled: !ServeurApi.occupe;
                    clicked => {
                        ServeurApi.abandonner();
                    }
                }
            }
        }
    }
}

// Assistant de reprise d'une base V1 dans un serveur neuf (F7, section 8 ;
// décisions 19 et 53 à 55) : source, résumé lu sur ce poste, confirmation,
// bilan mesuré sur le serveur.
component RepriseV1 inherits VerticalLayout {
    property <bool> sauvegarde;
    property <string> mot-de-passe;
    property <bool> demande;
    spacing: 12px;

    Section {
        text: @tr("Reprise d'une base V1");
    }

    Text {
        horizontal-alignment: Theme.debut;
        text: @tr("Un serveur neuf peut reprendre une base de la version 1 : celle de ce poste ou une sauvegarde .kzs. La reprise se fait une seule fois ; la base d'origine n'est jamais effacée et la numérotation continue après ses numéros.");
        color: Theme.texte-secondaire;
        wrap: word-wrap;
    }

    if ServeurApi.reprise-etat == 0: HorizontalLayout {
        alignment: Theme.rangee-debut;

        Bouton {
            text: @tr("Vérifier que le serveur est neuf");
            enabled: Ecriture.reglages && !ServeurApi.reprise-occupe;
            clicked => {
                ServeurApi.reprise-verifier();
            }
        }
    }

    if ServeurApi.reprise-etat == 2: Text {
        horizontal-alignment: Theme.debut;
        text: @tr("Le serveur a déjà des données (tiers, produits, documents ou règlements) : une base V1 ne peut être reprise que sur un serveur neuf. Les autres installations V1 restent consultables à part.");
        color: Theme.texte;
        wrap: word-wrap;
    }

    if ServeurApi.reprise-etat == 1: VerticalLayout {
        spacing: 12px;

        HorizontalLayout {
            spacing: 8px;
            alignment: Theme.rangee-debut;

            Bouton {
                text: @tr("Base V1 de ce poste");
                primary: !root.sauvegarde;
                enabled: !ServeurApi.reprise-occupe;
                clicked => {
                    root.sauvegarde = false;
                }
            }

            Bouton {
                text: @tr("Sauvegarde .kzs");
                primary: root.sauvegarde;
                enabled: !ServeurApi.reprise-occupe;
                clicked => {
                    root.sauvegarde = true;
                }
            }
        }

        if root.sauvegarde: HorizontalLayout {
            spacing: 12px;

            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                horizontal-alignment: Theme.debut;
                text: ServeurApi.reprise-fichier == "" ? @tr("Aucune sauvegarde choisie.") : ServeurApi.reprise-fichier;
                color: ServeurApi.reprise-fichier == "" ? Theme.texte-secondaire : Theme.texte;
                wrap: char-wrap;
            }

            Bouton {
                text: @tr("Choisir une sauvegarde");
                enabled: !ServeurApi.reprise-occupe;
                clicked => {
                    ServeurApi.reprise-choisir-fichier();
                }
            }
        }

        if root.sauvegarde: Champ {
            libelle: @tr("Mot de passe de la sauvegarde");
            secret: true;
            valeur <=> root.mot-de-passe;
        }

        HorizontalLayout {
            alignment: Theme.rangee-debut;

            Bouton {
                text: @tr("Voir le résumé");
                enabled: !ServeurApi.reprise-occupe && (!root.sauvegarde || ServeurApi.reprise-fichier != "");
                clicked => {
                    ServeurApi.reprise-resumer(root.sauvegarde, root.mot-de-passe);
                }
            }
        }

        if ServeurApi.reprise-resume.length > 0: Rectangle {
            border-width: 1px;
            border-color: Theme.bordure;
            border-radius: 4px;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                for ligne in ServeurApi.reprise-resume: Ligne {
                    libelle: ligne.libelle;
                    valeur: ligne.valeur;
                }

                if ServeurApi.reprise-ecartes.length > 0: Text {
                    horizontal-alignment: Theme.debut;
                    text: @tr("Comptes non repris, parce que le serveur a déjà un compte du même identifiant :");
                    color: Theme.texte;
                    wrap: word-wrap;
                }

                for identifiant in ServeurApi.reprise-ecartes: Text {
                    horizontal-alignment: Theme.debut;
                    text: identifiant;
                    color: Theme.texte;
                    font-family: "ABC Diatype Mono";
                }
            }
        }

        if ServeurApi.reprise-resume.length > 0: HorizontalLayout {
            alignment: Theme.rangee-debut;

            Bouton {
                text: @tr("Reprendre cette base");
                primary: true;
                enabled: Ecriture.reglages && !ServeurApi.reprise-occupe;
                clicked => {
                    root.demande = true;
                    Confirmation.demander(@tr("Reprendre cette base dans le serveur ? La reprise ne se fait qu'une fois. La fiche de l'entreprise et les paramètres de la base V1 remplacent ceux du serveur ; la base V1 d'origine n'est pas effacée."), @tr("Reprendre"), false);
                }
            }
        }
    }

    if ServeurApi.reprise-occupe: Text {
        horizontal-alignment: Theme.debut;
        text: @tr("Reprise en cours : le serveur reçoit la base, cela peut prendre une ou deux minutes...");
        color: Theme.texte-secondaire;
        wrap: word-wrap;
    }

    // Bilan mesuré sur le serveur, une fois la reprise faite.
    if ServeurApi.reprise-etat == 3: VerticalLayout {
        spacing: 8px;

        for ligne in ServeurApi.reprise-resume: Ligne {
            libelle: ligne.libelle;
            valeur: ligne.valeur;
        }
    }

    MessageRetour {
        retour: ServeurApi.reprise-retour;
    }

    // Réponse de la confirmation commune : seule celle que cette page a demandée.
    property <int> reponses: Confirmation.reponses;
    changed reponses => {
        if (root.demande) {
            root.demande = false;
            if (Confirmation.accepte) {
                ServeurApi.reprise-lancer(root.sauvegarde, root.mot-de-passe);
            }
        }
    }
}

export component PageServeur inherits ScrollView {
    property <Retour> retour-validation;

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        alignment: start;

        Titre {
            text: @tr("Serveur");
        }

        Text {
            horizontal-alignment: Theme.debut;
            text: @tr("Ce poste rejoint le serveur de l'entreprise avec un code d'inscription, créé par l'Admin dans la fenêtre du serveur ou depuis un poste. La connexion est ensuite épinglée : un autre certificat la bloque.");
            color: Theme.texte-secondaire;
            wrap: word-wrap;
        }

        if ServeurApi.relie: VerticalLayout {
            spacing: 12px;

            Section {
                text: @tr("Serveur de ce poste");
            }

            Ligne {
                libelle: @tr("Adresse");
                valeur: ServeurApi.adresse;
            }

            Ligne {
                libelle: @tr("Nom du poste");
                valeur: ServeurApi.nom-poste;
            }

            Ligne {
                libelle: @tr("Identifiant de l'entreprise");
                valeur: ServeurApi.entreprise;
            }

            Ligne {
                libelle: @tr("Empreinte du serveur");
                valeur: ServeurApi.empreinte;
            }

            HorizontalLayout {
                alignment: Theme.rangee-debut;

                Bouton {
                    text: @tr("Tester la connexion");
                    enabled: !ServeurApi.occupe;
                    clicked => {
                        ServeurApi.tester();
                    }
                }
            }
        }

        if ServeurApi.relie && ServeurApi.a-valider.length > 0: VerticalLayout {
            spacing: 12px;

            Section {
                text: @tr("Documents à valider au retour");
            }

            Text {
                horizontal-alignment: Theme.debut;
                text: Ecriture.validation
                    ? @tr("Ces brouillons attendent leur validation : le serveur leur attribue leur numéro. Validez-les un par un depuis leur fiche, ou tous ensemble.")
                    : @tr("Ces brouillons seront proposés à la validation au retour du serveur, qui leur attribuera leur numéro.");
                color: Theme.texte-secondaire;
                wrap: word-wrap;
            }

            for document in ServeurApi.a-valider: HorizontalLayout {
                spacing: 12px;

                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    horizontal-alignment: Theme.debut;
                    text: document.libelle;
                    color: Theme.texte;
                    wrap: word-wrap;
                }

                Bouton {
                    text: @tr("Ouvrir");
                    clicked => {
                        ServeurApi.ouvrir-a-valider(document.id);
                    }
                }
            }

            HorizontalLayout {
                alignment: Theme.rangee-debut;

                Bouton {
                    text: @tr("Tout valider");
                    primary: true;
                    enabled: Ecriture.validation;
                    clicked => {
                        root.retour-validation = Alerte.relayer(ServeurApi.tout-valider());
                    }
                }
            }

            MessageRetour {
                retour: root.retour-validation;
            }
        }

        if ServeurApi.relie && Droits.gerer-parametres: RepriseV1 { }

        if !ServeurApi.relie: InscriptionPoste { }

        if ServeurApi.occupe: Text {
            horizontal-alignment: Theme.debut;
            text: @tr("Connexion au serveur en cours...");
            color: Theme.texte-secondaire;
        }

        MessageRetour {
            retour: ServeurApi.retour;
        }
    }
}

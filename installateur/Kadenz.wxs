<!--
  Paquet MSI de Kadenz (cahier des charges, section 16), enveloppé par
  KadenzSetup.wxs dans l'installateur KadenzSetup-<version>.exe.

  Installation pour tout le poste, par défaut dans Program Files\Kadenz (dossier
  choisi dans l'assistant : propriété INSTALLFOLDER), raccourcis du menu Démarrer
  et du bureau au choix, désinstallation depuis les paramètres de Windows.
  La base de données vit dans %APPDATA%\Kadenz. L'installation et les mises à
  jour n'y touchent pas ; la désinstallation supprime tout ce dossier (base, clé
  kadenz.cle, journal des erreurs) pour le compte qui désinstalle (décision de
  l'utilisateur du 2026-11-12). Une mise à jour désinstalle l'ancienne version
  avec UPGRADINGPRODUCTCODE renseigné : la suppression est alors sautée.

  Variables passées par construire.ps1 : Version, Exe (chemin de kadenz.exe),
  Editeur, Icone.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Kadenz"
           Manufacturer="$(var.Editeur)"
           Version="$(var.Version)"
           UpgradeCode="ea90a773-12f9-43ab-9b4d-c708d91d5300"
           Language="1036"
           Codepage="1252"
           Scope="perMachine">
    <SummaryInformation Description="Kadenz, gestion commerciale" Manufacturer="$(var.Editeur)" />

    <!-- Une nouvelle version remplace l'ancienne ; un retour en arrière est refusé. -->
    <MajorUpgrade DowngradeErrorMessage="Une version plus récente de Kadenz est déjà installée." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="kadenz.ico" SourceFile="$(var.Icone)" />
    <Property Id="ARPPRODUCTICON" Value="kadenz.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- Dossier des données du compte qui désinstalle (voir l'en-tête). -->
    <SetProperty Id="DOSSIERDONNEES" Value="[AppDataFolder]Kadenz" Before="CostInitialize" Sequence="both" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Kadenz" />
    </StandardDirectory>

    <!-- Raccourcis choisis dans l'assistant (cases cochées par défaut) ; la
         ligne de commande peut les écarter : RACCOURCIBUREAU=0, RACCOURCIMENU=0. -->
    <Property Id="RACCOURCIBUREAU" Value="1" Secure="yes" />
    <Property Id="RACCOURCIMENU" Value="1" Secure="yes" />

    <Feature Id="Kadenz" Title="Kadenz">
      <Component Directory="INSTALLFOLDER">
        <File Id="kadenz.exe" Source="$(var.Exe)" Name="kadenz.exe" KeyPath="yes" />
        <!-- Données supprimées à la désinstallation, jamais pendant une mise à jour. -->
        <util:RemoveFolderEx On="uninstall" Property="DOSSIERDONNEES" Condition="NOT UPGRADINGPRODUCTCODE" />
      </Component>
      <!-- Raccourcis pour tous les comptes du poste ; une valeur de registre
           sert de chemin clé à chaque composant. -->
      <Component Id="RaccourciMenu" Directory="ProgramMenuFolder" Condition="RACCOURCIMENU = &quot;1&quot;">
        <Shortcut Id="RaccourciMenu"
                  Name="Kadenz"
                  Description="Gestion commerciale"
                  Target="[INSTALLFOLDER]kadenz.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="kadenz.ico" />
        <RegistryValue Root="HKMU" Key="Software\Kadenz" Name="RaccourciMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="RaccourciBureau" Directory="DesktopFolder" Condition="RACCOURCIBUREAU = &quot;1&quot;">
        <Shortcut Id="RaccourciBureau"
                  Name="Kadenz"
                  Description="Gestion commerciale"
                  Target="[INSTALLFOLDER]kadenz.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="kadenz.ico" />
        <RegistryValue Root="HKMU" Key="Software\Kadenz" Name="RaccourciBureau" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>

<!--
  Installateur KadenzSetup-<version>.exe (cahier des charges, section 16) :
  assistant WixStdBA au thème de Kadenz (theme\kadenz.thm, généré par
  theme\generer.py), qui installe le paquet Kadenz.msi.

  Pages : choix de la langue de l'assistant parmi les sept langues de Kadenz,
  puis dossier d'installation et raccourcis du bureau et du menu Démarrer,
  progression, et fin avec le bouton « Lancer Kadenz » (lancé avec les droits
  du compte, sans élévation). Aucune licence n'est affichée : le dépôt n'en
  définit pas. Variables passées par construire.ps1 : Version, Msi (chemin de
  Kadenz.msi), Editeur, Icone.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="Kadenz"
          Manufacturer="$(var.Editeur)"
          Version="$(var.Version)"
          UpgradeCode="39f20fc0-e088-4792-85bb-29b2cc47d5ef"
          IconSourceFile="$(var.Icone)">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="none"
                                              ThemeFile="$(sys.SOURCEFILEDIR)theme\kadenz.thm"
                                              LocalizationFile="$(sys.SOURCEFILEDIR)theme\kadenz.wxl"
                                              LogoFile="$(sys.SOURCEFILEDIR)theme\logo.png"
                                              LogoSideFile="$(sys.SOURCEFILEDIR)theme\logoside.png"
                                              LicenseUrl=""
                                              LaunchTarget="[InstallFolder]\kadenz.exe"
                                              LaunchWorkingFolder="[InstallFolder]" />
      <Payload SourceFile="$(var.Icone)" Name="kadenz.ico" />
    </BootstrapperApplication>

    <!-- Langue de l'assistant, retenue pour la réparation et la désinstallation. -->
    <Variable Name="KadenzLangue" Type="string" Value="fr" Persisted="yes" bal:Overridable="yes" />
    <Variable Name="InstallFolder" Type="formatted" Value="[ProgramFiles64Folder]Kadenz" Persisted="yes" bal:Overridable="yes" />
    <Variable Name="RaccourciBureau" Type="numeric" Value="1" bal:Overridable="yes" />
    <Variable Name="RaccourciMenu" Type="numeric" Value="1" bal:Overridable="yes" />

    <Chain>
      <MsiPackage SourceFile="$(var.Msi)">
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
        <MsiProperty Name="RACCOURCIBUREAU" Value="[RaccourciBureau]" />
        <MsiProperty Name="RACCOURCIMENU" Value="[RaccourciMenu]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
